# ============================================================
# RISK TAXONOMY DATA COVERAGE - POLICY LEVEL
# ============================================================

risk_taxonomy_coverage = (
    policy_taxonomy_df
    .groupby("country")
    .agg(
        distinct_policies=("policy_core_id", "nunique"),

        policies_with_L1=("resolved_L1", lambda x: x.notna().sum()),
        policies_with_L2=("resolved_L2", lambda x: x.notna().sum()),
        policies_with_L3=("resolved_L3", lambda x: x.notna().sum()),
    )
    .reset_index()
)

# Add coverage percentages
risk_taxonomy_coverage["L1_coverage_pct"] = (
    risk_taxonomy_coverage["policies_with_L1"]
    / risk_taxonomy_coverage["distinct_policies"] * 100
)

risk_taxonomy_coverage["L2_coverage_pct"] = (
    risk_taxonomy_coverage["policies_with_L2"]
    / risk_taxonomy_coverage["distinct_policies"] * 100
)

risk_taxonomy_coverage["L3_coverage_pct"] = (
    risk_taxonomy_coverage["policies_with_L3"]
    / risk_taxonomy_coverage["distinct_policies"] * 100
)

# Round percentages
risk_taxonomy_coverage[
    ["L1_coverage_pct", "L2_coverage_pct", "L3_coverage_pct"]
] = risk_taxonomy_coverage[
    ["L1_coverage_pct", "L2_coverage_pct", "L3_coverage_pct"]
].round(2)

# Sort by country
risk_taxonomy_coverage = risk_taxonomy_coverage.sort_values("country")

display(risk_taxonomy_coverage)
