def safe_json_loads(x):
    if x is None:
        return None
    if isinstance(x, dict):
        return x
    if isinstance(x, str):
        try:
            return json.loads(x)
        except Exception:
            return None
    return None


def get_nested(d, *keys):
    cur = d
    for k in keys:
        if not isinstance(cur, dict):
            return None
        cur = cur.get(k)
    return cur


def clean_val(v):
    """Return a stripped string, or None if not meaningfully populated."""
    if v is None:
        return None
    if isinstance(v, str):
        s = v.strip()
        return s if s else None
    return str(v)


def load_current_version(table_short_name):
    full_table = f"{DATA_PROJECT}.{DATASET}.{table_short_name}"
    query = f"SELECT policy_core_id, version_num, json_data FROM `{full_table}`"
    df = bq_client.query(query).to_dataframe()
    if len(df) == 0:
        return df
    latest = (df.sort_values("version_num")
              .groupby("policy_core_id", as_index=False)
              .tail(1).copy())
    latest["parsed"] = latest["json_data"].apply(safe_json_loads)
    return latest


# ============================================================
# Build the policy-grain frame
# ============================================================

print("=" * 80)
print("Building policy-grain risk taxonomy frame")
print("=" * 80)

rows = []

for country, table in COUNTRY_TABLES.items():
    try:
        df = load_current_version(table)
    except Exception as e:
        print(f"  {country:30s} FAILED -- {str(e)[:60]}")
        continue
    if len(df) == 0:
        print(f"  {country:30s} EMPTY")
        continue

    for _, row in df.iterrows():
        parsed = row["parsed"]
        if not isinstance(parsed, dict):
            continue
        pid = row["policy_core_id"]

        # ---- policy-grain sources ----
        risk_primary = clean_val(parsed.get("policyRiskTypePrimary"))
        risk_l2_policy = clean_val(get_nested(parsed, "policyApplication", "riskTxnmyL2Text"))

        multi = get_nested(parsed, "policyApplication", "multiRiskDetls")
        multi = multi if isinstance(multi, list) else []
        multi_risks = sorted({
            clean_val(m.get("risk")) for m in multi
            if isinstance(m, dict) and clean_val(m.get("risk"))
        })

        # ---- roll objRel taxonomy UP to the policy ----
        segments = get_nested(parsed, "policyApplication", "segment")
        segments = segments if isinstance(segments, list) else []

        objrel_total = 0
        objrel_with_l1 = 0
        objrel_with_l2 = 0
        objrel_with_l3 = 0
        l1_vals, l2_vals, l3_vals = set(), set(), set()
        objtypes = set()

        for seg in segments:
            if not isinstance(seg, dict):
                continue
            obj_rel = seg.get("objRel")
            if not isinstance(obj_rel, list):
                continue
            for obj in obj_rel:
                if not isinstance(obj, dict):
                    continue
                objrel_total += 1
                ot = clean_val(obj.get("plcyObjTypeCde"))
                if ot:
                    objtypes.add(ot)

                v1 = clean_val(obj.get("riskTxnmyL1Text"))
                v2 = clean_val(obj.get("riskTxnmyL2Text"))
                v3 = clean_val(obj.get("riskTxnmyL3Text"))
                if v1:
                    objrel_with_l1 += 1
                    l1_vals.add(v1)
                if v2:
                    objrel_with_l2 += 1
                    l2_vals.add(v2)
                if v3:
                    objrel_with_l3 += 1
                    l3_vals.add(v3)

        # ---- resolve a single taxonomy per level, with attribution ----
        # L1 preference: objRel L1  ->  policyRiskTypePrimary  ->  multiRiskDetls
        if l1_vals:
            resolved_l1, l1_source = sorted(l1_vals)[0], "objRel.riskTxnmyL1Text"
        elif risk_primary:
            resolved_l1, l1_source = risk_primary, "policyRiskTypePrimary"
        elif multi_risks:
            resolved_l1, l1_source = multi_risks[0], "multiRiskDetls.risk"
        else:
            resolved_l1, l1_source = None, None

        # L2 preference: objRel L2  ->  policyApplication.riskTxnmyL2Text
        if l2_vals:
            resolved_l2, l2_source = sorted(l2_vals)[0], "objRel.riskTxnmyL2Text"
        elif risk_l2_policy:
            resolved_l2, l2_source = risk_l2_policy, "policyApplication.riskTxnmyL2Text"
        else:
            resolved_l2, l2_source = None, None

        resolved_l3 = sorted(l3_vals)[0] if l3_vals else None
        l3_source = "objRel.riskTxnmyL3Text" if l3_vals else None

        rows.append({
            "country": country,
            "table": table,
            "policy_core_id": pid,
            "version_num": row["version_num"],
            "policyTitle": parsed.get("policyTitle"),

            # policy-grain sources
            "policyRiskTypePrimary": risk_primary,
            "riskTxnmyL2Text_policy": risk_l2_policy,
            "multiRiskDetls_risks": "; ".join(multi_risks) if multi_risks else None,
            "multiRiskDetls_n_distinct": len(multi_risks),

            # objRel rollup
            "n_segments": len(segments),
            "n_objrel_entries": objrel_total,
            "objrel_types": "; ".join(sorted(objtypes)) if objtypes else None,
            "objrel_with_L1": objrel_with_l1,
            "objrel_with_L2": objrel_with_l2,
            "objrel_with_L3": objrel_with_l3,
            "policy_has_L1": len(l1_vals) > 0,
            "policy_has_L2": len(l2_vals) > 0,
            "policy_has_L3": len(l3_vals) > 0,
            "policy_has_any_objrel_txnmy": bool(l1_vals or l2_vals or l3_vals),
            "L1_distinct_values": len(l1_vals),
            "L2_distinct_values": len(l2_vals),
            "L3_distinct_values": len(l3_vals),
            "L1_values": "; ".join(sorted(l1_vals)) if l1_vals else None,
            "L2_values": "; ".join(sorted(l2_vals)) if l2_vals else None,
            "L3_values": "; ".join(sorted(l3_vals)) if l3_vals else None,

            # resolved
            "resolved_L1": resolved_l1,
            "resolved_L1_source": l1_source,
            "resolved_L2": resolved_l2,
            "resolved_L2_source": l2_source,
            "resolved_L3": resolved_l3,
            "resolved_L3_source": l3_source,
            "has_any_risk_classification": bool(resolved_l1 or resolved_l2 or resolved_l3),
        })

    print(f"  {country:30s} {df['policy_core_id'].nunique()} policies")

