# ============================================================
# SECTION 2 -- Load each table, detect schema (incl. the segment
# text key), validate coverage across ALL records, dedup to latest
# version, compute attachment/text metrics on the COMBINED text,
# and stash JSON for the viewer
# ============================================================

print("\n\n" + "=" * 80)
print("SECTION 2 -- Loading, validating, and scoring each table")
print("=" * 80)

result_rows = []
viewer_lookup = {}  # viewer_lookup[country][procedure_core_id] = parsed json

for table in procedure_tables:
    code = table.split("_")[0]
    country = COUNTRY_CODE_NAMES.get(code, code)
    full_table = f"{DATA_PROJECT}.{DATASET}.{table}"

    print(f"\n{'-' * 80}\n{country}  ({table})\n{'-' * 80}")

    try:
        df = bq_client.query(f"SELECT * FROM `{full_table}`").to_dataframe()
    except Exception as e:
        print(f"  FAILED to load -- {str(e)[:120]}")
        continue

    if len(df) == 0:
        print("  EMPTY table")
        result_rows.append({
            "Country": country, "Total procedures": 0, "Procedures with attachment": 0,
            "Procedures with sufficient text in RCDP (>1000 chars)": 0,
            "have Attachment and text <500": 0, "have Attachment and text <1000": 0,
            "% All Procedures: Attachment and Text <500": 0,
            "% All Procedures: Attachment and Text <1000": 0,
        })
        continue

    id_col, version_col, json_col = detect_physical_columns(df)
    print(f"  Physical columns detected -- id: {id_col!r}, version: {version_col!r}, "
          f"json: {json_col!r}")
    if not all([id_col, version_col, json_col]):
        print("  >>> Could not confidently detect physical columns -- skipping this table.")
        continue

    print(f"  Total ROWS (all versions): {len(df):,}")
    print(f"  Distinct {id_col} values:   {df[id_col].nunique():,}")
    dupes = df.groupby([id_col, version_col]).size()
    n_dupes = (dupes > 1).sum()
    if n_dupes:
        print(f"  >>> WARNING: {n_dupes} (id, version) pairs appear more than once -- "
              f"dedup via tail(1) is not guaranteed unique here.")

    latest = df.sort_values(version_col).groupby(id_col, as_index=False).tail(1).copy()
    latest["parsed"] = latest[json_col].apply(safe_json_loads)
    total = latest[id_col].nunique()

    sample_parsed = next((p for p in latest["parsed"] if isinstance(p, dict)), None)
    if sample_parsed is None:
        print("  >>> No parseable JSON records -- skipping this table.")
        continue

    fields = detect_json_fields(sample_parsed)
    main_text_key = fields["main_text_key"]
    application_key = fields["application_key"]
    segment_text_key = detect_segment_text_key(sample_parsed, application_key)
    disp_key = detect_segment_disp_key(sample_parsed, application_key)

    print(f"  Detected -- main text field: {main_text_key!r}")
    print(f"              attachment/segment container: {application_key!r}")
    print(f"              segment body-text field: {segment_text_key!r}  "
          f"(this is the one the earlier script was missing)")
    if disp_key:
        print(f"              segment display/active flag seen: {disp_key!r} "
              f"(not filtered on below -- all segments counted)")

    # ---- validate field coverage across ALL records ----
    parse_ok = latest["parsed"].apply(lambda p: isinstance(p, dict)).sum()
    main_only_lens, combined_lens, n_segments_list = [], [], []
    has_main_text_key = has_segment_text = 0
    disp_value_counter = Counter()

    for p in latest["parsed"]:
        if not isinstance(p, dict):
            continue
        if main_text_key and main_text_key in p:
            has_main_text_key += 1
        segs = (p.get(application_key) or {}).get("segment") if application_key else None
        if isinstance(segs, list) and segment_text_key:
            if any(isinstance(s, dict) and s.get(segment_text_key) for s in segs):
                has_segment_text += 1
            if disp_key:
                for s in segs:
                    if isinstance(s, dict):
                        disp_value_counter[s.get(disp_key)] += 1

        _, main_len, combined_len, n_segs = get_combined_text(
            p, main_text_key, application_key, segment_text_key
        )
        main_only_lens.append(main_len)
        combined_lens.append(combined_len)
        n_segments_list.append(n_segs)

    print(f"  JSON parse success: {parse_ok}/{total} ({parse_ok / total * 100:.1f}%)")
    if main_text_key:
        print(f"  Records with {main_text_key!r} present: "
              f"{has_main_text_key}/{parse_ok} ({has_main_text_key / parse_ok * 100:.1f}%)")
    if segment_text_key:
        print(f"  Records with >=1 non-empty segment text: "
              f"{has_segment_text}/{parse_ok} ({has_segment_text / parse_ok * 100:.1f}%)")
    if disp_value_counter:
        print(f"  Segment {disp_key!r} value distribution: {dict(disp_value_counter)}")

    if main_only_lens and combined_lens:
        print(f"\n  Text length, OLD method (procedureText only):")
        print(f"    median={statistics.median(main_only_lens):.0f}, "
              f"mean={statistics.mean(main_only_lens):.0f}")
        print(f"  Text length, FIXED method (procedureText + all segment text):")
        print(f"    median={statistics.median(combined_lens):.0f}, "
              f"mean={statistics.mean(combined_lens):.0f}")
        old_sufficient = sum(1 for L in main_only_lens if L > SUFFICIENT_TEXT_LEN)
        new_sufficient = sum(1 for L in combined_lens if L > SUFFICIENT_TEXT_LEN)
        print(f"  'Sufficient text' (>1000 chars) count -- OLD: {old_sufficient}, "
              f"FIXED: {new_sufficient}")

    # ---- score each record on the COMBINED text + build viewer lookup ----
    with_attachment = 0
    sufficient_text = 0
    attach_and_lt500 = 0
    attach_and_lt1000 = 0
    viewer_lookup[country] = {}

    for _, row in latest.iterrows():
        parsed = row["parsed"]
        pid = row[id_col]
        if not isinstance(parsed, dict):
            viewer_lookup[country][pid] = {"_parse_error": True, "_raw": str(row[json_col])[:2000]}
            continue

        viewer_lookup[country][pid] = parsed

        _, _, text_len, _ = get_combined_text(
            parsed, main_text_key, application_key, segment_text_key
        )
        if text_len > SUFFICIENT_TEXT_LEN:
            sufficient_text += 1

        if has_active_attachment(parsed, application_key):
            with_attachment += 1
            if text_len < THIN_500:
                attach_and_lt500 += 1
            if text_len < THIN_1000:
                attach_and_lt1000 += 1

    result_rows.append({
        "Country": country,
        "Total procedures": total,
        "Procedures with attachment": with_attachment,
        "Procedures with sufficient text in RCDP (>1000 chars)": sufficient_text,
        "have Attachment and text <500": attach_and_lt500,
        "have Attachment and text <1000": attach_and_lt1000,
        "% All Procedures: Attachment and Text <500": round(
            attach_and_lt500 / total * 100, 2) if total else 0,
        "% All Procedures: Attachment and Text <1000": round(
            attach_and_lt1000 / total * 100, 2) if total else 0,
    })
    print(f"\n  --> {total} procedures scored")


result_df = pd.DataFrame(result_rows)

print("\n\n" + "=" * 80)
print("Result -- same column layout as your 'Attachments analysis' sheet, now scored "
