import ipywidgets as widgets
from IPython.display import display as ipy_display, JSON, clear_output

_countries_sorted = sorted(viewer_lookup.keys())

country_dd = widgets.Dropdown(options=_countries_sorted, description="Country:",
                               style={"description_width": "initial"},
                               layout=widgets.Layout(width="400px"))
procedure_dd = widgets.Dropdown(options=[], description="Procedure ID:",
                                 style={"description_width": "initial"},
                                 layout=widgets.Layout(width="400px"))
info_label = widgets.Label()
viewer_output = widgets.Output()


def _procedure_options_for(country):
    return sorted(viewer_lookup.get(country, {}).keys())


def _on_country_change(change):
    pids = _procedure_options_for(country_dd.value)
    procedure_dd.options = pids
    if pids:
        procedure_dd.value = pids[0]
    else:
        with viewer_output:
            clear_output()
            print("No procedures loaded for this table.")


def _on_procedure_change(change):
    with viewer_output:
        clear_output()
        country = country_dd.value
        pid = procedure_dd.value
        if country is None or pid is None:
            return
        data = viewer_lookup[country][pid]
        n_here = len(viewer_lookup[country])
        info_label.value = f"{country} -- procedure_core_id {pid} (of {n_here} in this table)"
        ipy_display(JSON(data, expanded=False))


country_dd.observe(_on_country_change, names="value")
procedure_dd.observe(_on_procedure_change, names="value")

if _countries_sorted:
    country_dd.value = _countries_sorted[0]  # triggers the cascade

ipy_display(widgets.VBox([
    widgets.HBox([country_dd, procedure_dd]),
    info_label,
    viewer_output,
]))

print(
    "\nUse the dropdowns above: selecting a table repopulates the procedure_core_id\n"
    "list, and selecting a procedure renders its full parsed JSON as a collapsible\n"
    "tree (click to expand/collapse nodes)."
