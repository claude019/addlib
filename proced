def safe_json_loads(x):
    if x is None:
        return None
    if isinstance(x, dict):
        return x
    if isinstance(x, str):
        try:
            return json.loads(x)
        except Exception:
            return None
    return None


def strip_html(text):
    if not isinstance(text, str) or not text.strip():
        return ""
    try:
        return BeautifulSoup(text, "html.parser").get_text(separator=" ", strip=True)
    except Exception:
        return re.sub(r"<[^>]+>", " ", text)


def detect_physical_columns(df):
    """Find the id / version / json columns by pattern, not by
    assuming they're named exactly like the policy tables."""
    cols = list(df.columns)
    id_col = next((c for c in cols if re.search(r"(?i)core.?id$", c)), None) \
        or next((c for c in cols if re.search(r"(?i)_id$", c)), None)
    version_col = next((c for c in cols if "version" in c.lower()), None)
    json_col = next((c for c in cols if "json" in c.lower()), None)
    return id_col, version_col, json_col


def detect_json_fields(parsed):
    """Find the main text field, the attachment-bearing container,
    and the title field by STRUCTURE (does it contain sgmntText? does
    it contain appendix/guidance?) rather than by assumed name, since
    procedures may not reuse policy* field names."""
    text_candidates = []
    application_key = None
    for k, v in parsed.items():
        if isinstance(v, dict) and "sgmntText" in v:
            text_candidates.append(k)
        if isinstance(v, dict) and ("appendix" in v or "guidance" in v):
            application_key = k

    main_text_key = next((k for k in text_candidates if "purpose" not in k.lower()), None)
    if main_text_key is None and text_candidates:
        main_text_key = text_candidates[0]

    title_key = next(
        (k for k, v in parsed.items() if isinstance(v, str) and "titl" in k.lower()),
        None,
    )

    return {
        "main_text_key": main_text_key,
        "text_candidates": text_candidates,
        "application_key": application_key,
        "title_key": title_key,
    }


# ============================================================
# SECTION 1 -- Discover procedure tables and their schema
# ============================================================

print("=" * 80)
print("SECTION 1 -- Discovering procedure tables")
print("=" * 80)

discovery_query = f"""
    SELECT table_name
    FROM `{DATA_PROJECT}.{DATASET}.INFORMATION_SCHEMA.TABLES`
    WHERE REGEXP_CONTAINS(table_name, r'^[a-z]{{2}}_hsbc_gpps_gpps_procedure$')
    ORDER BY table_name
"""
try:
    procedure_tables = bq_client.query(discovery_query).to_dataframe()["table_name"].tolist()
except Exception as e:
    print(f"INFORMATION_SCHEMA not readable ({str(e)[:80]}); falling back to the single "
          f"table you named.")
    procedure_tables = ["aa_hsbc_gpps_gpps_procedure"]

if not procedure_tables:
    procedure_tables = ["aa_hsbc_gpps_gpps_procedure"]

print(f"\nFound {len(procedure_tables)} procedure table(s):")
for t in procedure_tables:
    code = t.split("_")[0]
    print(f"  {t}  ({COUNTRY_CODE_NAMES.get(code, code)})")

# ---- Inspect physical + JSON schema using the first table found ----
probe_table = procedure_tables[0]
print(f"\nInspecting schema via: {probe_table}")
print("-" * 80)

probe_df = bq_client.query(
    f"SELECT * FROM `{DATA_PROJECT}.{DATASET}.{probe_table}` LIMIT 5"
).to_dataframe()

print(f"\nPhysical columns: {list(probe_df.columns)}")
display(probe_df.head(3))

id_col, version_col, json_col = detect_physical_columns(probe_df)
print(f"\nDetected -- id column: {id_col!r}, version column: {version_col!r}, "
      f"json column: {json_col!r}")
if not all([id_col, version_col, json_col]):
    print(">>> Could not confidently detect one or more physical columns -- "
          "check the column list above and set PHYSICAL_COLS manually in Section 2.")

if json_col:
    sample_parsed = None
    for raw in probe_df[json_col]:
        sample_parsed = safe_json_loads(raw)
        if isinstance(sample_parsed, dict):
            break
    if isinstance(sample_parsed, dict):
        print(f"\nTop-level JSON keys: {sorted(sample_parsed.keys())}")
        fields = detect_json_fields(sample_parsed)
        print(f"\nDetected -- main text field: {fields['main_text_key']!r}")
        print(f"            all text-bearing fields seen: {fields['text_candidates']}")
        print(f"            attachment container field: {fields['application_key']!r}")
        print(f"            title field: {fields['title_key']!r}")
        if fields["main_text_key"]:
            sample_text = strip_html(sample_parsed.get(fields["main_text_key"], {}).get("sgmntText"))
            print(f"\nSample of detected main text ({len(sample_text)} chars): "
                  f"{sample_text[:200]!r}")
    else:
        print("\nCould not parse a sample JSON record -- check json_col detection above.")

print("\n" + "=" * 80)
print("Review the detection above, then run SECTION 2 below.")
print("If any field was NOT detected (None), set it manually in the")
print("MANUAL_OVERRIDE dict near the top of Section 2.")
print("=" * 80)


# ============================================================
# SECTION 2 -- Per-country attachment / text-quality analysis
# (run only after reviewing Section 1's output above)
# ============================================================

# Fill in only if Section 1 failed to detect something automatically.
# Leave as None to use what Section 1 detected.
MANUAL_OVERRIDE = {
    "id_col": None,
    "version_col": None,
    "json_col": None,
    "main_text_key": None,
    "application_key": None,
    "title_key": None,
}

id_col = MANUAL_OVERRIDE["id_col"] or id_col
version_col = MANUAL_OVERRIDE["version_col"] or version_col
json_col = MANUAL_OVERRIDE["json_col"] or json_col
global_main_text_key = MANUAL_OVERRIDE["main_text_key"] or (fields["main_text_key"] if isinstance(sample_parsed, dict) else None)
global_application_key = MANUAL_OVERRIDE["application_key"] or (fields["application_key"] if isinstance(sample_parsed, dict) else None)
global_title_key = MANUAL_OVERRIDE["title_key"] or (fields["title_key"] if isinstance(sample_parsed, dict) else None)

assert id_col and version_col and json_col, (
    "Physical columns not resolved -- set them in MANUAL_OVERRIDE before continuing."
)

print("\n" + "=" * 80)
print("SECTION 2 -- Running the analysis")
print(f"Using: id_col={id_col!r}, version_col={version_col!r}, json_col={json_col!r}")
print(f"       main_text_key={global_main_text_key!r}, "
      f"application_key={global_application_key!r}")
print("=" * 80)

rows = []

for table in procedure_tables:
    code = table.split("_")[0]
    country = COUNTRY_CODE_NAMES.get(code, code)

    try:
        df = bq_client.query(
            f"SELECT `{id_col}`, `{version_col}`, `{json_col}` "
            f"FROM `{DATA_PROJECT}.{DATASET}.{table}`"
        ).to_dataframe()
    except Exception as e:
        print(f"  {country:30s} FAILED -- {str(e)[:80]}")
        continue

    if len(df) == 0:
        print(f"  {country:30s} EMPTY")
        rows.append({
            "Country": country, "Total procedures": 0, "Procedures with attachment": 0,
            "Procedures with sufficient text in RCDP (>1000 chars)": 0,
            "have Attachment and text <500": 0, "have Attachment and text <1000": 0,
            "% All Procedures: Attachment and Text <500": 0,
            "% All Procedures: Attachment and Text <1000": 0,
        })
        continue

    latest = (df.sort_values(version_col)
              .groupby(id_col, as_index=False)
              .tail(1))

    total = latest[id_col].nunique()
    with_attachment = 0
    sufficient_text = 0
    attach_and_lt500 = 0
    attach_and_lt1000 = 0

    for _, row in latest.iterrows():
        parsed = safe_json_loads(row[json_col])
        if not isinstance(parsed, dict):
            continue

        main_text = ""
        if global_main_text_key:
            main_text = strip_html(
                (parsed.get(global_main_text_key) or {}).get("sgmntText")
            )
        text_len = len(main_text)
        if text_len > SUFFICIENT_TEXT_LEN:
            sufficient_text += 1

        has_active_attachment = False
        if global_application_key:
            app = parsed.get(global_application_key) or {}
            for src in ("appendix", "guidance"):
                items = app.get(src)
                if isinstance(items, list):
                    for it in items:
                        if isinstance(it, dict) and it.get("actvFlg") == "Y":
                            has_active_attachment = True
                            break
                if has_active_attachment:
                    break

        if has_active_attachment:
            with_attachment += 1
            if text_len < THIN_500:
                attach_and_lt500 += 1
            if text_len < THIN_1000:
                attach_and_lt1000 += 1

    rows.append({
        "Country": country,
        "Total procedures": total,
        "Procedures with attachment": with_attachment,
        "Procedures with sufficient text in RCDP (>1000 chars)": sufficient_text,
        "have Attachment and text <500": attach_and_lt500,
        "have Attachment and text <1000": attach_and_lt1000,
        "% All Procedures: Attachment and Text <500": round(
            attach_and_lt500 / total * 100, 2) if total else 0,
        "% All Procedures: Attachment and Text <1000": round(
            attach_and_lt1000 / total * 100, 2) if total else 0,
    })
    print(f"  {country:30s} {total} procedures")

result_df = pd.DataFrame(rows)

print("\n" + "=" * 80)
print("Result -- same column layout as your 'Attachments analysis' sheet")
