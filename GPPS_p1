def safe_json_loads(x):
    if x is None:
        return None
    if isinstance(x, dict):
        return x
    if isinstance(x, str):
        try:
            return json.loads(x)
        except Exception:
            return None
    return None


def get_nested(d, *keys):
    cur = d
    for k in keys:
        if not isinstance(cur, dict):
            return None
        cur = cur.get(k)
    return cur


def strip_html(text):
    if not isinstance(text, str) or not text.strip():
        return ""
    try:
        return BeautifulSoup(text, "html.parser").get_text(separator=" ", strip=True)
    except Exception:
        return re.sub(r"<[^>]+>", " ", text)


def _have(mod):
    try:
        importlib.import_module(mod)
        return True
    except Exception:
        return False


def link_pattern(url):
    """Collapse ids so links of the same shape group together."""
    if not isinstance(url, str) or not url.strip():
        return None
    p = urlparse(url)
    return f"{p.scheme}://{p.netloc}{re.sub(r'\d+', '<n>', p.path)}"


def policy_text_chars(parsed):
    t = strip_html(get_nested(parsed, "policyText", "sgmntText"))
    p = strip_html(get_nested(parsed, "policyPurpose", "sgmntText"))
    segs = get_nested(parsed, "policyApplication", "segment")
    s = 0
    if isinstance(segs, list):
        s = sum(len(strip_html(x.get("sgmntText"))) for x in segs if isinstance(x, dict))
    return len(t) + len(p) + s


def extract_attachments(parsed):
    rows = []
    for source in ("appendix", "guidance"):
        items = get_nested(parsed, "policyApplication", source)
        if not isinstance(items, list):
            continue
        for it in items:
            if not isinstance(it, dict):
                continue
            gcs = next((v for v in it.values()
                        if isinstance(v, str) and v.startswith("gs://")), None)
            rows.append({
                "source": source,
                "actvFlg": it.get("actvFlg"),
                "docId": it.get("docId"),
                "oldDocId": it.get("oldDocId"),
                "docName": it.get("docName"),
                "gppsDocName": it.get("gppsDocName"),
                "docRefNum": it.get("docRefNum"),
                "docTitlText": it.get("docTitlText"),
                "docDesc": it.get("docDesc"),
                "docUrl": it.get("docUrl"),
                "docGmsUrl": it.get("docGmsUrl"),
                "gcs_uri": gcs,
            })
    return rows


def scan_for_gcs(node, path, hits):
    if isinstance(node, dict):
        for k, v in node.items():
            scan_for_gcs(v, f"{path}.{k}" if path else k, hits)
    elif isinstance(node, list):
        for item in node:
            scan_for_gcs(item, f"{path}[]", hits)
    elif isinstance(node, str):
        for m in GCS_PATTERN.findall(node):
            hits.append((path, m))


