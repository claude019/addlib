discovery_query = f"""
    SELECT table_name
    FROM `{DATA_PROJECT}.{DATASET}.INFORMATION_SCHEMA.TABLES`
    WHERE REGEXP_CONTAINS(table_name, r'^[a-z]{{2}}_hsbc_gpps_gpps_policy$')
    ORDER BY table_name
"""
try:
    tables = bq_client.query(discovery_query).to_dataframe()["table_name"].tolist()
except Exception as e:
    print(f"INFORMATION_SCHEMA not readable ({str(e)[:70]}) -- using the known code list.")
    tables = [f"{c}_hsbc_gpps_gpps_policy" for c in sorted(COUNTRY_CODE_NAMES)]

policy_rows, attach_rows, gcs_path_hits = [], [], []

for table in tables:
    code = table.split("_")[0]
    country = COUNTRY_CODE_NAMES.get(code, code)
    try:
        df = bq_client.query(
            f"SELECT policy_core_id, version_num, json_data "
            f"FROM `{DATA_PROJECT}.{DATASET}.{table}`"
        ).to_dataframe()
    except Exception as e:
        print(f"  {country:30s} not readable -- {str(e)[:60]}")
        continue
    if len(df) == 0:
        continue

    latest = (df.sort_values("version_num")
              .groupby("policy_core_id", as_index=False).tail(1))

    for _, row in latest.iterrows():
        parsed = safe_json_loads(row["json_data"])
        if not isinstance(parsed, dict):
            continue
        pid = row["policy_core_id"]

        atts = extract_attachments(parsed)
        n_active = sum(1 for a in atts if a["actvFlg"] == "Y")
        text_chars = policy_text_chars(parsed)

        policy_rows.append({
            "country": country, "table": table, "policy_core_id": pid,
            "policyTitle": parsed.get("policyTitle"),
            "text_chars": text_chars,
            "n_attachments": len(atts),
            "n_active_attachments": n_active,
        })
        for a in atts:
            attach_rows.append({"country": country, "policy_core_id": pid,
                                "policyTitle": parsed.get("policyTitle"),
                                "policy_text_chars": text_chars, **a})

        hits = []
        scan_for_gcs(parsed, "", hits)
        for p, m in hits:
            gcs_path_hits.append({"country": country, "policy_core_id": pid,
                                  "field_path": p, "value": m})

    print(f"  {country:30s} {latest['policy_core_id'].nunique()} policies scanned")

policy_df = pd.DataFrame(policy_rows)
attach_df = pd.DataFrame(attach_rows)

policy_df["is_thin"] = policy_df["text_chars"] < THIN_TEXT_THRESHOLD
policy_df["has_active_attachment"] = policy_df["n_active_attachments"] > 0
policy_df["thin_with_attachment"] = policy_df["is_thin"] & policy_df["has_active_attachment"]
policy_df["thin_no_attachment"] = policy_df["is_thin"] & ~policy_df["has_active_attachment"]

