# ============================================================
# Test the docUrl directly -- a different access path from the
# GCS bucket, governed by this internal API's own auth, not
# bucket-level GCP IAM.
#
# The endpoint name "urlSignedMapper" suggests it returns a signed
# URL to the file rather than the file itself, so this handles
# three possible shapes of response: a direct PDF, a JSON body
# containing a signed URL to follow, or a redirect to one.
# ============================================================

import json
import shutil
import subprocess
from urllib.parse import urlparse
import requests

DOC_URL = ("https://gpps.gppspl-prod-cluster.hsbc-12435831-gppspldm-prod"
           ".prod.gcp.cloud.uk.hsbc/api/urlSignedMapper/13301")


def is_pdf(data):
    return isinstance(data, (bytes, bytearray)) and data.lstrip()[:5] == b"%PDF-"


def get_adc_token():
    try:
        import google.auth
        import google.auth.transport.requests
        creds, _ = google.auth.default(
            scopes=["https://www.googleapis.com/auth/cloud-platform"])
        creds.refresh(google.auth.transport.requests.Request())
        return creds.token
    except Exception:
        return None


def get_identity_token():
    if not shutil.which("gcloud"):
        return None
    try:
        out = subprocess.run(["gcloud", "auth", "print-identity-token"],
                             capture_output=True, text=True, timeout=30)
        return out.stdout.strip() if out.returncode == 0 and out.stdout.strip() else None
    except Exception:
        return None


print("=" * 70)
print(f"Testing: {DOC_URL}")
print("=" * 70)

variants = [("no_auth", {})]
adc_token = get_adc_token()
if adc_token:
    variants.append(("adc_access_token", {"Authorization": f"Bearer {adc_token}"}))
identity_token = get_identity_token()
if identity_token:
    variants.append(("identity_token", {"Authorization": f"Bearer {identity_token}"}))

print(f"\nAuth variants to try: {[v[0] for v in variants]}")

for label, headers in variants:
    print(f"\n--- Trying as: {label} ---")
    try:
        r = requests.get(DOC_URL, headers=headers, timeout=30, allow_redirects=False)
    except requests.exceptions.SSLError as e:
        print(f"SSL error -- {str(e)[:150]}")
        continue
    except Exception as e:
        print(f"{type(e).__name__}: {str(e)[:150]}")
        continue

    ctype = r.headers.get("Content-Type", "").lower()
    print(f"HTTP {r.status_code}, Content-Type: {ctype or '(none)'}")

    if r.status_code == 200 and "pdf" in ctype:
        print(f"-> PDF returned directly, {len(r.content) / 1024:.0f} KB")
        with open("test_attachment.pdf", "wb") as f:
            f.write(r.content)
        print("Saved to test_attachment.pdf")
        break

    elif r.status_code == 200 and "json" in ctype:
        print("-> JSON returned (expected -- 'urlSignedMapper' likely maps the docId "
              "to a signed URL rather than returning the file itself)")
        try:
            payload = r.json()
            print("Response body:")
            print(json.dumps(payload, indent=2)[:1000])
            signed = None
            for v in (payload.values() if isinstance(payload, dict) else []):
                if isinstance(v, str) and v.startswith("http"):
                    signed = v
                    break
            if signed:
                print(f"\n-> Found a URL in the response, fetching it (no auth headers -- "
                      f"signed URLs carry their own token in the query string):")
                r2 = requests.get(signed, timeout=60)
                print(f"   HTTP {r2.status_code}, Content-Type: {r2.headers.get('Content-Type')}")
                if is_pdf(r2.content):
                    with open("test_attachment.pdf", "wb") as f:
                        f.write(r2.content)
                    print(f"   -> PDF! {len(r2.content) / 1024:.0f} KB, saved to "
                          f"test_attachment.pdf")
                    break
        except Exception as e:
            print(f"Could not parse as JSON ({e}):")
            print(r.text[:500])

    elif r.status_code in (301, 302, 303, 307, 308):
        loc = r.headers.get("Location", "")
        print(f"-> Redirects to: {loc[:150]}")
        if loc.startswith("https://") and ".hsbc" not in (urlparse(loc).hostname or ""):
            print("   (external host, likely a signed URL -- fetching without auth headers)")
            try:
                r2 = requests.get(loc, timeout=60)
                print(f"   HTTP {r2.status_code}, Content-Type: {r2.headers.get('Content-Type')}")
                if is_pdf(r2.content):
                    with open("test_attachment.pdf", "wb") as f:
                        f.write(r2.content)
                    print(f"   -> PDF! {len(r2.content) / 1024:.0f} KB, saved to "
                          f"test_attachment.pdf")
                    break
            except Exception as e:
                print(f"   follow-up fetch failed: {str(e)[:150]}")
        else:
            print("   (internal .hsbc host -- likely an SSO/login redirect)")

    elif "html" in ctype:
        print("-> HTML returned -- likely an SSO/login page, meaning this endpoint wants "
              "an interactive browser session rather than a bearer token")

    else:
        preview = r.text[:300] if hasattr(r, "text") else "(binary, not shown)"
        print(f"-> Unhandled response. Body preview: {preview}")

print("\n" + "=" * 70)
print("Reading the result")
print("=" * 70)
print("""
PDF saved          -> this path works. The policy's docUrl can be used
                      directly, no GCS bucket access needed at all.
JSON with a URL,
but the follow-up
fetch failed        -> the mapping works but the signed URL itself needs
                      different handling -- share the JSON body printed
                      above and we can adjust.
HTML / login page   -> this endpoint requires interactive SSO, not a
                      bearer token -- not usable from a script as-is.
401 / 403 on every
variant              -> same kind of access gap as the bucket, just on a
                      different system -- another thing to flag to your
                      lead, not fix from here.
""")
