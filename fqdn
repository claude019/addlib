from google.cloud import bigquery
import pandas as pd

client = bigquery.Client(project="hsbc-12211200-cmlpwb-prod")

geo_keys = (4023, 18046, 3875, 4017)

# 1) Predictions
pred_query = f"""
SELECT alert_id, geo_hier_key, lob, lob_recommended, ai_recommended_le, process_date_time
FROM `cmlp_exp_003_1_prod.Random_LOB_LE`
WHERE geo_hier_key IN {geo_keys}
ORDER BY alert_id, process_date_time DESC
"""
pred_df = client.query(pred_query).to_dataframe()

latest_ts = pred_df.groupby("alert_id")["process_date_time"].transform("max")
pred_df = pred_df[pred_df["process_date_time"] == latest_ts]

recommended = pred_df[pred_df["lob_recommended"] == "AI Recommended"].copy()

# 2) Entity mapper — Active rows only, same filter as the mapping_file_gen notebook
mapper_query = """
SELECT *
FROM `hsbc-11545401-cmpdatcwrs1-prod.rc_curated_prod.aa_hsbc_helios_entity_mapper`
WHERE entity_mapper_status = "Active"
"""
mapper_df = client.query(mapper_query).to_dataframe()

# business_entity_key -> display name (prefer l3, fall back to l2 — same fillna pattern used earlier)
lob_names = mapper_df[["business_entity_key", "business_entity_l2", "business_entity_l3"]].drop_duplicates()
lob_names["lob_name"] = lob_names["business_entity_l3"].fillna(lob_names["business_entity_l2"])
lob_key_to_name = dict(zip(lob_names["business_entity_key"].astype(str), lob_names["lob_name"]))

# legal_entity_key -> display name
le_names = mapper_df[["legal_entity_key", "legal_entity_l2", "legal_entity_l3"]].drop_duplicates()
le_names["le_name"] = le_names["legal_entity_l3"].fillna(le_names["legal_entity_l2"])
le_key_to_name = dict(zip(le_names["legal_entity_key"].astype(str), le_names["le_name"]))

# 3) Translate keys to names, then join into one comma-separated string per alert
def join_unique_names(series, key_map):
    seen = []
    for v in series:
        name = key_map.get(str(v), str(v))  # falls back to raw key if unmapped
        if name not in seen:
            seen.append(name)
    return ",".join(seen)

def flatten_le_names(lists, key_map):
    seen = []
    for lst in lists:
        for v in (lst or []):
            name = key_map.get(str(v), str(v))
            if name not in seen:
                seen.append(name)
    return ",".join(seen)

rec_lob = recommended.groupby("alert_id")["lob"].apply(lambda s: join_unique_names(s, lob_key_to_name)).rename("Recommended_LOB")
rec_le  = recommended.groupby("alert_id")["ai_recommended_le"].apply(lambda s: flatten_le_names(s, le_key_to_name)).rename("Recommended_LE")
rec_summary = pd.concat([rec_lob, rec_le], axis=1).reset_index()

# 4) Raw alert text
raw_query = f"""
SELECT alert_id, transfer_date, location AS Location, title, summ_contnt, summ_updt, geo_hier_key
FROM `hsbc-11545401-cmpdatcwrs1-prod.rc_curated_prod.aa_hsbc_rapid2_hzn_alert_conformed`
WHERE geo_hier_key IN {geo_keys}
"""
raw_df = client.query(raw_query).to_dataframe()

# 5) Join and save
output = raw_df.merge(rec_summary, on="alert_id", how="left")
output = output.rename(columns={"alert_id": "record_id"})
output = output[["record_id", "Location", "title", "summ_contnt", "summ_updt",
                  "Recommended_LOB", "Recommended_LE"]]

output.to_csv("/home/jovyan/mexico_sample_output.csv", index=False)
output
