    print(f"  golden pairs in scope            : {len(gp):,}")
    print(f"  ADDRESSABLE (risk text exists)   : {addressable:,}   <- recall denominator")
    print(f"  DATA GAP    (no Helios text)     : {len(gp) - addressable:,}")
    print(f"  ==> ceiling on recall            : {addressable/max(len(gp),1):.1%}")
    print()
