    dir_keys = set(_norm_id(verdicts.RECORD_ID) + "|" + _norm_id(verdicts.LIB_RISK))
    print(f"  Pairs judged here but not by the RSM route            : "
          f"{len(dir_keys - rsm_keys):,}")

    cmp_df.to_csv(OUTPUT_DIR / "direct_vs_rsm_comparison.csv", index=False)
    print(f"\n  saved -> {OUTPUT_DIR / 'direct_vs_rsm_comparison.csv'}")
    return cmp_df


