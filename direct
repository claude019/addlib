def compare_to_rsm_lane(rsm_verdicts_df=None):
    rsm = rsm_verdicts_df if rsm_verdicts_df is not None else rsm_verdicts
    if rsm is None:
        p = find_rsm_verdicts()
        if p is None:
            print("[F0] RSM-lane verdicts not found -- skipping head-to-head.")
            return None
        rsm = _read_any(p)

    print("\n--- DIRECT lane ---")
    perf_direct = risk_scorecard(golden, verdicts, reachable_risks)
    c_direct = dict(SCORECARD_COUNTS)
    print("\n--- RSM route ---")
    perf_rsm = risk_scorecard(golden, rsm, reachable_risks)
    c_rsm = dict(SCORECARD_COUNTS)

    # risk_scorecard writes the module-level SCORECARD_COUNTS, so scoring the RSM
    # frame just clobbered THIS lane's counts -- and [F1] honest_recall reads that
    # global. Put the direct lane's counts back before anything downstream runs.
    globals()["SCORECARD_COUNTS"] = dict(c_direct)

    def _recall(c):
        return c["validated"] / max(c["addressable"], 1)

    rows = []
    for k, label in [("validated", "Validated (caught)"),
                     ("judged_not_linked", "Judged not linked"),
                     ("insufficient", "Judged insufficient"),
                     ("not_judged", "Never judged"),
                     ("addressable", "Addressable denominator")]:
        rows.append({"metric": label, "RSM route": c_rsm.get(k, 0),
                     "Direct": c_direct.get(k, 0),
                     "delta": c_direct.get(k, 0) - c_rsm.get(k, 0)})
    rows.append({"metric": "Addressable recall",
                 "RSM route": f"{_recall(c_rsm):.1%}",
                 "Direct":    f"{_recall(c_direct):.1%}",
                 "delta":     f"{(_recall(c_direct)-_recall(c_rsm))*100:+.1f} pts"})
    cmp_df = pd.DataFrame(rows)

    bar = "=" * 74
    print("\n" + bar); print("[F0] HEAD-TO-HEAD -- same golden, same denominator"); print(bar)
    print(cmp_df.to_string(index=False))

    # Which golden links could the RSM route never have reached at all?
