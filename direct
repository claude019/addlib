def find_rsm_verdicts(directory=None):
    """Locate the RSM lane's verdicts parquet. Prefers the file matching the
    CURRENT model; otherwise the most recently modified one."""
    directory = Path(directory or RSM_OUTPUT_DIR)
    if not directory.exists():
        return None
    hits = sorted(directory.glob("risk_verdicts_*.parquet"))
    if not hits:
        return None
    exact = [p for p in hits if p.name == f"risk_verdicts_{MODEL}.parquet"]
    if exact:
        return exact[0]
    newest = max(hits, key=lambda p: p.stat().st_mtime)
    print(f"  [A1] no file for model '{MODEL}'; using most recent: {newest.name}")
    return newest


def recover_scope(rsm_verdicts_path=None, save=True):
    """Return (scope_records, rsm_verdicts_df_or_None) and write the scope to csv."""
    bar = "=" * 78
    print(bar); print("[A1] SCOPE RECOVERY"); print(bar)

    path = rsm_verdicts_path or find_rsm_verdicts()
    rsm_v = None

    if path is not None:
        rsm_v = _read_any(path)
        rsm_v["RECORD_ID"] = _norm_id(rsm_v["RECORD_ID"])
        rsm_v["LIB_RISK"]  = _norm_id(rsm_v["LIB_RISK"])
        scope = set(rsm_v["RECORD_ID"])
        src = str(path)
        print(f"  source                      : {path.name}")
        print(f"  verdict rows (pairs judged) : {len(rsm_v):,}")
        print(f"  distinct records  -> SCOPE  : {len(scope):,}")
        print(f"  distinct library risks      : {rsm_v['LIB_RISK'].nunique():,}")
        print(f"  LINKED verdicts             : "
              f"{int((rsm_v.decision.astype(str).str.upper()=='LINKED').sum()):,}")
        print("  (expect ~160 records / ~2,409 pairs / ~116 risks for iteration 1-2)")
    elif SCOPE_CSV.exists():
        scope = set(_norm_id(pd.read_csv(SCOPE_CSV)["RECORD_ID"]))
        src = str(SCOPE_CSV)
        print(f"  RSM verdicts not found; reusing this lane's saved scope: {SCOPE_CSV.name}")
        print(f"  records                     : {len(scope):,}")
    elif "results_with_truth" in globals():
        _rwt = globals()["results_with_truth"]
        scope = set(_norm_id(
            _rwt.loc[_rwt["final_decision"].astype(str).str.upper() == "LINKED", "RECORD_ID"]))
        src = "results_with_truth (LINKED) -- kernel fallback"
        print(f"  RSM verdicts not found; falling back to rwt LINKED records: {len(scope):,}")
        print("  NOTE this may be WIDER than the records actually judged, because")
        print("       build_risk_candidates dropped records with no candidates.")
    else:
        raise FileNotFoundError(
            f"Cannot recover the scope. Looked for risk_verdicts_*.parquet in "
            f"{RSM_OUTPUT_DIR}, then {SCOPE_CSV}, then `results_with_truth` in the "
            f"kernel. Point RSM_OUTPUT_DIR at the previous run's output folder. "
            f"Do NOT scope from golden -- it breaks the head-to-head.")

    # --- reconciliation against rwt, when it happens to be in the kernel -----
    if "results_with_truth" in globals() and path is not None:
        _rwt = globals()["results_with_truth"]
        rwt_linked = set(_norm_id(
            _rwt.loc[_rwt["final_decision"].astype(str).str.upper() == "LINKED", "RECORD_ID"]))
        dropped = rwt_linked - scope
        print(f"  rwt LINKED records          : {len(rwt_linked):,}")
        print(f"  ... never judged by RSM lane: {len(dropped):,}"
              + (f"  e.g. {sorted(dropped)[:3]}" if dropped else ""))
        if dropped:
            print("      (no candidate risks or no alert text -- correctly excluded here too)")

    if save:
        pd.DataFrame({"RECORD_ID": sorted(scope)}).to_csv(SCOPE_CSV, index=False)
        print(f"  scope saved                 : {SCOPE_CSV}")
    print(f"  ==> SCOPE = {len(scope):,} records   (source: {src})")
    return scope, rsm_v


