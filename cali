def load_golden() -> pd.DataFrame:
    """Golden Record -> Policy links. VALIDATION ONLY -- never used to build
    candidates. Multi-id cells are exploded."""
    g = _read_any(GOLDEN_FILE).rename(columns=GOLDEN_RENAME)
    for c in ["RECORD_ID", "POLICY_ID"]:
        if c not in g.columns:
            raise KeyError(f"golden missing {c}; align GOLDEN_RENAME. Columns: {list(g.columns)}")
    g["POLICY_ID"] = g["POLICY_ID"].map(_as_text).str.split(GOLDEN_ID_SPLIT, regex=True)
    g = g.explode("POLICY_ID")
    for c in ["RECORD_ID", "POLICY_ID"]:
        g[c] = _norm_id(g[c])
    g = g[~g.RECORD_ID.isin(_BLANK) & ~g.POLICY_ID.isin(_BLANK)]
    return g[["RECORD_ID", "POLICY_ID"]].drop_duplicates().reset_index(drop=True)


def load_alerts(record_ids) -> pd.DataFrame:
    """Build one cleaned alert text per record, restricted to the records we run.
    (Verbatim from the risk lanes so alert text is enriched IDENTICALLY here.)"""
    df = pd.read_parquet(ALERTS_FILE, engine="pyarrow")

    for col in ["TITLE", "BODY_TEXT", "UPDATE_TEXT",
                "JURISDICTION_CODE", "JURISDICTION_NAME", "AUTHORITY_CODE"]:
        if col in df.columns:                      # AUTHORITY_CODE may not exist
            df[col] = df[col].fillna("").map(clean)
        else:
            df[col] = ""

    # When the running summary equals the original content, don't repeat it.
    content_equals_update = df["BODY_TEXT"] == df["UPDATE_TEXT"]
    df["alert_text"] = np.where(
        content_equals_update,
        (df.TITLE + "\n\n" + df.BODY_TEXT).str.strip(),
        ("Title:- "                   + df.TITLE
         + "\n\nContent:- "           + df.BODY_TEXT
         + "\n\nUpdate:- "            + df.UPDATE_TEXT
         + "\n\nJurisdiction Code:- " + df.JURISDICTION_CODE
         + "\n\nJurisdiction Name:- " + df.JURISDICTION_NAME
         + "\n\nAuthority Code:- "    + df.AUTHORITY_CODE).str.strip())

    df["RECORD_ID"] = _norm_id(df["RECORD_ID"])
    df = df[df.RECORD_ID.isin(record_ids) & (df.alert_text.str.len() > 0)]
    return df[["RECORD_ID", "alert_text"]].drop_duplicates("RECORD_ID").reset_index(drop=True)


