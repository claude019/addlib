def project_cost():
    """Rough spend BEFORE the run. Input tokens are counted exactly
    (TOKEN_ESTIMATOR); output tokens are an assumption -- compare against the
    real ledger in [G] after a 10-record smoke run and tune
    EST_OUT_TOKENS_PER_POLICY."""
    alerts_df = load_alerts(scope_records)
    n_alert, n_pol, chunk = len(alerts_df), len(policies), LANE["chunk"]
    calls_per_alert = math.ceil(n_pol / chunk) if n_pol else 0

    p_tok   = policies.policy_text.map(_count_tokens)
    a_tok   = alerts_df.alert_text.map(_count_tokens)
    sys_tok = _count_tokens(POLICY_SYSTEM_PROMPT)

    fixed_per_alert = (calls_per_alert * (sys_tok + PER_CALL_MSG_OVERHEAD)
                       + int(p_tok.sum()) + n_pol * PER_POLICY_JSON_OVERHEAD)
    judge_in  = n_alert * fixed_per_alert + int((a_tok * calls_per_alert).sum())
    judge_out = n_alert * n_pol * EST_OUT_TOKENS_PER_POLICY
    worst_chunk_in = (sys_tok + int(a_tok.max() if len(a_tok) else 0)
                      + int(p_tok.nlargest(chunk).sum()))
    embed_tok = int(p_tok.sum() + a_tok.sum()) if LANE["order_by_embedding"] else 0

    usd_judge = _usd(MODEL, judge_in, 0, judge_out)
    usd_embed = _usd(EMBED_MODEL, embed_tok, 0, 0)
    fmt = lambda x: "unpriced" if x is None else f"${x:,.2f}"

    bar = "=" * 78
    print(bar); print(f"[B2] COST PROJECTION  (tokens: {TOKEN_ESTIMATOR})"); print(bar)
    print(f"  alerts x policies                : {n_alert:,} x {n_pol:,}")
    print(f"  judge calls (chunk={chunk})           : {n_alert * calls_per_alert:,}")
    print(f"  system prompt tokens             : {sys_tok:,}")
    print(f"  policy tokens  median / max      : {int(p_tok.median()):,} / {int(p_tok.max()):,}")
    print(f"  alert tokens   median / max      : "
          f"{int(a_tok.median()) if len(a_tok) else 0:,} / {int(a_tok.max()) if len(a_tok) else 0:,}")
    print(f"  WORST-CASE input per call        : {worst_chunk_in:,} tokens"
          "   <- lower chunk if this nears the context limit")
    print(f"  judge  in / out tokens           : {judge_in:,} / {judge_out:,}  -> {fmt(usd_judge)}")
    print(f"  embeddings (upper bound)         : {embed_tok:,}  -> {fmt(usd_embed)}")
    if usd_judge is not None:
        print(f"  judge cost per alert             : ${usd_judge / max(n_alert, 1):.4f}")
    return {"judge_in": judge_in, "judge_out": judge_out, "embed_tokens": embed_tok,
            "usd_judge": usd_judge, "usd_embed": usd_embed,
            "calls": n_alert * calls_per_alert}


