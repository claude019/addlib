# ============================================================
# 3. FUNCTION TO SAFELY PARSE JSON
# ============================================================

def parse_json(x):

    # Already parsed
    if isinstance(x, (dict, list)):
        return x

    # JSON stored as string
    if isinstance(x, str):

        x = x.strip()

        if not x:
            return None

        try:
            return json.loads(x)

        except Exception:
            return None

    return None


# ============================================================
# 4. FUNCTION TO CONVERT ANY JSON VALUE TO A STRING
# ============================================================

def value_to_string(value):

    if value is None:
        return None

    # Dictionary
    if isinstance(value, dict):
        return json.dumps(
            value,
            ensure_ascii=False
        )

    # List
    if isinstance(value, list):
        return json.dumps(
            value,
            ensure_ascii=False
        )

    return str(value)


# ============================================================
# 5. FULL RECURSIVE JSON FLATTENER
# ============================================================

def flatten_json(obj, path=""):
    """
    Recursively walks through the complete JSON object.

    Example:

    {
        "policyApplication": {
            "segment": [
                {
                    "sgmntText": "ABC",
                    "sgmntTypeCode": "01"
                },
                {
                    "sgmntText": "XYZ",
                    "sgmntTypeCode": "02"
                }
            ]
        }
    }

    becomes:

    policyApplication.segment[].sgmntText
    policyApplication.segment[].sgmntTypeCode

    Multiple values for the same path are stored together.
    """

    result = {}

    # --------------------------------------------------------
    # DICTIONARY
    # --------------------------------------------------------

    if isinstance(obj, dict):

        for key, value in obj.items():

            if path:
                current_path = f"{path}.{key}"
            else:
                current_path = str(key)

            child_result = flatten_json(
                value,
                current_path
            )

            for k, v in child_result.items():

                if k in result:

                    # Multiple values for same path
                    if not isinstance(result[k], list):
                        result[k] = [result[k]]

                    if isinstance(v, list):
                        result[k].extend(v)
                    else:
                        result[k].append(v)

                else:

                    result[k] = v

        return result


    # --------------------------------------------------------
    # LIST / ARRAY
    # --------------------------------------------------------

    elif isinstance(obj, list):

        # Empty array
        if len(obj) == 0:

            return {
                path + "[]": None
            }

        combined = {}

        for item in obj:

            child_result = flatten_json(
                item,
                path + "[]"
            )

            for k, v in child_result.items():

                if k not in combined:

                    combined[k] = v

                else:

                    if not isinstance(
                        combined[k],
                        list
                    ):
                        combined[k] = [
                            combined[k]
                        ]

                    if isinstance(v, list):
                        combined[k].extend(v)
                    else:
                        combined[k].append(v)

        return combined


    # --------------------------------------------------------
    # LEAF VALUE
    # --------------------------------------------------------

    else:

        return {
            path: value_to_string(obj)
        }


# ============================================================
# 6. FULL PARSING
# ============================================================

parsed_records = []

invalid_json_count = 0

print("Parsing JSON...")

for index, row in df_raw.iterrows():

    # --------------------------------------------------------
    # IMPORTANT:
    # Change 'json_data' here if your JSON column
    # has a different name.
    # --------------------------------------------------------

    json_object = parse_json(
        row["json_data"]
    )

    # --------------------------------------------------------
    # Keep ALL original columns except json_data.
    # --------------------------------------------------------

    record = row.drop(
        labels=["json_data"]
    ).to_dict()

    # --------------------------------------------------------
    # Invalid / empty JSON
    # --------------------------------------------------------

    if json_object is None:

        invalid_json_count += 1

        parsed_records.append(
            record
        )

        continue

    # --------------------------------------------------------
    # Flatten COMPLETE JSON
    # --------------------------------------------------------

    flattened = flatten_json(
        json_object
    )

    # --------------------------------------------------------
    # Add flattened JSON variables
    # --------------------------------------------------------

    for key, value in flattened.items():

        # If multiple values exist for a JSON path,
        # combine them into one readable cell.

        if isinstance(value, list):

            value = " | ".join(
                [
                    str(v)
                    for v in value
                    if v is not None
                ]
            )

        record[key] = value

    parsed_records.append(
        record
    )


# ============================================================
