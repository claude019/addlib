# ============================================================
# 3. HELPER - SAFE JSON PARSER
# ============================================================

def safe_json_loads(x):
    """
    Safely convert a value into a Python JSON object.

    Handles:
        - None
        - dict
        - list
        - JSON string
        - invalid JSON
    """

    if x is None:
        return None

    if isinstance(x, (dict, list)):
        return x

    if isinstance(x, str):

        x = x.strip()

        if x == "":
            return None

        try:
            return json.loads(x)

        except Exception:
            return None

    return None


# ============================================================
# 4. HELPER - DETERMINE DATA TYPE
# ============================================================

def get_value_type(value):

    if value is None:
        return "null"

    if isinstance(value, bool):
        return "bool"

    if isinstance(value, int):
        return "int"

    if isinstance(value, float):
        return "float"

    if isinstance(value, str):
        return "str"

    if isinstance(value, dict):
        return "dict"

    if isinstance(value, list):
        return "list"

    return type(value).__name__


# ============================================================
# 5. RECURSIVE JSON FLATTENER
# ============================================================

def flatten_json(
    obj,
    parent_path="",
    array_mode="generic"
):
    """
    Recursively walks through the COMPLETE JSON object.

    Example:

        {
            "policyApplication": {
                "segment": [
                    {
                        "sgmntText": "ABC",
                        "sgmntTypeCode": "01"
                    }
                ]
            }
        }

    becomes:

        policyApplication.segment[].sgmntText
        policyApplication.segment[].sgmntTypeCode

    Arrays use [] instead of [0], [1], etc.
    This makes it possible to compare schema across countries.
    """

    records = []

    # --------------------------------------------------------
    # DICTIONARY
    # --------------------------------------------------------

    if isinstance(obj, dict):

        if len(obj) == 0:

            records.append({
                "json_path": parent_path,
                "value": None,
                "value_type": "empty_dict"
            })

            return records

        for key, value in obj.items():

            if parent_path:

                current_path = (
                    f"{parent_path}.{key}"
                )

            else:

                current_path = str(key)

            records.extend(
                flatten_json(
                    value,
                    parent_path=current_path,
                    array_mode=array_mode
                )
            )

        return records

    # --------------------------------------------------------
    # LIST / ARRAY
    # --------------------------------------------------------

    elif isinstance(obj, list):

        if len(obj) == 0:

            records.append({
                "json_path": parent_path + "[]",
                "value": None,
                "value_type": "empty_list"
            })

            return records

        for item in obj:

            current_path = (
                parent_path + "[]"
            )

            records.extend(
                flatten_json(
                    item,
                    parent_path=current_path,
                    array_mode=array_mode
                )
            )

        return records

    # --------------------------------------------------------
    # LEAF VALUE
    # --------------------------------------------------------

    else:

        records.append({
            "json_path": parent_path,
            "value": obj,
            "value_type": get_value_type(obj)
        })

        return records


# ============================================================
# 6. PARSE ONE BIGQUERY TABLE
# ============================================================

def parse_gpps_table(
    country,
    table_short_name,
    max_rows=None
):
    """
    Reads one GPPS country table and completely parses json_data.
    """

    full_table_name = (
        f"{DATA_PROJECT}.{DATASET}.{table_short_name}"
    )

    print()
    print("=" * 80)
    print(f"COUNTRY : {country}")
    print(f"TABLE   : {full_table_name}")
    print("=" * 80)

    # --------------------------------------------------------
    # IMPORTANT:
    # Do NOT SELECT *.
    # Only retrieve columns required for JSON analysis.
    # --------------------------------------------------------

    limit_clause = ""

    if max_rows is not None:
        limit_clause = f"LIMIT {int(max_rows)}"

    query = f"""
        SELECT
            policy_core_id,
            version_num,
            json_data
        FROM `{full_table_name}`
        {limit_clause}
    """

    try:

        df_raw = bq_client.query(
            query
        ).to_dataframe()

    except Exception as e:

        print("ERROR READING TABLE")
        print(e)

        return None, None

    print(
        f"Rows read: {len(df_raw):,}"
    )

    if len(df_raw) == 0:

        print("Table is empty.")

        return df_raw, pd.DataFrame()

    parsed_rows = []

    invalid_json_count = 0

    # --------------------------------------------------------
    # PARSE EACH JSON RECORD
    # --------------------------------------------------------

    for row_number, row in df_raw.iterrows():

        parsed_json = safe_json_loads(
            row["json_data"]
        )

        if parsed_json is None:

            invalid_json_count += 1

            continue

        flattened = flatten_json(
            parsed_json
        )

        for item in flattened:

            parsed_rows.append({

                "country":
                    country,

                "table_name":
                    table_short_name,

                "policy_core_id":
                    row["policy_core_id"],

                "version_num":
                    row["version_num"],

                "json_path":
                    item["json_path"],

                "value":
                    item["value"],

                "value_type":
                    item["value_type"]

            })

    df_parsed = pd.DataFrame(
        parsed_rows
    )

    print(
        f"Invalid / empty JSON records: "
        f"{invalid_json_count:,}"
    )

    if len(df_parsed) > 0:

        print(
            f"JSON variables found: "
            f"{df_parsed['json_path'].nunique():,}"
        )

        print(
            f"Flattened records: "
            f"{len(df_parsed):,}"
        )

    return df_raw, df_parsed


# ============================================================
# 7. VARIABLE PROFILE
# ============================================================

def create_variable_profile(
    df_parsed
):
    """
    Creates one row per JSON variable/path.

    Gives:
        - occurrence count
        - number of records containing variable
        - non-null count
        - distinct values
        - data types
        - example value
    """

    if df_parsed is None or len(df_parsed) == 0:

        return pd.DataFrame()

    grouped = []

    # --------------------------------------------------------
    # GROUP BY COUNTRY + TABLE + JSON PATH
    # --------------------------------------------------------

    for (
        country,
        table_name,
        json_path
    ), grp in df_parsed.groupby(
        [
            "country",
            "table_name",
            "json_path"
        ],
        dropna=False
    ):

        values = grp["value"]

        # Number of non-null values
        non_null_values = values[
            values.notna()
        ]

        # Convert to string for distinct count
        distinct_count = (
            values
            .dropna()
            .astype(str)
            .nunique()
        )

        # Data types observed
        types = sorted(
            grp["value_type"]
            .dropna()
            .astype(str)
            .unique()
            .tolist()
        )

        # Find sample value
        sample_value = None

        for value in values:

            if pd.notna(value):

                try:
                    sample_value = str(value)

                except Exception:
                    sample_value = repr(value)

                break

        if sample_value is not None:
            sample_value = sample_value[:500]

        grouped.append({

            "country":
                country,

            "table_name":
                table_name,

            "json_path":
                json_path,

            "occurrences":
                len(grp),

            "non_null_count":
                len(non_null_values),

            "null_count":
                len(grp) - len(non_null_values),

            "distinct_values":
                distinct_count,

            "data_types":
                ", ".join(types),

            "sample_value":
                sample_value

        })

    profile = pd.DataFrame(
        grouped
    )

    if len(profile) > 0:

        profile["null_pct"] = (
            profile["null_count"]
            /
            profile["occurrences"]
            * 100
        ).round(2)

    return profile


