# ============================================================
# GPPS Procedure table -- FULL ANALYSIS + interactive JSON viewer
# Single table: aa_hsbc_gpps_gpps_procedure (no discovery needed)
#
# One run, one load of the table, produces:
#   SECTION 1 -- load + physical/JSON schema detection
#   SECTION 2 -- full-record field validation (old vs fixed text
#                length, so you can see the combined-text fix working)
#   SECTION 3 -- per-procedure detail table
#   SECTION 4 -- single-row summary (same "Attachments analysis"
#                column layout as before)
#   SECTION 5 -- attachment x text-length pivot (<100/<500/<1000)
#   SECTION 6 -- everything written to one Excel workbook
#   SECTION 7 -- interactive JSON viewer (one dropdown now, since
#                there's only one table)
# ============================================================

import os
import re
import json
import statistics
from collections import Counter
import pandas as pd
from bs4 import BeautifulSoup

try:
    bq_client
except NameError:
    from google.cloud import bigquery
    ANALYTICS_PROJECT = "hsbc-12211200-cmlpwb-prod"
    DATA_PROJECT = "hsbc-11545401-cmpdatcwrs1-prod"
    DATASET = "rc_curated_prod"
    LOCATION = "EU"  # adjust to match your existing setup if this errors

    os.environ["GOOGLE_CLOUD_PROJECT"] = ANALYTICS_PROJECT
    os.environ["GOOGLE_APPLICATION_CREDENTIALS"] = (
        "/home/jovyan/.config/gcloud/application_default_credentials.json"
    )
    bq_client = bigquery.Client(project=ANALYTICS_PROJECT, location=LOCATION)

pd.set_option("display.max_columns", None)
pd.set_option("display.max_rows", 200)
pd.set_option("display.max_colwidth", 120)

TABLE = "aa_hsbc_gpps_gpps_procedure"
SUFFICIENT_TEXT_LEN = 1000
THRESHOLDS = [100, 500, 1000]
OUTPUT_PATH = "Procedure_Full_Analysis.xlsx"


# ============================================================
# Helpers
# ============================================================

def safe_json_loads(x):
    if x is None:
        return None
    if isinstance(x, dict):
        return x
    if isinstance(x, str):
        try:
            return json.loads(x)
        except Exception:
            return None
    return None


def strip_html(text):
    if not isinstance(text, str) or not text.strip():
        return ""
    try:
        return BeautifulSoup(text, "html.parser").get_text(separator=" ", strip=True)
    except Exception:
        return re.sub(r"<[^>]+>", " ", text)


def detect_physical_columns(df):
    cols = list(df.columns)
    id_col = next((c for c in cols if re.search(r"(?i)core.?id$", c)), None) \
        or next((c for c in cols if re.search(r"(?i)_id$", c)), None)
    version_col = next((c for c in cols if "version" in c.lower()), None)
    json_col = next((c for c in cols if "json" in c.lower()), None)
    return id_col, version_col, json_col


def detect_json_fields(parsed):
    text_candidates = []
    application_key = None
    for k, v in parsed.items():
        if isinstance(v, dict) and any(re.search(r"(?i)sgmnttext", kk) for kk in v):
            text_candidates.append(k)
        if isinstance(v, dict) and ("appendix" in v or "guidance" in v or "segment" in v):
            application_key = k

    main_text_key = next((k for k in text_candidates if "purpose" not in k.lower()), None)
    if main_text_key is None and text_candidates:
        main_text_key = text_candidates[0]

    title_key = next(
        (k for k, v in parsed.items() if isinstance(v, str) and "titl" in k.lower()),
        None,
    )
    return {"main_text_key": main_text_key, "application_key": application_key, "title_key": title_key}


def detect_segment_text_key(parsed, application_key):
    if not application_key:
        return None
    segments = (parsed.get(application_key) or {}).get("segment")
    if not isinstance(segments, list) or not segments:
        return None
    first = next((s for s in segments if isinstance(s, dict)), None)
    if not first:
        return None
    return next((k for k in first if re.search(r"(?i)sgmnttext", k)), None)


def detect_segment_disp_key(parsed, application_key):
    if not application_key:
        return None
    segments = (parsed.get(application_key) or {}).get("segment")
    if not isinstance(segments, list) or not segments:
        return None
    first = next((s for s in segments if isinstance(s, dict)), None)
    if not first:
        return None
    return next((k for k in first if re.search(r"(?i)disp.*ind|actv.*ind", k)), None)


def get_combined_text(parsed, main_text_key, application_key, segment_text_key):
    main_text = ""
    if main_text_key:
        main_text = strip_html((parsed.get(main_text_key) or {}).get("sgmntText"))

    segment_texts = []
    if application_key and segment_text_key:
        segments = (parsed.get(application_key) or {}).get("segment")
        if isinstance(segments, list):
            for seg in segments:
                if isinstance(seg, dict):
                    t = strip_html(seg.get(segment_text_key))
                    if t:
                        segment_texts.append(t)

    combined = "\n".join([t for t in [main_text] + segment_texts if t])
    return combined, len(main_text), len(combined), len(segment_texts)


def count_active_attachments(parsed, application_key):
    if not application_key:
        return False, 0, []
    app = parsed.get(application_key) or {}
    n_active, names = 0, []
    for src in ("appendix", "guidance"):
        items = app.get(src)
        if isinstance(items, list):
            for it in items:
                if isinstance(it, dict) and it.get("actvFlg") == "Y":
                    n_active += 1
                    name = it.get("docName") or it.get("gppsDocName") or it.get("docUrl")
                    if name:
                        names.append(str(name))
    return n_active > 0, n_active, names


# ============================================================
# SECTION 1 -- Load the table
# ============================================================

print("=" * 80)
print(f"SECTION 1 -- Loading {TABLE}")
print("=" * 80)

full_table = f"{DATA_PROJECT}.{DATASET}.{TABLE}"
df = bq_client.query(f"SELECT * FROM `{full_table}`").to_dataframe()

id_col, version_col, json_col = detect_physical_columns(df)
print(f"Physical columns -- id: {id_col!r}, version: {version_col!r}, json: {json_col!r}")
print(f"Total ROWS (all versions): {len(df):,}")
print(f"Distinct {id_col} values:   {df[id_col].nunique():,}")

dupes = df.groupby([id_col, version_col]).size()
n_dupes = (dupes > 1).sum()
if n_dupes:
    print(f">>> WARNING: {n_dupes} (id, version) pairs appear more than once -- "
          f"dedup via tail(1) is not guaranteed unique here.")
else:
    print(f"(id, version) pairs appearing more than once: 0 -- dedup is safe.")


# ============================================================
# SECTION 2 -- Schema detection + full-record validation
# ============================================================

print("\n\n" + "=" * 80)
print("SECTION 2 -- Field detection and full-record validation")
print("=" * 80)

latest = df.sort_values(version_col).groupby(id_col, as_index=False).tail(1).copy()
latest["parsed"] = latest[json_col].apply(safe_json_loads)
total = latest[id_col].nunique()

sample_parsed = next((p for p in latest["parsed"] if isinstance(p, dict)), None)
if sample_parsed is None:
    raise ValueError("No parseable JSON records found in this table.")

fields = detect_json_fields(sample_parsed)
main_text_key = fields["main_text_key"]
application_key = fields["application_key"]
title_key = fields["title_key"]
segment_text_key = detect_segment_text_key(sample_parsed, application_key)
disp_key = detect_segment_disp_key(sample_parsed, application_key)

print(f"Detected -- main text field: {main_text_key!r}")
print(f"            attachment/segment container: {application_key!r}")
print(f"            segment body-text field: {segment_text_key!r}")
print(f"            title field: {title_key!r}")
if disp_key:
    print(f"            segment display/active flag seen: {disp_key!r} "
          f"(informational only -- not filtered on below)")

parse_ok = latest["parsed"].apply(lambda p: isinstance(p, dict)).sum()
main_only_lens, combined_lens = [], []
has_main_text_key = has_segment_text = 0
disp_value_counter = Counter()

for p in latest["parsed"]:
    if not isinstance(p, dict):
        continue
    if main_text_key and main_text_key in p:
        has_main_text_key += 1
    segs = (p.get(application_key) or {}).get("segment") if application_key else None
    if isinstance(segs, list) and segment_text_key:
        if any(isinstance(s, dict) and s.get(segment_text_key) for s in segs):
            has_segment_text += 1
        if disp_key:
            for s in segs:
                if isinstance(s, dict):
                    disp_value_counter[s.get(disp_key)] += 1
    _, main_len, combined_len, _ = get_combined_text(p, main_text_key, application_key, segment_text_key)
    main_only_lens.append(main_len)
    combined_lens.append(combined_len)

print(f"\nJSON parse success: {parse_ok}/{total} ({parse_ok / total * 100:.1f}%)")
if main_text_key:
    print(f"Records with {main_text_key!r} present: "
          f"{has_main_text_key}/{parse_ok} ({has_main_text_key / parse_ok * 100:.1f}%)")
if segment_text_key:
    print(f"Records with >=1 non-empty segment text: "
          f"{has_segment_text}/{parse_ok} ({has_segment_text / parse_ok * 100:.1f}%)")
if disp_value_counter:
    print(f"Segment {disp_key!r} value distribution: {dict(disp_value_counter)}")

if main_only_lens and combined_lens:
    print(f"\nText length, OLD method (main text field only):")
    print(f"  median={statistics.median(main_only_lens):.0f}, mean={statistics.mean(main_only_lens):.0f}")
    print(f"Text length, FIXED method (main text + all segment text):")
    print(f"  median={statistics.median(combined_lens):.0f}, mean={statistics.mean(combined_lens):.0f}")
    old_sufficient = sum(1 for L in main_only_lens if L > SUFFICIENT_TEXT_LEN)
    new_sufficient = sum(1 for L in combined_lens if L > SUFFICIENT_TEXT_LEN)
    print(f"'Sufficient text' (>1000 chars) -- OLD: {old_sufficient}, FIXED: {new_sufficient}")


# ============================================================
# SECTION 3 -- Per-procedure detail table
# ============================================================

print("\n\n" + "=" * 80)
print("SECTION 3 -- Per-procedure detail")
print("=" * 80)

detail_rows = []
viewer_lookup = {}  # viewer_lookup[procedure_core_id] = parsed json

for _, row in latest.iterrows():
    parsed = row["parsed"]
    pid = row[id_col]

    if not isinstance(parsed, dict):
        viewer_lookup[pid] = {"_parse_error": True, "_raw": str(row[json_col])[:2000]}
        detail_rows.append({
            "procedure_core_id": pid, "version_num": row[version_col], "Title": None,
            "Text length": 0, "N segments with text": 0,
            "Has attachment": False, "N active attachments": 0,
            "Attachment names": None, "JSON parse error": True,
        })
        continue

    viewer_lookup[pid] = parsed
    combined_text, _, text_len, n_segs = get_combined_text(parsed, main_text_key, application_key, segment_text_key)
    has_attach, n_attach, attach_names = count_active_attachments(parsed, application_key)

    detail_rows.append({
        "procedure_core_id": pid,
        "version_num": row[version_col],
        "Title": parsed.get(title_key) if title_key else None,
        "Text length": text_len,
        "N segments with text": n_segs,
        "Has attachment": has_attach,
        "N active attachments": n_attach,
        "Attachment names": "; ".join(attach_names) if attach_names else None,
        "JSON parse error": False,
    })

detail_df = pd.DataFrame(detail_rows).sort_values("procedure_core_id").reset_index(drop=True)
print(f"{len(detail_df):,} procedures scored")
print("\nFirst 20 rows:")
display(detail_df.head(20))


# ============================================================
# SECTION 4 -- Single-row summary (same column layout as before)
# ============================================================

print("\n\n" + "=" * 80)
print("SECTION 4 -- Summary (Attachments analysis)")
print("=" * 80)

with_attachment = int(detail_df["Has attachment"].sum())
sufficient_text = int((detail_df["Text length"] > SUFFICIENT_TEXT_LEN).sum())
attach_and_lt500 = int((detail_df["Has attachment"] & (detail_df["Text length"] < 500)).sum())
attach_and_lt1000 = int((detail_df["Has attachment"] & (detail_df["Text length"] < 1000)).sum())

summary_df = pd.DataFrame([{
    "Table": TABLE,
    "Total procedures": total,
    "Procedures with attachment": with_attachment,
    "Procedures with sufficient text in RCDP (>1000 chars)": sufficient_text,
    "have Attachment and text <500": attach_and_lt500,
    "have Attachment and text <1000": attach_and_lt1000,
    "% All Procedures: Attachment and Text <500": round(attach_and_lt500 / total * 100, 2) if total else 0,
    "% All Procedures: Attachment and Text <1000": round(attach_and_lt1000 / total * 100, 2) if total else 0,
}])
display(summary_df)


# ============================================================
# SECTION 5 -- Attachment x text-length pivot
# ============================================================

print("\n\n" + "=" * 80)
print("SECTION 5 -- Attachment x text-length pivot")
print("=" * 80)

has_mask = detail_df["Has attachment"] == True
no_mask = ~has_mask
text = detail_df["Text length"]


def row_for(mask):
    out = {"Procedures": int(mask.sum())}
    for t in THRESHOLDS:
        out[f"Text length < {t}"] = int((mask & (text < t)).sum())
    return out


pivot_df = pd.DataFrame({
    "Has attachment": row_for(has_mask),
    "No attachment": row_for(no_mask),
}).T
pivot_df.loc["TOTAL"] = pivot_df.sum(numeric_only=True)
pivot_df = pivot_df.astype(int)
pivot_df.index.name = "Attachment status"
display(pivot_df)


# ============================================================
# SECTION 6 -- Export everything to one workbook
# ============================================================

with pd.ExcelWriter(OUTPUT_PATH, engine="openpyxl") as writer:
    summary_df.to_excel(writer, sheet_name="Attachments analysis", index=False)
    detail_df.to_excel(writer, sheet_name="Procedure detail", index=False)
    pivot_df.to_excel(writer, sheet_name="Attachment x Text Length")

print(f"\nAll three tables written to: {OUTPUT_PATH}")
print(f"viewer_lookup built: {len(viewer_lookup):,} procedures, ready for Section 7 below.")


# ============================================================
# SECTION 7 -- Interactive JSON viewer (single table -> one dropdown)
# ============================================================

print("\n\n" + "=" * 80)
print("SECTION 7 -- Interactive JSON viewer")
print("=" * 80)

import ipywidgets as widgets
from IPython.display import display as ipy_display, JSON, clear_output

procedure_dd = widgets.Dropdown(
    options=sorted(viewer_lookup.keys()),
    description="Procedure ID:",
    style={"description_width": "initial"},
    layout=widgets.Layout(width="400px"),
)
info_label = widgets.Label()
viewer_output = widgets.Output()


def _on_procedure_change(change):
    with viewer_output:
        clear_output()
        pid = procedure_dd.value
        if pid is None:
            return
        data = viewer_lookup[pid]
        info_label.value = f"procedure_core_id {pid}  |  {len(viewer_lookup):,} procedures in this table"
        ipy_display(JSON(data, expanded=False))


procedure_dd.observe(_on_procedure_change, names="value")

if procedure_dd.options:
    procedure_dd.value = procedure_dd.options[0]  # triggers initial render

ipy_display(widgets.VBox([procedure_dd, info_label, viewer_output]))

print("\nUse the dropdown above to select a procedure_core_id. The viewer shows its "
      "full parsed JSON as a collapsible tree (click to expand/collapse nodes).")
