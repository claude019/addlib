# ============================================================
# Helpers
# ============================================================

def safe_json_loads(x):
    if x is None:
        return None
    if isinstance(x, dict):
        return x
    if isinstance(x, str):
        try:
            return json.loads(x)
        except Exception:
            return None
    return None


def pick_latest_version(df):
    """Per procedure_core_id: the PUBL version (versn.procVersnStatCde ==
    'PUBL') with the highest version_num. Falls back to the highest
    version_num overall if no PUBL version exists. One row per
    procedure_core_id."""
    df = df.copy()
    df["parsed"] = df["json_data"].apply(safe_json_loads)
    df["vers_stat"] = df["parsed"].apply(
        lambda p: ((p or {}).get("versn") or {}).get("procVersnStatCde")
    )

    publ = df[df["vers_stat"] == "PUBL"]
    publ_latest = (
        publ.sort_values("version_num")
        .groupby("procedure_core_id", as_index=False)
        .tail(1)
    )

    missing_ids = set(df["procedure_core_id"]) - set(publ_latest["procedure_core_id"])
    fallback = df[df["procedure_core_id"].isin(missing_ids)]
    fallback_latest = (
        fallback.sort_values("version_num")
        .groupby("procedure_core_id", as_index=False)
        .tail(1)
    )

    return pd.concat([publ_latest, fallback_latest], ignore_index=True)


def active_attachments(parsed):
    """Combined appendix[] + guidance[] items with actvFlg == 'Y', under
    procedureApplication. Returns a list of docName (confirmed as the
    right match field on the policy side; falls back to gppsDocName)."""
    app = (parsed or {}).get("procedureApplication") or {}
    names = []
    for src in ("appendix", "guidance"):
        items = app.get(src)
        if isinstance(items, list):
            for it in items:
                if isinstance(it, dict) and it.get("actvFlg") == "Y":
                    name = it.get("docName") or it.get("gppsDocName")
                    if name:
                        names.append(name)
    return names


def list_source_objects(procedure_id, version_num):
    """READ-ONLY. Prefix segment "procedure" (singular) is an unverified
    assumption -- see SECTION 0 below."""
    prefix = f"gpps_attachment/procedure/{procedure_id}/{version_num}/"
    try:
        objects = source_client.list_objects(bucket_name=SOURCE_BUCKET, prefix=prefix)
    except Exception as e:
        print(f"  !! list_objects failed for procedure {procedure_id} v{version_num}: {e}")
        objects = []
    return objects, prefix


def copy_one_file(object_name, dest_blob_path, doc_name):
    """Download from the source (read-only) bucket, upload to the
    destination bucket, then let the TemporaryDirectory clean up the
    local copy -- keeps local disk usage to one file at a time."""
    with tempfile.TemporaryDirectory() as tmp:
        local_path = Path(tmp) / doc_name
        source_client.download_object(
            bucket_name=SOURCE_BUCKET,
            object_name=object_name,
            destination_file=str(local_path),
        )
        blob = dest_bucket.blob(dest_blob_path)
        blob.upload_from_filename(str(local_path))


