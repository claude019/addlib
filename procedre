# ============================================================
# Main -- single pass: audit + copy together, per procedure
# ============================================================

full_table = f"{DATA_PROJECT}.{DATASET}.{PROC_TABLE}"
print(f"Loading {PROC_TABLE} ...")
df = bq_client.query(f"SELECT * FROM `{full_table}`").to_dataframe()
print(f"{len(df):,} rows loaded.")

latest = pick_latest_version(df)
print(f"{len(latest):,} procedures (latest version each)")

detail_rows = []
copy_errors = []  # (procedure_id, doc_name, error) -- for the log file

for _, row in latest.iterrows():
    procedure_id = row["procedure_core_id"]
    version_num = row["version_num"]
    parsed = row["parsed"]
    if not isinstance(parsed, dict):
        continue

    expected_names = active_attachments(parsed)
    expected_count = len(expected_names)

    if expected_count == 0:
        detail_rows.append({
            "Country": "GLOBAL", "Procedure_id": procedure_id,
            "Number of attachments": 0,
            "No of attachments found in the gcs bucket": 0,
            "Number of attachments not found": 0,
            "Number of matches found": 0,
            "Missing filenames": "",
            "Found filenames": "",
        })
        continue

    objects, prefix = list_source_objects(procedure_id, version_num)
    found_names = {os.path.basename(o) for o in objects}
    found_count = len(objects)

    matched_names = [n for n in expected_names if n in found_names]
    missing_names = [n for n in expected_names if n not in found_names]
    matches_count = len(matched_names)
    not_found_count = len(missing_names)

    detail_rows.append({
        "Country": "GLOBAL", "Procedure_id": procedure_id,
        "Number of attachments": expected_count,
        "No of attachments found in the gcs bucket": found_count,
        "Number of attachments not found": not_found_count,
        "Number of matches found": matches_count,
        "Missing filenames": "; ".join(missing_names),
        "Found filenames": "; ".join(matched_names),
    })

    for doc_name in matched_names:
        object_name = f"{prefix}{doc_name}"
        dest_blob_path = f"{SNAPSHOT_ROOT}/{COUNTRY_FOLDER}/{procedure_id}/{doc_name}"
        try:
            copy_one_file(object_name, dest_blob_path, doc_name)
        except Exception as e:
            print(f"  !! copy failed -- procedure {procedure_id}, {doc_name}: {e}")
            copy_errors.append((procedure_id, doc_name, str(e)))

print("\nDone.")

# ============================================================
# Audit table
# ============================================================

recon_df = (
    pd.DataFrame(detail_rows)
    .sort_values(["Procedure_id"])
    .reset_index(drop=True)
)

# ============================================================
# Overall level -- same Set A/Set B rollup as the policy pipeline.
# With no country split this naturally collapses to a single GLOBAL row.
# ============================================================

MATCH_COL = "Number of matches found"
NOT_FOUND_COL = "Number of attachments not found"
EXPECTED_COL = "Number of attachments"

reconcilable = recon_df[recon_df[EXPECTED_COL] > 0].copy()
reconcilable["is_set_b"] = reconcilable[NOT_FOUND_COL] > 0

overall_rows = []
for country, grp in reconcilable.groupby("Country"):
    set_a = grp[~grp["is_set_b"]]
    set_b = grp[grp["is_set_b"]]
    overall_rows.append({
        "Country": country,
        "Number of policies for which all documents are found": len(set_a),
        "Number of documents found": grp[MATCH_COL].sum(),
        "Number of policies for which atleast 1 document is missing (set B)": len(set_b),
        "Set B - number of documents not found": set_b[NOT_FOUND_COL].sum(),
        "Set B Number of documents found": set_b[MATCH_COL].sum(),
    })

overall_df = pd.DataFrame(overall_rows)

set_b_cols = [
    "Country", "Procedure_id", EXPECTED_COL, MATCH_COL, NOT_FOUND_COL,
    "Missing filenames", "Found filenames",
]
set_b_df = (
    reconcilable[reconcilable["is_set_b"]][set_b_cols]
    .rename(columns={
        EXPECTED_COL: "Expected active attachments",
        MATCH_COL: "Found",
        NOT_FOUND_COL: "Missing count",
    })
    .sort_values(["Procedure_id"])
    .reset_index(drop=True)
)

# ============================================================
# Local export -- three sheets
# ============================================================

with pd.ExcelWriter(OUTPUT_PATH, engine="openpyxl") as writer:
    recon_df.to_excel(writer, sheet_name="Audit", index=False)
    overall_df.to_excel(writer, sheet_name="Overall level", index=False)
    set_b_df.to_excel(writer, sheet_name="Set B - missing procedures", index=False)

print(f"\nAudit workbook written to: {OUTPUT_PATH}")
display(overall_df)
display(set_b_df)

# ============================================================
# GCS log file -- written directly into the snapshot folder
# ============================================================

log_lines = []
log_lines.append(f"GPPS Procedure Attachment Snapshot -- {SNAPSHOT_TIMESTAMP}")
log_lines.append(f"Destination: gs://{DEST_BUCKET_NAME}/{SNAPSHOT_ROOT}/")
log_lines.append(f"Procedures reconciled: {len(recon_df)}")
log_lines.append(f"Copy errors: {len(copy_errors)}")
log_lines.append("")
log_lines.append("=" * 70)
log_lines.append("OVERALL LEVEL")
log_lines.append("=" * 70)
log_lines.append(overall_df.to_string(index=False))
log_lines.append("")
log_lines.append("=" * 70)
log_lines.append(f"SET B -- MISSING PROCEDURES ({len(set_b_df)} procedures)")
log_lines.append("=" * 70)
if set_b_df.empty:
    log_lines.append("(none -- every reconcilable procedure had all expected attachments found)")
else:
    for _, r in set_b_df.iterrows():
        log_lines.append(
            f"Procedure {r['Procedure_id']} -- "
            f"{r['Found']}/{r['Expected active attachments']} found, "
            f"{r['Missing count']} missing: {r['Missing filenames']}"
        )
log_lines.append("")
if copy_errors:
    log_lines.append("=" * 70)
    log_lines.append("COPY ERRORS")
    log_lines.append("=" * 70)
    for procedure_id, doc_name, err in copy_errors:
        log_lines.append(f"Procedure {procedure_id} -- {doc_name}: {err}")

log_content = "\n".join(log_lines)

log_blob_path = f"{SNAPSHOT_ROOT}/diagnostics_log.txt"
dest_bucket.blob(log_blob_path).upload_from_string(log_content, content_type="text/plain")
print(f"\nDiagnostics log written to: gs://{DEST_BUCKET_NAME}/{log_blob_path}")
