            return None
    return None


def get_nested(d, *keys):
    cur = d
    for k in keys:
        if not isinstance(cur, dict):
            return None
        cur = cur.get(k)
    return cur


def strip_html(text):
    if not isinstance(text, str) or not text.strip():
        return ""
    try:
        return BeautifulSoup(text, "html.parser").get_text(separator=" ", strip=True)
    except Exception:
        return re.sub(r"<[^>]+>", " ", text)


def is_populated(v):
    if v is None:
        return False
    if isinstance(v, str):
        return bool(v.strip())
    if isinstance(v, (list, dict)):
        return len(v) > 0
    return True


def load_current_version(table_short_name):
    full_table = f"{DATA_PROJECT}.{DATASET}.{table_short_name}"
    query = f"SELECT policy_core_id, version_num, json_data FROM `{full_table}`"
    df = bq_client.query(query).to_dataframe()
    if len(df) == 0:
        return df
    latest = (df.sort_values("version_num")
              .groupby("policy_core_id", as_index=False)
              .tail(1).copy())
    latest["parsed"] = latest["json_data"].apply(safe_json_loads)
    return latest


