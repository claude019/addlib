        "max_len": int(np.max(lengths)) if lengths else 0,
        "pct_meaningful": round(
            sum(1 for L in lengths if L >= MEANINGFUL_LEN) / len(lengths) * 100, 2
        ) if lengths else 0,
        "html_instances": st["looks_html"],
        "sample_1": st["samples"][0] if len(st["samples"]) > 0 else "",
        "sample_2": st["samples"][1] if len(st["samples"]) > 1 else "",
