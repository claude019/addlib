# ============================================================
# PART 2 -- Discover ALL text fields (recursive JSON walk)
# ============================================================

print("\n\n" + "=" * 80)
print("PART 2 -- Full text field inventory (recursive)")
print("=" * 80)

# path -> accumulated stats
field_stats = defaultdict(lambda: {
    "occurrences": 0,
    "populated": 0,
    "lengths": [],
    "samples": [],
    "countries": set(),
    "types": set(),
    "looks_html": 0,
})


def walk(node, path, country):
    """Recursively walk the JSON, recording every leaf path.
    Lists are collapsed to '[]' so all elements aggregate together."""
    if isinstance(node, dict):
        for k, v in node.items():
            walk(v, f"{path}.{k}" if path else k, country)
    elif isinstance(node, list):
        for item in node:
            walk(item, f"{path}[]", country)
    else:
        st = field_stats[path]
        st["occurrences"] += 1
        st["countries"].add(country)
        st["types"].add(type(node).__name__)

        if node is None:
            return
        if isinstance(node, str):
            if not node.strip():
                return
            if "<" in node and ">" in node:
                st["looks_html"] += 1
            clean = strip_html(node)
            if not clean:
                return
            st["populated"] += 1
            st["lengths"].append(len(clean))
            if len(st["samples"]) < 3:
                st["samples"].append(clean[:180])
        else:
            st["populated"] += 1
            st["lengths"].append(len(str(node)))
            if len(st["samples"]) < 3:
                st["samples"].append(str(node)[:180])


for country, df in loaded.items():
    for _, row in df.iterrows():
        parsed = row["parsed"]
        if isinstance(parsed, dict):
            walk(parsed, "", country)

# --- Build the inventory frame ---
inventory = []
for path, st in field_stats.items():
    lengths = st["lengths"]
    inventory.append({
        "field_path": path,
        "occurrences": st["occurrences"],
        "populated": st["populated"],
        "populated_pct": round(st["populated"] / st["occurrences"] * 100, 2) if st["occurrences"] else 0,
        "countries_present": len(st["countries"]),
        "python_types": ",".join(sorted(st["types"])),
        "median_len": int(np.median(lengths)) if lengths else 0,
        "mean_len": round(float(np.mean(lengths)), 1) if lengths else 0,
        "max_len": int(np.max(lengths)) if lengths else 0,
        "pct_meaningful": round(
            sum(1 for L in lengths if L >= MEANINGFUL_LEN) / len(lengths) * 100, 2
        ) if lengths else 0,
        "html_instances": st["looks_html"],
        "sample_1": st["samples"][0] if len(st["samples"]) > 0 else "",
        "sample_2": st["samples"][1] if len(st["samples"]) > 1 else "",
    })

inv_df = pd.DataFrame(inventory)

# Text fields = string-typed with some real length
inv_df["is_text_field"] = (
    inv_df["python_types"].str.contains("str") &
    (inv_df["median_len"] >= MEANINGFUL_LEN)
)
inv_df["already_in_keeplist"] = inv_df["field_path"].isin(EXISTING_KEEP_LIST)

print(f"\nTotal distinct field paths discovered: {len(inv_df):,}")
print(f"Of which qualify as text fields (str, median >= {MEANINGFUL_LEN} chars): "
      f"{int(inv_df['is_text_field'].sum()):,}")

print("\n[2a] ALL text fields, ranked by usable content "
