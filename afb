#
#   L1. policyRiskTypePrimary                      (policy grain)
#   L2. policyApplication.riskTxnmyL2Text          (policy grain)
#   L3. policyApplication.multiRiskDetls[].risk    (policy grain, list)
#   L4. policyPurpose.sgmntText HTML table         (policy grain, embedded)
