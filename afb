            "multiRiskDetls_risks": sorted(set(multi_risks)),
            "has_multiRiskDetls": len(multi_risks) > 0,
            "policyPurpose_raw": get_nested(parsed, "policyPurpose", "sgmntText"),
        })

        # --- L5: objRel-level risk taxonomy ---
        segments = get_nested(parsed, "policyApplication", "segment")
        segments = segments if isinstance(segments, list) else []
        for s_idx, seg in enumerate(segments):
            if not isinstance(seg, dict):
                continue
            obj_rel = seg.get("objRel")
            if not isinstance(obj_rel, list):
                continue
            for o_idx, obj in enumerate(obj_rel):
                if not isinstance(obj, dict):
