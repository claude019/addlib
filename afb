# ============================================================
# PART 2e -- Per-country availability of the top text fields
# ============================================================

print("\n\n" + "=" * 80)
print("PART 2e -- Are the best text fields available in every market?")
print("=" * 80)

top_paths = text_fields.head(15)["field_path"].tolist()

per_country_field = defaultdict(lambda: defaultdict(lambda: {"occ": 0, "pop": 0, "lens": []}))


def walk_country(node, path, country):
    if isinstance(node, dict):
        for k, v in node.items():
            walk_country(v, f"{path}.{k}" if path else k, country)
    elif isinstance(node, list):
        for item in node:
            walk_country(item, f"{path}[]", country)
    else:
        if path not in top_paths:
            return
        d = per_country_field[country][path]
        d["occ"] += 1
        if isinstance(node, str) and node.strip():
            clean = strip_html(node)
            if clean:
                d["pop"] += 1
                d["lens"].append(len(clean))


for country, df in loaded.items():
    for _, row in df.iterrows():
        parsed = row["parsed"]
        if isinstance(parsed, dict):
            walk_country(parsed, "", country)

avail_rows = []
for country, paths in per_country_field.items():
    for path, d in paths.items():
        avail_rows.append({
            "country": country,
            "field_path": path,
            "populated_pct": round(d["pop"] / d["occ"] * 100, 2) if d["occ"] else 0,
            "median_len": int(np.median(d["lens"])) if d["lens"] else 0,
        })

avail_df = pd.DataFrame(avail_rows)

if len(avail_df):
    print("\nPopulated % by country and field:")
    display(avail_df.pivot_table(
        index="country", columns="field_path", values="populated_pct", fill_value=0
    ))

    print("\nMedian length by country and field:")
    display(avail_df.pivot_table(
        index="country", columns="field_path", values="median_len", fill_value=0
    ))
    print(
        "\nREAD: a field with high global usability but 0% in several markets is not\n"
        "      safe as a primary embedding source -- those markets would produce\n"
        "      empty or degraded vectors."
    )


