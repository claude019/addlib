# Per-table profiler
# ============================================================

def profile_policy_table(country, table_short_name):
    full_table_name = f"{DATA_PROJECT}.{DATASET}.{table_short_name}"
    result = {"country": country, "table_name": table_short_name, "query_status": "OK", "error": None}

    query = f"SELECT * FROM `{full_table_name}`"

    try:
        df_raw = bq_client.query(query).to_dataframe()
    except Exception as error:
        result["query_status"] = "FAILED"
        result["error"] = str(error)
        return result, None, None, None, None

    result["total_rows"] = len(df_raw)
    result["columns"] = list(df_raw.columns)

    required_cols = {"policy_core_id", "version_num", "json_data"}
    if len(df_raw) == 0:
        result["query_status"] = "EMPTY"
        return result, df_raw, None, None, None
    if not required_cols.issubset(set(df_raw.columns)):
        result["query_status"] = "UNEXPECTED_SCHEMA"
        result["error"] = f"Missing expected columns: {required_cols - set(df_raw.columns)}"
        return result, df_raw, None, None, None

    result["distinct_policies"] = df_raw["policy_core_id"].nunique()

    # ---- version profile ----
    version_stats = (
        df_raw.groupby("policy_core_id")["version_num"]
        .agg(version_count="nunique", max_version="max")
        .reset_index()
    )
    result["policies_single_version"] = int((version_stats["version_count"] == 1).sum())
    result["policies_multi_version"] = int((version_stats["version_count"] > 1).sum())
    result["max_version_seen"] = int(version_stats["max_version"].max())
    result["avg_versions_per_policy"] = round(version_stats["version_count"].mean(), 2)

    # ---- current-version-only slice (max version per policy) ----
    df_current = df_raw.merge(
        version_stats[["policy_core_id", "max_version"]], on="policy_core_id"
    )
    df_current = df_current[df_current["version_num"] == df_current["max_version"]].copy()
    result["current_version_rows"] = len(df_current)

    # ---- parse JSON (on current-version rows only, for efficiency) ----
    df_current["json_parsed"] = df_current["json_data"].apply(safe_json_loads)
    result["json_parse_success_pct"] = round(df_current["json_parsed"].notna().mean() * 100, 2)

    # ---- top-level policyText.sgmntText length ----
    def get_policy_text(parsed):
        if isinstance(parsed, dict):
            pt = parsed.get("policyText")
            if isinstance(pt, dict):
                return pt.get("sgmntText")
        return None

    df_current["policyText_sgmntText"] = df_current["json_parsed"].apply(get_policy_text)
    lengths, buckets = classify_text_length(df_current["policyText_sgmntText"])
    df_current["policyText_char_len"] = lengths
    df_current["policyText_len_bucket"] = buckets

    result["policyText_present_pct"] = round((lengths > 0).mean() * 100, 2)
    result["policyText_median_chars"] = int(lengths.median()) if len(lengths) else 0
    result["policyText_bucket_counts"] = buckets.value_counts().to_dict()

    # ---- segment-level extraction (current version only) ----
    all_segment_rows = []
    for _, row in df_current.iterrows():
        all_segment_rows.extend(
            extract_segment_records(row["json_parsed"], row["policy_core_id"], row["version_num"])
        )
    segments_df = pd.DataFrame(all_segment_rows)

    if len(segments_df):
        seg_lengths, seg_buckets = classify_text_length(segments_df["sgmntText"])
        segments_df["sgmntText_char_len"] = seg_lengths
        segments_df["sgmntText_len_bucket"] = seg_buckets

        result["total_segments"] = len(segments_df)
        result["segments_with_text_pct"] = round((seg_lengths > 0).mean() * 100, 2)
        result["segment_text_median_chars"] = int(seg_lengths.median())
        result["segment_text_bucket_counts"] = seg_buckets.value_counts().to_dict()

        result["sgmntTypeCde_prefix_counts"] = (
            segments_df["sgmntTypeCde_prefix"].value_counts(dropna=False).head(10).to_dict()
        )
        result["objRel_plcyObjTypeCde_counts"] = (
            segments_df["plcyObjTypeCde"].value_counts(dropna=False).to_dict()
        )
        result["segments_with_objRel_pct"] = round(segments_df["has_objRel"].mean() * 100, 2)

        rsm_mask = (
            segments_df["sgmntTypeCde"].astype(str).str.startswith("RSM-", na=False)
            | segments_df["plcyObjId"].astype(str).str.startswith("RSM-", na=False)
        )
        cntl_mask = (
            segments_df["sgmntTypeCde"].astype(str).str.startswith("L1C-", na=False)
            | segments_df["cntlId"].astype(str).str.startswith("L1C-", na=False)
        )
        result["segments_with_RSM_id"] = int(rsm_mask.sum())
        result["segments_with_L1C_control_id"] = int(cntl_mask.sum())
        result["policies_with_RSM_linkage"] = segments_df.loc[rsm_mask, "policy_core_id"].nunique()
        result["policies_with_control_linkage"] = segments_df.loc[cntl_mask, "policy_core_id"].nunique()
    else:
        result.update({
            "total_segments": 0, "segments_with_text_pct": None, "segment_text_median_chars": None,
            "segment_text_bucket_counts": {}, "sgmntTypeCde_prefix_counts": {},
            "objRel_plcyObjTypeCde_counts": {}, "segments_with_objRel_pct": None,
            "segments_with_RSM_id": 0, "segments_with_L1C_control_id": 0,
            "policies_with_RSM_linkage": 0, "policies_with_control_linkage": 0,
        })

    policy_segment_summary = build_policy_segment_summary(segments_df)
    if len(policy_segment_summary):
        result["policies_over_80pct_missing_text"] = int(
            policy_segment_summary["missing_text_over_80pct"].sum()
        )
    else:
        result["policies_over_80pct_missing_text"] = 0

    return result, df_raw, df_current, segments_df, policy_segment_summary


