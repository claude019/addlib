# Text length buckets in characters — adjust once you've seen the
# real distribution across tables
TEXT_LEN_BINS = [-1, 0, 100, 500, 2000, np.inf]
TEXT_LEN_LABELS = ["empty", "very_short(<100)", "short(100-500)", "fair(500-2000)", "long(>2000)"]


# ============================================================
# Helpers
# ============================================================

def safe_json_loads(x):
    if x is None:
        return None
    if isinstance(x, dict):
        return x
    if isinstance(x, str):
        try:
            return json.loads(x)
        except Exception:
            return None
    return None


def classify_text_length(series_of_text):
    lengths = series_of_text.fillna("").astype(str).str.len()
    buckets = pd.cut(lengths, bins=TEXT_LEN_BINS, labels=TEXT_LEN_LABELS)
    return lengths, buckets


def extract_segment_records(parsed_json, policy_core_id, version_num):
    """
    One row per segment in policyApplication.segment[]. Captures
    sgmntText/sgmntTitlText/sgmntTypeCde directly on the segment,
    and, where present, the objRel[] entries (cntlId / plcyObjId /
    plcyObjTypeCde) so RSM (regulatory) vs L1 control linkage can
    be identified either way.
    """
    rows = []
    if not isinstance(parsed_json, dict):
        return rows

    policy_app = parsed_json.get("policyApplication")
    if not isinstance(policy_app, dict):
        return rows

    segments = policy_app.get("segment")
    if not isinstance(segments, list):
        return rows

    for seg in segments:
        if not isinstance(seg, dict):
            continue

        sgmnt_text = seg.get("sgmntText")
        sgmnt_type_cde = seg.get("sgmntTypeCde")
        sgmnt_titl_text = seg.get("sgmntTitlText")

        type_prefix = None
        if isinstance(sgmnt_type_cde, str) and "-" in sgmnt_type_cde:
            type_prefix = sgmnt_type_cde.split("-")[0]

        obj_rel = seg.get("objRel")
        obj_rel_entries = obj_rel if isinstance(obj_rel, list) else []

        base = {
            "policy_core_id": policy_core_id,
            "version_num": version_num,
            "sgmntText": sgmnt_text,
            "sgmntTitlText": sgmnt_titl_text,
            "sgmntTypeCde": sgmnt_type_cde,
            "sgmntTypeCde_prefix": type_prefix,
        }

        if obj_rel_entries:
            for obj in obj_rel_entries:
                if not isinstance(obj, dict):
                    continue
                rows.append({
                    **base,
                    "cntlId": obj.get("cntlId"),
                    "plcyObjId": obj.get("plcyObjId"),
                    "plcyObjTypeCde": obj.get("plcyObjTypeCde"),
                    "has_objRel": True,
                })
        else:
            rows.append({
                **base,
                "cntlId": None,
                "plcyObjId": None,
                "plcyObjTypeCde": None,
                "has_objRel": False,
            })
    return rows


def build_policy_segment_summary(segments_df):
    """
    Per (policy_core_id, version_num): total segments, how many
    carry text vs are missing it, and a status flag — mirrors the
    policy_summary view you'd already started building manually.
    """
    if len(segments_df) == 0:
        return pd.DataFrame(columns=[
            "policy_core_id", "version_num", "total_segments",
            "segments_with_text", "segments_missing_text",
            "missing_text_percentage", "missing_text_over_80pct",
            "policy_text_status",
        ])

    seg = segments_df.copy()
    seg["has_text"] = seg["sgmntText"].fillna("").astype(str).str.len() > 0

    grouped = (
        seg.groupby(["policy_core_id", "version_num"])
        .agg(
            total_segments=("has_text", "size"),
            segments_with_text=("has_text", "sum"),
        )
        .reset_index()
    )
    grouped["segments_missing_text"] = grouped["total_segments"] - grouped["segments_with_text"]
    grouped["missing_text_percentage"] = (
        grouped["segments_missing_text"] / grouped["total_segments"] * 100
    ).round(2)
    grouped["missing_text_over_80pct"] = grouped["missing_text_percentage"] > 80

    def status(row):
        if row["total_segments"] == 0:
            return "no_segments"
        if row["segments_missing_text"] == 0:
            return "all_segments_have_text"
        if row["segments_with_text"] == 0:
            return "all_segments_missing_text"
        return "some_segments_missing_text"

    grouped["policy_text_status"] = grouped.apply(status, axis=1)
    return grouped


