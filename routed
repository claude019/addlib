def build_parentage():
    """Build the id-parentage maps used everywhere downstream.

    RSM -> LR comes straight off RegMap Extract3 -- no bridge table needed
    (unlike the control lane, which had to compose RSM -> 1C -> L1C).

    Returns:
      rsm_to_reg  : RSM -> RGL          (from regmap_rsm / Extract2)
      rsm_to_risk : RSM -> [LR, ...]    (from regmap_risk / Extract3)
      risk_to_rsm : LR  -> set(RSM)     (a risk can sit under >1 RSM)
    """
    r = regmap_rsm.copy()
    r["SUM_ID"] = _norm_id(r["SUM_ID"]); r["REG_ID"] = _norm_id(r["REG_ID"])
    rsm_to_reg = dict(zip(r["SUM_ID"], r["REG_ID"]))

    c = regmap_risk                                # already normalised + filtered
    rsm_to_risk = (c.groupby("SUM_ID")["LIB_RISK"]
                    .apply(lambda s: list(dict.fromkeys(s))).to_dict())
    risk_to_rsm = c.groupby("LIB_RISK")["SUM_ID"].apply(set).to_dict()

    return {"rsm_to_reg": rsm_to_reg,
            "rsm_to_risk": rsm_to_risk,
            "risk_to_rsm": risk_to_rsm}


