import re

# ---- 1. rebuild each alert's RSM-cascade candidate pool, cosine-ordered ----
_lk = rwt[rwt["final_decision"].astype(str).str.upper() == "LINKED"]
_pairs = []
for rid, ids in zip(_norm_id(_lk.RECORD_ID), _lk.linked_rsm_ids.fillna("").astype(str)):
    for x in re.split(r"[|,]", ids):
        if x.strip():
            _pairs.append((rid, x.strip().upper()))
rec_rsm = pd.DataFrame(_pairs, columns=["RECORD_ID", "SUM_ID"]).drop_duplicates()
rsm_risk = regmap_risk[["SUM_ID", "LIB_RISK"]].drop_duplicates()
cand_pool = (rec_rsm.merge(rsm_risk, on="SUM_ID")
                    .groupby("RECORD_ID")["LIB_RISK"].apply(lambda s: sorted(set(s))))

risk_pool = sorted(set(helios.LIB_RISK))
risk_text_by_id = dict(zip(helios.LIB_RISK, helios.risk_text))
_al = load_alerts(set(cand_pool.index))
alert_text_by_id = dict(zip(_al.RECORD_ID, _al.alert_text))

risk_vecs = embed_cache(risk_pool, [risk_text_by_id[c] for c in risk_pool], "helios_library_risks")
rpos = {r: i for i, r in enumerate(risk_pool)}
order_by_alert = {}
_dropped_ids = set()
for rid, pool in cand_pool.items():
    # Extract3 (the RSM->LR map) can reference a LIB_RISK that is not in
    # helios -- retired, draft, or simply absent from the published register.
    # Those ids have no embedding, so drop them here rather than crash on
    # the rpos lookup below. This is itself a finding: it means Extract3
    # points the routed lane at risks it can never actually judge.
    _before = len(pool)
    pool = [p for p in pool if p in rpos]
    if len(pool) < _before:
        _dropped_ids.update(set(cand_pool[rid]) - set(pool))
    if rid not in alert_text_by_id or not pool:
        order_by_alert[rid] = []
        continue
    alert_vec = embed_cache([rid], [alert_text_by_id[rid]], "alerts_risk_lane")[0]
    idx = [rpos[p] for p in pool]
    sims = np.asarray(risk_vecs)[idx] @ np.asarray(alert_vec)
    order = np.argsort(-sims)
    order_by_alert[rid] = [pool[j] for j in order]

print(f"[H] order_by_alert built for {len(order_by_alert):,} alerts "
      f"(RSM-cascade pool, not the full 116)")
