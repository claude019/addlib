# [D] PERFORMANCE  -- GOLDEN ENTERS HERE, FOR VALIDATION ONLY
#
# The golden is HAND-PICKED and NON-EXHAUSTIVE (business confirmed). Two
# consequences that define how we are ALLOWED to report:
#   1. A golden risk link is verified truth -> we CAN measure RECALL.
#   2. A predicted link NOT in golden is NOT a false positive -> the golden is
#      incomplete. We report these as DISCOVERIES, never as errors. (=> we do
#      NOT compute precision; it would be meaningless here.)
#
# THREE honest numbers, never the inflated whole-RGL count:
#   A) ADDRESSABLE RECALL = validated / (golden links whose risk text EXISTS in Helios)
#   B) DATA GAP           = golden links whose risk has NO text in Helios (unjudgeable)
#   C) DISCOVERY VOLUME   = predicted links NOT in golden (candidate new links for SME)
# =============================================================================
def risk_scorecard(golden_df, verdicts_df, reachable_risks):
    """Print the three-number honest scorecard + return the per-pair labelled frame."""
    g = golden_df[["RECORD_ID", "LIB_RISK"]].copy()
    g = g[~g.LIB_RISK.isin(_BLANK)]
    g = g.rename(columns={"RECORD_ID": "REC", "LIB_RISK": "RISK"}).drop_duplicates()

    v = verdicts_df.copy()
    v["REC"], v["RISK"] = _norm_id(v.RECORD_ID), _norm_id(v.LIB_RISK)
    v["DEC"] = v.decision.astype(str).str.strip().str.upper()
    rank = {"LINKED": 4, "INSUFFICIENT_EVIDENCE": 3, "NOT_LINKED": 2, "MISSING": 1, "ERROR": 0}
    v["_r"] = v.DEC.map(rank).fillna(-1)
    v = v.sort_values("_r", ascending=False).drop_duplicates(["REC", "RISK"])[["REC", "RISK", "DEC"]]

    g = g[g.REC.isin(set(v.REC))]                  # scope to records we actually ran

    g["reachable"]     = g.RISK.isin(reachable_risks)
    golden_total       = len(g)
    golden_addressable = int(g.reachable.sum())
    data_gap           = golden_total - golden_addressable

    m = g.merge(v, on=["REC", "RISK"], how="left")
    m["gate"] = m.DEC.where(m.DEC.notna(), "NOT_JUDGED").map(
        {"NOT_JUDGED": "NOT_JUDGED", "LINKED": "CAUGHT", "NOT_LINKED": "JUDGED_NOT_LINKED",
         "INSUFFICIENT_EVIDENCE": "JUDGED_INSUFFICIENT", "ERROR": "JUDGED_ERROR",
         "MISSING": "JUDGED_ERROR"}).fillna("NOT_JUDGED")

    addr               = m[m.reachable]            # recall is measured here only
    validated          = int((addr.gate == "CAUGHT").sum())
    addressable_recall = validated / max(golden_addressable, 1)

    golden_keys = set(g.REC + "|" + g.RISK)
    vl = verdicts_df.copy()
    vl["REC"], vl["RISK"] = _norm_id(vl.RECORD_ID), _norm_id(vl.LIB_RISK)
    vl["DEC"] = vl.decision.astype(str).str.upper()
    vl = vl[vl.DEC == "LINKED"]
    discoveries = len(set(vl.REC + "|" + vl.RISK) - golden_keys)

    bar = "=" * 74
    print(bar); print("[D] RISK SCORECARD (golden = hand-picked, non-exhaustive)"); print(bar)
    print(f"  Golden risk links (verified truth)  : {golden_total:,}")
    print(f"    ADDRESSABLE (risk text in Helios) : {golden_addressable:,}   <- recall denominator")
    print(f"    DATA GAP    (no Helios text)      : {data_gap:,}   <- unjudgeable, reported")
    print("-" * 60)
    print("  A) RECALL (on addressable golden):")
    print(f"       VALIDATED (model linked)       : {validated:,}")
    for gate in ["JUDGED_NOT_LINKED", "JUDGED_INSUFFICIENT", "NOT_JUDGED", "JUDGED_ERROR"]:
        c = int((addr.gate == gate).sum())
        if c: print(f"       {gate:22s}: {c:,}")
    print(f"       >>> ADDRESSABLE RECALL = {validated:,}/{golden_addressable:,} "
          f"= {addressable_recall:.1%}")
    print("-" * 60)
    print(f"  B) DATA GAP (carve-out, not model fault) : {data_gap:,} "
          f"({data_gap/max(golden_total,1):.1%} of golden)")
    print("-" * 60)
    print(f"  C) DISCOVERIES (predicted, not in golden): {discoveries:,}")
    print("       -> NOT false positives (golden is non-exhaustive); candidate NEW links")
    print("          for SME review. Audit them via section F slice 'false_positives'.")
    print()
    print("  MANAGEMENT ONE-LINER:")
    print(f"    On the risks we can actually see, the model validates {addressable_recall:.0%} of")
    print(f"    hand-verified links AND surfaces {discoveries:,} new candidate links the manual")
    print(f"    process had not recorded; {data_gap:,} verified links reference risks missing")
    print("    from the Helios master and require a data reconciliation, not model work.")

    # counts dict for [F1]
    globals()["SCORECARD_COUNTS"] = {
        "addressable":       golden_addressable,
        "validated":         validated,
        "judged_not_linked": int((addr.gate == "JUDGED_NOT_LINKED").sum()),
        "insufficient":      int((addr.gate == "JUDGED_INSUFFICIENT").sum()),
        "not_judged":        int((addr.gate == "NOT_JUDGED").sum()),
        "golden_total":      golden_total,
        "data_gap":          data_gap,
    }
    return m


