                 ("Model-Addressable Recall", "RUN SECTION [F] FIRST -- needs `audited`.", None, None)]
    return pd.DataFrame(rows, columns=["Category", "Explanation", "Counts", "Percentage"])


def build_by_risk_routed(cells):
    t = (cells.pivot_table(index="RISK", columns="cell", values="REC",
                           aggfunc="count", fill_value=0).reset_index())
    for col in ["TP", "FN", "FP", "TN"]:
        if col not in t.columns:
            t[col] = 0
    t = t.rename(columns={"TP": "caught", "FN": "missed", "FP": "discoveries",
                          "TN": "judged_not_linked_nongolden"})
    t["golden_pairs"] = t.caught + t.missed
    t["recall"] = np.where(t.golden_pairs > 0, t.caught / t.golden_pairs.replace(0, np.nan), np.nan)
    t = t.merge(helios[["LIB_RISK", "library_risk_title"]],
                left_on="RISK", right_on="LIB_RISK", how="left").drop(columns="LIB_RISK")
    t["retirement_flag"] = t.library_risk_title.fillna("").str.contains(
        "TO BE RETIRED", case=False, na=False)
    return (t.sort_values("missed", ascending=False)
             [["RISK", "library_risk_title", "golden_pairs", "caught", "missed",
               "recall", "discoveries", "retirement_flag"]]
             .reset_index(drop=True))


