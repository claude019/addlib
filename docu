






  # %% [H2] Routed lane — candidate derivation funnel ("how do we get 2,409?")
# -----------------------------------------------------------------------------
# Answers the reviewer comments on Routed_vs_Direct_Comparison_24SEP26.xlsx:
#   (1) "Why does Routed show 18,560 too?"  -> 18,560 is the alert x LR cross-join
#       CEILING shared by both lanes, not the routed lane's pair count.
#   (2) "How is 2,409 derived?"             -> Table A rebuilds it stage by stage
#       from rwt -> Extract3 -> Helios using pure joins (no LLM), then reconciles
#       the rebuilt pair set against the routed verdicts parquet 1:1.
#   (3) "Top-k 40 / 89% — why no reduction?" -> Table B: per-alert candidate pools
#       are already <= 40, so a k=40 cap removes nothing. The 89.3% is the upstream
#       reachability ceiling (Table C), not a top-k effect.
#   (4) "Approach 1 = RSM -> RGL -> all LRs of the RGL?" -> Table D computes that
#       RGL-rollup counterfactual so we can show which one the lane actually does.
#
# Principle kept: the golden builds NOTHING here. It enters only in Table C,
# as validation of what the (already-built) candidate set can reach.
#
# Inputs: module-level globals already loaded by the routed notebook [0]->[C].
# Rename in the INPUTS block if your globals differ. Column names are auto-
# detected from candidate lists; a KeyError prints the real columns.
# -----------------------------------------------------------------------------
import numpy as np
import pandas as pd
from pathlib import Path
from openpyxl import load_workbook
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side

# ---- INPUTS (edit names here only) ------------------------------------------
RWT  = rwt            # results_with_truth, 1 row / record, has linked_rsm_ids
E2   = regmap_rsm     # RegMap Extract2 (RSM -> RGL), used ONLY for Table D
E3   = regmap_risk    # RegMap Extract3 (RSM -> LR parentage)
HEL  = helios         # Helios collapsed to 1 row / published LR with text (116)
GOLD = golden         # golden parquet (validation only — Table C)
VERD = verdicts       # routed verdicts parquet (2,409 rows)
MIN_SCORE = LANE.get("min_score", 5) if "LANE" in globals() else 5

WB_IN  = Path("Routed_vs_Direct_Comparison_24SEP26.xlsx")
WB_OUT = Path("Routed_vs_Direct_Comparison_24SEP26_v2.xlsx")   # never overwrite the original
SHEET  = "Routed_Funnel"
RUN_LABEL = "Routed lane, 24 Sep 2026 fresh run (gpt-5.6-luna, prompt v3)"

# ---- helpers ----------------------------------------------------------------
# Blank IDs arrive as "-", "NONE", "NAN", "NAT" — not nulls. Filter before any
# nunique/join (this is what caused the spurious 51-vs-49 LR scare).
BLANK_TOKENS = {"", "-", "NONE", "NAN", "NAT", "NULL", "<NA>"}

def _nid(s: pd.Series) -> pd.Series:
    """Normalise IDs: str/strip/upper, drop float '.0' tails, blanks -> NaN."""
    out = (s.astype(str).str.strip().str.upper()
             .str.replace(r"\.0$", "", regex=True))
    return out.where(~out.isin(BLANK_TOKENS))

def _col(df: pd.DataFrame, *cands: str) -> str:
    """First matching column, case-insensitive. Fails loudly with the real list."""
    low = {c.lower(): c for c in df.columns}
    for c in cands:
        if c.lower() in low:
            return low[c.lower()]
    raise KeyError(f"None of {cands} found. Columns: {list(df.columns)}")

def _stage(df: pd.DataFrame) -> dict:
    return {
        "rows":    len(df),
        "records": df["_rec"].nunique() if "_rec" in df else np.nan,
        "rsms":    df["_rsm"].nunique() if "_rsm" in df else np.nan,
        "lrs":     df["_lr"].nunique()  if "_lr"  in df else np.nan,
    }

# ---- column detection -------------------------------------------------------
rwt_rec = _col(RWT,  "RECORD_ID", "record_id")
rwt_rsm = _col(RWT,  "linked_rsm_ids")
e3_rsm  = _col(E3,   "SUM_ID", "RSM_ID", "Regulation Summary ID Number", "summary_id")
e3_lr   = _col(E3,   "LIB_RISK", "Library Risk ID Number", "library_risk_id",
                     "Regulation Summary Library Risk ID Number")
e2_rsm  = _col(E2,   "SUM_ID", "RSM_ID", "Regulation Summary ID Number", "summary_id")
e2_rgl  = _col(E2,   "RGL_ID", "REG_ID", "Regulation ID Number", "regulation_id")
hel_lr  = _col(HEL,  "LIB_RISK", "library_risk_id")
g_rec   = _col(GOLD, "RECORD_ID", "record_id")
g_lr    = _col(GOLD, "LIB_RISK", "Regulation Summary Library Risk ID Number", "library_risk_id")
v_rec   = _col(VERD, "RECORD_ID", "record_id")
v_lr    = _col(VERD, "LIB_RISK", "library_risk_id", "risk_id")

# Decision: prefer an explicit label column; fall back to score >= min_score.
try:
    v_dec = _col(VERD, "verdict", "decision", "link_decision", "label")
    v_linked = VERD[v_dec].astype(str).str.upper().eq("LINKED")
except KeyError:
    v_dec = _col(VERD, "relevance_score")
    v_linked = pd.to_numeric(VERD[v_dec], errors="coerce").ge(MIN_SCORE)

# ---- reference sets ---------------------------------------------------------
v = pd.DataFrame({"_rec": _nid(VERD[v_rec]), "_lr": _nid(VERD[v_lr]),
                  "_linked": v_linked.values}).dropna(subset=["_rec", "_lr"])
SCOPE   = set(v["_rec"])                      # the 160 scoped alerts
HEL_IDS = set(_nid(HEL[hel_lr]).dropna())     # 116 published LRs with text

e3 = (pd.DataFrame({"_rsm": _nid(E3[e3_rsm]), "_lr": _nid(E3[e3_lr])})
        .dropna().drop_duplicates())          # Extract3 is RSM x L1C x L2C -> dedupe to RSM-LR
e2 = (pd.DataFrame({"_rsm": _nid(E2[e2_rsm]), "_rgl": _nid(E2[e2_rgl])})
        .dropna().drop_duplicates())

# =============================================================================
# TABLE A — stage-by-stage derivation of the routed candidate set
# =============================================================================
# S0: every rwt record
s0 = pd.DataFrame({"_rec": _nid(RWT[rwt_rec])}).dropna().drop_duplicates()

# S1: explode linked_rsm_ids (pipe/comma separated string, NOT a SUM_ID column)
tmp = pd.DataFrame({"_rec": _nid(RWT[rwt_rec]),
                    "_raw": RWT[rwt_rsm].fillna("").astype(str).str.split(r"[|,]")})
s1 = tmp.explode("_raw")
s1["_rsm"] = _nid(s1["_raw"])
s1 = s1.dropna(subset=["_rec", "_rsm"])[["_rec", "_rsm"]].drop_duplicates()

# S2: keep only linked RSMs that parent at least one LR in Extract3
s2 = s1[s1["_rsm"].isin(e3["_rsm"])]

# S3: expand each (record, RSM) to its child LRs -> (record, RSM, LR) paths
s3 = s2.merge(e3, on="_rsm", how="inner")

# S4: collapse paths to distinct (record, LR) pairs — the LLM judges per PAIR,
#     so an LR reachable via 2 linked RSMs is judged once, not twice
s4 = s3[["_rec", "_lr"]].drop_duplicates()

# S5: drop LRs with no published Helios text (e.g. LR-00000906) — unjudgeable
s5 = s4[s4["_lr"].isin(HEL_IDS)]

# S6: restrict to the scoped alerts (drops record(s) with no alert text)
s6 = s5[s5["_rec"].isin(SCOPE)]

STAGES = [
    ("S0", "Records in rwt",                 "Every record with an Alert→RSM result",                          _stage(s0)),
    ("S1", "Record × linked RSM",            "Split linked_rsm_ids on | or , ; blanks removed",               _stage(s1)),
    ("S2", "…whose RSM has an LR parent",    "Keep RSMs present in Extract3 (RSM→LR parentage)",              _stage(s2)),
    ("S3", "Record × RSM × LR paths",        "Expand each linked RSM to its child Library Risks",             _stage(s3)),
    ("S4", "Distinct record × LR pairs",     "Collapse multiple RSM paths to one pair (judged once)",         _stage(s4)),
    ("S5", "…LR has published Helios text",  "Drop LRs with no text (cannot be judged)",                      _stage(s5)),
    ("S6", "…alert in scope (160)",          "Restrict to scoped alerts = pairs sent to the LLM",             _stage(s6)),
]

# Reconciliation: rebuilt S6 must equal the verdicts' pair set exactly
rebuilt = set(map(tuple, s6[["_rec", "_lr"]].values))
judged  = set(map(tuple, v[["_rec", "_lr"]].values))
only_rebuilt, only_judged = len(rebuilt - judged), len(judged - rebuilt)

# =============================================================================
# TABLE B — per-alert candidate pool size (answers the top-k=40 comment)
# =============================================================================
per_rec = s6.groupby("_rec").size().reindex(sorted(SCOPE), fill_value=0)
BINS   = [(0, 0), (1, 5), (6, 10), (11, 15), (16, 20), (21, 30), (31, 40), (41, 10**9)]
LABELS = ["0", "1–5", "6–10", "11–15", "16–20", "21–30", "31–40", ">40"]
bin_counts = [int(((per_rec >= lo) & (per_rec <= hi)).sum()) for lo, hi in BINS]

# =============================================================================
# TABLE C — golden reachability through the same funnel (validation only)
# =============================================================================
g = (pd.DataFrame({"_rec": _nid(GOLD[g_rec]), "_lr": _nid(GOLD[g_lr])})
       .dropna().drop_duplicates())
g = g[g["_rec"].isin(SCOPE)]                           # expect 1,229
g["_reach"] = [tuple(x) in rebuilt for x in g[["_rec", "_lr"]].values]

# Classify every UNREACHABLE golden pair by the first reason it falls out.
recs_with_rsm  = set(s1["_rec"])
lrs_with_rsm   = set(e3["_lr"])
rec_lr_any_rsm = set(map(tuple, s4[["_rec", "_lr"]].values))   # before Helios filter
def _why(rec, lr):
    if rec not in recs_with_rsm:       return "Alert has no linked RSM at all"
    if lr not in lrs_with_rsm:         return "LR has no RSM parent in Extract3"
    if (rec, lr) in rec_lr_any_rsm:    return "Reachable but LR has no Helios text"
    return "LR's parent RSMs not among this alert's linked RSMs"
unreach = g[~g["_reach"]].copy()
unreach["_why"] = [_why(r, l) for r, l in unreach[["_rec", "_lr"]].values]
WHY_ORDER = ["Alert has no linked RSM at all",
             "LR has no RSM parent in Extract3",
             "Reachable but LR has no Helios text",
             "LR's parent RSMs not among this alert's linked RSMs"]
why_counts = unreach["_why"].value_counts().reindex(WHY_ORDER, fill_value=0)

# Model outcome on the reachable golden pairs
gr = g[g["_reach"]].merge(v, on=["_rec", "_lr"], how="left")
n_valid = int(gr["_linked"].eq(True).sum())
n_jnl   = int(gr["_linked"].eq(False).sum())
n_nover = int(gr["_linked"].isna().sum())
n_disc  = int(v["_linked"].sum()) - n_valid     # linked, not in golden

# =============================================================================
# TABLE D — counterfactual: RSM -> RGL -> ALL RSMs of that RGL -> LRs
# =============================================================================
# The reviewer described approach 1 this way. If the lane really did this it
# would re-create the golden's whole-regulation over-mapping. Compute it, so the
# sheet can show which construction produced 2,409.
alt = (s1.merge(e2, on="_rsm")[["_rec", "_rgl"]].drop_duplicates()
         .merge(e2, on="_rgl")[["_rec", "_rsm"]].drop_duplicates()
         .merge(e3, on="_rsm")[["_rec", "_lr"]].drop_duplicates())
alt = alt[alt["_lr"].isin(HEL_IDS) & alt["_rec"].isin(SCOPE)]
alt_golden_reach = int(pd.Series([tuple(x) in set(map(tuple, alt[["_rec", "_lr"]].values))
                                  for x in g[["_rec", "_lr"]].values]).sum())

# ---- console summary + soft checks against the handoff numbers ---------------
print(f"{'Stage':<4} {'rows':>7} {'recs':>6} {'RSMs':>6} {'LRs':>5}")
for sid, name, _, st in STAGES:
    print(f"{sid:<4} {st['rows']:>7} {st['records']:>6} {st['rsms']:>6} {st['lrs']:>5}  {name}")
print(f"\nReconcile vs verdicts: only_rebuilt={only_rebuilt} only_judged={only_judged}")
print(f"Per-alert pool: min={per_rec.min()} median={per_rec.median():.0f} "
      f"mean={per_rec.mean():.2f} max={per_rec.max()}  alerts>40={int((per_rec>40).sum())}")
print(f"Golden in scope={len(g)} reachable={int(g['_reach'].sum())} "
      f"unreachable={len(unreach)} -> {why_counts.to_dict()}")
print(f"Validated={n_valid} JNL={n_jnl} no-verdict={n_nover} discoveries={n_disc}")
print(f"RGL-rollup counterfactual: {len(alt)} pairs, reaches {alt_golden_reach} golden pairs")
EXPECT = {"S6 pairs": (len(s6), 2409), "golden": (len(g), 1229),
          "reachable": (int(g["_reach"].sum()), 1098), "validated": (n_valid, 259),
          "JNL": (n_jnl, 839), "distinct LRs offered": (s6["_lr"].nunique(), 62)}
for k, (got, exp) in EXPECT.items():
    print(f"  {'✓' if got == exp else '✗ CHECK'} {k}: {got} (handoff {exp})")

# =============================================================================
# WRITE SHEET — blue = run output, black = formula (workbook convention)
# =============================================================================
wb = load_workbook(WB_IN)
if SHEET in wb.sheetnames:
    del wb[SHEET]
ws = wb.create_sheet(SHEET)

F_BASE  = "Arial"
BLUE    = Font(name=F_BASE, color="0000FF")
BLACK   = Font(name=F_BASE, color="000000")
BOLD    = Font(name=F_BASE, bold=True)
TITLE   = Font(name=F_BASE, bold=True, size=13)
HDR     = Font(name=F_BASE, bold=True, color="FFFFFF")
HDRFILL = PatternFill("solid", start_color="404040")
KEYFILL = PatternFill("solid", start_color="FFF2CC")
WRAP    = Alignment(wrap_text=True, vertical="top")
THIN    = Side(style="thin", color="BFBFBF")
BOX     = Border(left=THIN, right=THIN, top=THIN, bottom=THIN)
NUM, PCT, DEC = "#,##0", "0.0%", "0.0"

def hdr(row, labels, col0=1):
    for i, t in enumerate(labels):
        c = ws.cell(row=row, column=col0 + i, value=t)
        c.font, c.fill, c.alignment, c.border = HDR, HDRFILL, WRAP, BOX

def put(row, col, val, font=BLUE, fmt=None, fill=None):
    c = ws.cell(row=row, column=col, value=val)
    c.font, c.border, c.alignment = font, BOX, WRAP
    if fmt:  c.number_format = fmt
    if fill: c.fill = fill
    return c

def section(row, text):
    ws.cell(row=row, column=1, value=text).font = TITLE

ws["A1"] = "Routed lane (Approach 1) — how the candidate set is built"
ws["A1"].font = Font(name=F_BASE, bold=True, size=15)
ws["A2"] = (f"Source: {RUN_LABEL}. Blue = run output, black = calculated in-sheet. "
            "Golden is used only in Table C (validation) — it never builds candidates.")
ws["A2"].font = Font(name=F_BASE, italic=True, color="595959")

# ---- Table 0: the universe (fixes the '18,560 under Routed' confusion) -------
r = 4
section(r, "0. Candidate universe — shared ceiling vs what each lane actually judges"); r += 1
hdr(r, ["Item", "Value", "How"]); r += 1
R_ALERTS = r; put(r, 1, "Alerts in scope", BOLD); put(r, 2, len(SCOPE), fmt=NUM); put(r, 3, "Records in routed verdicts", BLACK); r += 1
R_LRS    = r; put(r, 1, "Published Library Risks with text", BOLD); put(r, 2, len(HEL_IDS), fmt=NUM); put(r, 3, "Helios, 1 row per LR", BLACK); r += 1
R_CROSS  = r; put(r, 1, "Cross-join ceiling (both lanes)", BOLD); put(r, 2, f"=B{R_ALERTS}*B{R_LRS}", BLACK, NUM, KEYFILL)
put(r, 3, "Every alert × every LR. Direct lane judges ALL of these. It is a ceiling, not the routed count.", BLACK); r += 1
R_ROUTED = r; put(r, 1, "Routed pairs sent to LLM", BOLD)   # filled after Table A exists
put(r, 3, "Linked from Table A, stage S6", BLACK); r += 1
R_PRUNE  = r; put(r, 1, "Pruned by routing (never judged)", BOLD); put(r, 2, f"=B{R_CROSS}-B{R_ROUTED}", BLACK, NUM)
put(r, 3, "Pairs with no path alert → linked RSM → LR", BLACK); r += 1
put(r, 1, "Share of ceiling judged", BOLD); put(r, 2, f"=B{R_ROUTED}/B{R_CROSS}", BLACK, PCT); r += 1
put(r, 1, "Avg candidates per alert", BOLD); put(r, 2, f"=B{R_ROUTED}/B{R_ALERTS}", BLACK, DEC); r += 1

# ---- Table A ------------------------------------------------------------------
r += 1
section(r, "A. Derivation of the routed candidate set (pure joins, no LLM)"); r += 1
hdr(r, ["Stage", "Step", "What happens", "Rows", "Alerts", "Distinct RSMs",
        "Distinct LRs", "Change in rows vs previous"]); r += 1
A_FIRST = r
for i, (sid, name, what, st) in enumerate(STAGES):
    put(r, 1, sid, BOLD); put(r, 2, name, BLACK); put(r, 3, what, BLACK)
    put(r, 4, st["rows"], fmt=NUM)
    put(r, 5, None if pd.isna(st["records"]) else int(st["records"]), fmt=NUM)
    put(r, 6, None if pd.isna(st["rsms"]) else int(st["rsms"]), fmt=NUM)
    put(r, 7, None if pd.isna(st["lrs"]) else int(st["lrs"]), fmt=NUM)
    put(r, 8, "—" if i < 2 else f"=D{r}-D{r-1}", BLACK, '#,##0;(#,##0);"-"')
    if sid == "S6":
        for cc in range(1, 9): ws.cell(row=r, column=cc).fill = KEYFILL
    r += 1
A_S3, A_S4, A_S6 = A_FIRST + 3, A_FIRST + 4, A_FIRST + 6
put(R_ROUTED, 2, f"=D{A_S6}", Font(name=F_BASE, color="008000"), NUM, KEYFILL)   # green = link
put(r, 2, "Avg RSM paths per judged pair", BOLD); put(r, 4, f"=D{A_S3}/D{A_S4}", BLACK, "0.00")
put(r, 3, "S3 ÷ S4 — why the SME pack shows '1 of 2' path rows per pair", BLACK); r += 1
put(r, 2, "Rebuilt pairs not in verdicts", BOLD); put(r, 4, only_rebuilt, fmt=NUM); r += 1
put(r, 2, "Verdict pairs not rebuilt", BOLD);     put(r, 4, only_judged, fmt=NUM)
put(r, 3, "Both must be 0: the rebuilt S6 is exactly what the LLM judged", BLACK); r += 1

# ---- Table B ------------------------------------------------------------------
r += 1
section(r, "B. Candidate pool size per alert — why a top-k cap of 40 removes nothing"); r += 1
hdr(r, ["Candidates per alert", "Alerts", "Share"]); r += 1
B_FIRST = r
for lab, n in zip(LABELS, bin_counts):
    put(r, 1, lab, BLACK); put(r, 2, n, fmt=NUM); r += 1
B_LAST = r - 1
for rr in range(B_FIRST, B_LAST + 1):
    put(rr, 3, f"=B{rr}/SUM($B${B_FIRST}:$B${B_LAST})", BLACK, PCT)
put(r, 1, "Total", BOLD); put(r, 2, f"=SUM(B{B_FIRST}:B{B_LAST})", BLACK, NUM); r += 1
for lab, val, fmt in [("Min", int(per_rec.min()), NUM), ("Median", float(per_rec.median()), DEC),
                      ("Mean", float(per_rec.mean()), "0.00"), ("Max", int(per_rec.max()), NUM)]:
    put(r, 1, lab, BOLD); put(r, 2, val, fmt=fmt); r += 1
put(r, 1, "Reading", BOLD)
put(r, 2, ("Top-k ranks candidates WITHIN each alert's pool. When no pool exceeds 40, "
           "k=40 keeps every candidate — the pair count is set by routing (Table A), not by k. "
           "The 89.3% 'highest attainable' is Table C's reachability ceiling."), BLACK)
ws.merge_cells(start_row=r, start_column=2, end_row=r, end_column=8); r += 1

# ---- Table C ------------------------------------------------------------------
r += 1
section(r, "C. Golden reachability through the same funnel (validation only)"); r += 1
hdr(r, ["Item", "Pairs", "Note"]); r += 1
C_TOT = r;  put(r, 1, "Golden pairs, 160 scoped alerts", BOLD); put(r, 2, len(g), fmt=NUM)
put(r, 3, "Record→Regulation→LR; RSM level missing ⇒ structurally over-mapped", BLACK); r += 1
C_REACH = r; put(r, 1, "Reachable via routed candidates", BOLD); put(r, 2, int(g["_reach"].sum()), fmt=NUM); r += 1
C_UN = r;   put(r, 1, "Not reachable (never judged)", BOLD); put(r, 2, f"=B{C_TOT}-B{C_REACH}", BLACK, NUM); r += 1
C_W1 = r
for w in WHY_ORDER:
    put(r, 1, f"   of which: {w}", BLACK); put(r, 2, int(why_counts[w]), fmt=NUM); r += 1
put(r, 1, "   check (must be 0)", BLACK); put(r, 2, f"=B{C_UN}-SUM(B{C_W1}:B{r-1})", BLACK, NUM); r += 1
C_VAL = r;  put(r, 1, "Model LINKED (validated)", BOLD); put(r, 2, n_valid, fmt=NUM); r += 1
put(r, 1, "Model NOT LINKED", BOLD); put(r, 2, n_jnl, fmt=NUM); r += 1
put(r, 1, "Reachable but no verdict returned", BOLD); put(r, 2, n_nover, fmt=NUM); r += 1
put(r, 1, "Upstream ceiling (reachable ÷ golden)", BOLD); put(r, 2, f"=B{C_REACH}/B{C_TOT}", BLACK, PCT, KEYFILL)
put(r, 3, "The '89%' — max recall any judge could hit inside the routed pool", BLACK); r += 1
put(r, 1, "Addressable recall (validated ÷ golden)", BOLD); put(r, 2, f"=B{C_VAL}/B{C_TOT}", BLACK, PCT, KEYFILL)
put(r, 3, "Compare lanes on THIS row only", BLACK); r += 1
put(r, 1, "Recall on judged pairs (validated ÷ reachable)", BOLD); put(r, 2, f"=B{C_VAL}/B{C_REACH}", BLACK, PCT)
put(r, 3, "Different denominator — do not place beside the direct lane's addressable recall", BLACK); r += 1
put(r, 1, "Discoveries (LINKED, not in golden)", BOLD); put(r, 2, n_disc, fmt=NUM)
put(r, 3, "Golden is hand-picked and non-exhaustive ⇒ not false positives; precision/F1 not computed", BLACK); r += 1

# ---- Table D ------------------------------------------------------------------
r += 1
section(r, "D. Which construction is Approach 1? RSM routing vs whole-regulation (RGL) rollup"); r += 1
hdr(r, ["Construction", "Pairs", "Golden pairs reached", "Matches verdicts?"]); r += 1
D_RSM = r
put(r, 1, "Alert → linked RSM → child LRs (Table A)", BLACK); put(r, 2, f"=D{A_S6}", BLACK, NUM)
put(r, 3, f"=B{C_REACH}", BLACK, NUM); put(r, 4, "Yes" if only_rebuilt == only_judged == 0 else "No — investigate", BLACK); r += 1
put(r, 1, "Alert → linked RSM → its RGL → ALL RSMs of RGL → LRs", BLACK); put(r, 2, len(alt), fmt=NUM)
put(r, 3, alt_golden_reach, fmt=NUM)
put(r, 4, "Yes" if set(map(tuple, alt[["_rec", "_lr"]].values)) == judged else "No", BLACK); r += 1
put(r, 1, "Reading", BOLD)
put(r, 2, ("The RGL rollup would reproduce the golden's whole-regulation sweep: more pairs and "
           "more golden 'reach', but only because it copies the over-mapping. Routing stays at the "
           "RSM the alert was actually linked to."), BLACK)
ws.merge_cells(start_row=r, start_column=2, end_row=r, end_column=8)

for col, w in zip("ABCDEFGH", [44, 30, 62, 12, 10, 14, 12, 16]):
    ws.column_dimensions[col].width = w
ws.freeze_panes = "A4"
wb.save(WB_OUT)
print(f"\nWrote sheet '{SHEET}' -> {WB_OUT.resolve()}")
