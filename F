# %% ========================================================================
# [F] LLM-AS-JUDGE AUDIT LAYER (the MRM story)
# A second LLM pass that AUDITS the linkage verdicts and classifies WHY a link
# did / didn't happen. Two levels: top category (is it our fault, or a
# data/label/SME limitation?) and a specific sub_reason within it.
# ============================================================================

AUDIT_BUCKETS = ["TRUE_LINK_MISSED", "CORRECT_REJECTION", "SME_JUDGEMENT_REQUIRED",
                  "STRUCTURAL_OVERMAPPING", "TEXT_TOO_THIN"]

# Rewritten for library RISK. The control-lane sub-reasons were procedure-shaped
# and would force risk misses into the wrong boxes. Replace again after the first
# FN audit with what actually appears.
SUB_REASONS = {
    "TRUE_LINK_MISSED": [
        "MISS_paraphrase",           # same risk, regulatory vs risk-register wording
        "MISS_indirect_chain",       # alert -> obligation -> risk needs a 2-step inference
        "MISS_terminology_gap",      # regulatory language vs ORX/Basel taxonomy language
        "MISS_thin_risk_statement",  # LR text too terse to surface an obvious link
        "MISS_conservative_judge",   # model too strict on a borderline-but-real link
    ],
    "CORRECT_REJECTION": [
        "CR_different_risk_type",       # credit-risk LR vs a conduct/disclosure alert
        "CR_different_taxonomy_branch", # unrelated ORX / Basel L1 branch entirely
        "CR_different_business_line",   # LR scoped to a business the alert doesn't touch
        "CR_different_legal_entity",    # LR scoped to an entity outside the alert's scope
        "CR_no_shared_obligation",      # no overlapping obligation or activity
    ],
    "SME_JUDGEMENT_REQUIRED": [
        "SME_external_mapping",   # relies on an internal HSBC convention not in text
        "SME_implied_by_policy",  # a risk-appetite / policy interpretation call
        "SME_cross_reference",    # depends on a citation not resolved in the text
        "SME_domain_expertise",   # needs specialist knowledge to see the connection
    ],
    "STRUCTURAL_OVERMAPPING": [
        "OVER_whole_rgl_swept",         # mapped only because it sits under a linked RGL
        "OVER_broad_regulation",        # RGL very broad; its risks span unrelated areas
        "OVER_missing_rsm_granularity", # no RSM level in golden -> whole RGL inherited
        "OVER_generic_risk",            # broad principal-risk statement, not alert-specific
    ],
    "TEXT_TOO_THIN": [
        "THIN_risk_text",   # LR title + description too sparse to judge
        "THIN_alert_text",  # alert text too sparse to judge
    ],
}
ALL_SUB_REASONS = [s for subs in SUB_REASONS.values() for s in subs]

AUDIT_SYSTEM_PROMPT = f"""ROLE:
You are an independent Regulatory Model Auditor. A linkage model judged whether an
incoming ALERT bears on a specific LIBRARY RISK -- a short, standing statement of a
risk the bank runs. You are given the alert text, the risk text, whether the business
golden SAYS they are linked, and the model's decision + reasoning. Do NOT re-judge the
link. Explain, for management, WHY the model's decision differs from (or matches) the
golden, by choosing (1) a top category and (2) a specific sub-reason within it.

CONTEXT YOU MUST HOLD:
- Library risk text is terse BY DESIGN. It will never cite the regulation. Shortness
  alone is not a defect -- only classify TEXT_TOO_THIN when the statement carries no
  taxonomy, business or descriptive content at all.
- The golden has no RSM level, so every risk under a linked regulation was inherited
  as 'golden-true', including risks the specific alert does not touch. That is
  STRUCTURAL_OVERMAPPING, a data/label artefact, not a model error.

TOP CATEGORIES:
- TRUE_LINK_MISSED: the texts DO contain a clear, derivable link and the model wrongly
  failed to link them. Our model's fault.
- CORRECT_REJECTION: genuinely different risk type, taxonomy branch, business line or
  legal entity; no text-derivable link. Model right; golden link questionable.
- SME_JUDGEMENT_REQUIRED: a link may exist at policy level but is NOT derivable from
  the supplied texts; needs expert/institutional knowledge outside the documents.
- STRUCTURAL_OVERMAPPING: the risk is clearly unrelated, and the golden link exists only
  because the risk sits under a regulation the alert touches (whole-regulation mapping).
- TEXT_TOO_THIN: risk or alert text too sparse/generic to judge either way.

SUB-REASONS (choose exactly one, and it MUST belong to the chosen top category):
{json.dumps(SUB_REASONS, indent=2)}

RETURN ONLY JSON (no markdown):
{{"audit_category": "one of the top categories",
  "sub_reason": "one sub-reason from the chosen category",
  "one_line_explanation": "one plain sentence a non-technical leader understands",
  "is_model_fault": true or false}}"""

AUDIT_SCHEMA = {
    "type": "json_schema",
    "json_schema": {"name": "linkage_audit", "strict": True, "schema": {
        "type": "object", "additionalProperties": False,
        "required": ["audit_category", "sub_reason", "one_line_explanation", "is_model_fault"],
        "properties": {
            "audit_category":       {"type": "string", "enum": AUDIT_BUCKETS},
            "sub_reason":           {"type": "string", "enum": ALL_SUB_REASONS},
            "one_line_explanation": {"type": "string"},
            "is_model_fault":       {"type": "boolean"}}}}
}


async def _audit_one(alert_text, risk_text, golden_says_linked, model_decision, model_reasoning):
    payload = {"alert_text": alert_text, "risk_text": risk_text,
               "golden_says_linked": bool(golden_says_linked),
               "model_decision": model_decision, "model_reasoning": model_reasoning}
    messages = [{"role": "system", "content": AUDIT_SYSTEM_PROMPT},
                {"role": "user",   "content": json.dumps(payload, ensure_ascii=False)}]
    kw = {"model": MODEL, "user": USE_CASE, "response_format": AUDIT_SCHEMA}
    if "gemini" in MODEL.lower():
        kw.update(temperature=0.0, seed=42, reasoning_effort="low", max_tokens=1200)
    else:
        kw.update(reasoning_effort="low", max_completion_tokens=1200)
    for attempt in range(1, 4):
        try:
            token = await tok.get()
            r = await oai.chat.completions.create(
                messages=messages, extra_headers={"Authorization": f"Bearer {token}"}, **kw)
            AUDIT_USAGE_LOG.append({"in": r.usage.prompt_tokens,
                                     "out": r.usage.completion_tokens, "ts": time.time()})
            return json.loads(r.choices[0].message.content)
        except Exception as e:
            if "401" in str(e): await tok.invalidate()
            await asyncio.sleep(1.5 ** attempt)
    return {"audit_category": "TEXT_TOO_THIN", "sub_reason": "THIN_risk_text",
            "one_line_explanation": "audit failed", "is_model_fault": False}


def select_audit_slice(perf_df, verdicts_df, which="false_negatives", sample=500, seed=42):
    """which : "all" | "false_negatives" | "false_positives" | "correct"
       sample: an int (random sample of that size) or None (whole slice)"""
    v = verdicts_df.copy()
    v["REC"], v["RISK"] = _norm_id(v.RECORD_ID), _norm_id(v.LIB_RISK)
    v["DEC"] = v.decision.astype(str).str.upper()
    gsub = golden[~golden.LIB_RISK.isin(_BLANK)]
    golden_pairs = set(gsub.RECORD_ID + "|" + gsub.LIB_RISK)
    v["key"] = v.REC + "|" + v.RISK
    v["golden_linked"] = v.key.isin(golden_pairs)

    if   which == "false_negatives": sel = v[(v.golden_linked)  & (v.DEC != "LINKED")]
    elif which == "false_positives": sel = v[(~v.golden_linked) & (v.DEC == "LINKED")]
    elif which == "correct":         sel = v[(v.golden_linked)  & (v.DEC == "LINKED")]
    else:                            sel = v[v.golden_linked]

    sel = sel[["REC", "RISK", "decision", "reasoning", "golden_linked"]].reset_index(drop=True)
    if sample is not None and len(sel) > sample:
        sel = sel.sample(n=sample, random_state=seed).reset_index(drop=True)
        print(f"[F] sampled {sample:,} of the slice for a fast, defensible estimate "
              f"(set sample=None for the full slice).")
    return sel


async def run_audit(slice_df, alert_text_by_id, risk_text_by_id, concurrency=20):
    sem  = asyncio.Semaphore(concurrency)
    rows = slice_df.reset_index(drop=True)

    async def _one(i, row):
        async with sem:
            res = await _audit_one(alert_text_by_id.get(row.REC, ""),
                                    risk_text_by_id.get(row.RISK, ""),
                                    row.golden_linked, row.decision, row.reasoning)
            return i, res

    tasks = [asyncio.create_task(_one(i, r)) for i, r in rows.iterrows()]
    results = {}
    for fut in tqdm(asyncio.as_completed(tasks), total=len(tasks), desc="audit"):
        i, res = await fut; results[i] = res
    audit = pd.DataFrame([results[i] for i in range(len(rows))])
    return pd.concat([rows, audit], axis=1)


def audit_report(audited_df):
    bar = "=" * 74
    total = len(audited_df)
    print(bar); print(f"[F] AUDIT DRILL-DOWN  (n={total:,})"); print(bar)
    top = audited_df.audit_category.value_counts()
    for cat in AUDIT_BUCKETS:
        c = int(top.get(cat, 0))
        if not c: continue
        print(f"\n  {cat} : {c:,}  ({c/total:.1%})")
        sub = audited_df[audited_df.audit_category == cat].sub_reason.value_counts()
        for reason in SUB_REASONS[cat]:
            sc = int(sub.get(reason, 0))
            if sc: print(f"      - {reason:30s}: {sc:5,}  ({sc/c:.1%} of {cat.lower()})")
    fault = int(audited_df.is_model_fault.sum())
    print("\n" + "-" * 60)
    print(f"  MODEL'S FAULT (fixable by us) : {fault:,}  ({fault/max(total,1):.1%})")
    print(f"  DATA / LABEL / SME limitation : {total-fault:,}  ({(total-fault)/max(total,1):.1%})")
    return top


async def summarise_miss_pattern(audited_df, max_examples=25):
    tlm = audited_df[audited_df.audit_category == "TRUE_LINK_MISSED"]
    if not len(tlm):
        return "No TRUE_LINK_MISSED cases in this slice."
    examples = tlm.head(max_examples)[["sub_reason", "one_line_explanation"]].to_dict("records")
    messages = [{"role": "system", "content":
                   "You are a prompt engineer. Below are cases where a linkage model MISSED a real "
                   "alert->library-risk link. Identify the 1-2 dominant patterns and the single "
                   "highest-impact change to the linkage prompt that would fix most of them. "
                   "4 sentences max, plain language for a non-technical reader."},
                {"role": "user", "content": json.dumps(examples, ensure_ascii=False)}]
    kw = {"model": MODEL, "user": USE_CASE}
    if "gemini" in MODEL.lower(): kw.update(temperature=0.0, max_tokens=500)
    else:                         kw.update(max_completion_tokens=500)
    try:
        token = await tok.get()
        r = await oai.chat.completions.create(
            messages=messages, extra_headers={"Authorization": f"Bearer {token}"}, **kw)
        return r.choices[0].message.content.strip()
    except Exception as e:
        return f"(pattern digest unavailable: {e})"


