def _read_parquet(path, columns=None) -> pd.DataFrame:
    try:
        return pd.read_parquet(path, columns=columns)
    except TypeError as e:
        if "not understood" not in str(e):
            raise
    try:
        import db_dtypes  # noqa: F401
        return pd.read_parquet(path, columns=columns)
    except (ImportError, TypeError):
        pass
    import pyarrow.parquet as pq
    df = pq.read_table(path, columns=columns).to_pandas(ignore_metadata=True)
    return df.drop(columns=[c for c in df.columns if str(c).startswith("__index_level_")])


def _read_any(path: Path, usecols=None) -> pd.DataFrame:
    suffix = Path(path).suffix.lower()
    if suffix == ".parquet":
        df = _read_parquet(path, columns=usecols)
    elif suffix in (".xlsx", ".xls"):
        df = pd.read_excel(path)
        if usecols:
            df = df[[c for c in usecols if c in df.columns]]
    else:
        df = pd.read_csv(path)
    df.columns = [str(c).strip() for c in df.columns]
    return df


def _norm_id(series) -> pd.Series:
    return (pd.Series(series).astype(str).str.strip().str.upper()
              .str.replace(r"\.0+$", "", regex=True))


def _nid(x) -> str:
    return re.sub(r"\.0+$", "", str(x).strip().upper())


def _as_text(v) -> str:
    if isinstance(v, (list, tuple, np.ndarray)):
        return "; ".join(t for t in (_as_text(x) for x in v) if t)
    try:
        if pd.isna(v):
            return ""
    except (TypeError, ValueError):
        pass
    return str(v)


def _as_bool(v) -> bool:
    if isinstance(v, (bool, np.bool_)):
        return bool(v)
    return str(v).strip().upper() in {"TRUE", "1", "YES", "Y"}


def _clean_field(v) -> str:
    s = html.unescape(html.unescape(_as_text(v)))
    s = re.sub(r"<[^>]+>", " ", s)
    return re.sub(r"\s+", " ", s).strip()


def _truncate(s: str, n: int = None) -> str:
    n = n or POLICY_TEXT_MAX_CHARS
    if len(s) <= n:
        return s
    return s[:n].rsplit(" ", 1)[0] + " [... policy text truncated]"


def load_policies():
    """One row per policy with a judgeable `policy_text`, from
    GPPS_Policy_Text_Data_Prep_Master.xlsx. POLICY_ID = global_policy_key
    (Country + "_" + policy_core_id) -- the only field guaranteed unique
    across the multi-country pool. Kept rows are POL_STATUS == 'PUBL'
    (always true here; the data-prep already filtered to PUBL-only, no
    fallback)."""
    raw = _read_any(POLICY_FILE)
    raw["global_policy_key"]      = raw["Country"].astype(str) + "_" + raw["policy_core_id"].astype(str)
    raw["used_fallback_non_publ"] = False
    raw["policyDocType"]          = ""
    raw = raw.rename(columns=POLICY_RENAME)
    missing = [c for c in POLICY_RENAME.values() if c not in raw.columns]
    if missing:
        raise KeyError(f"policy extract missing {missing}; columns are {list(raw.columns)}")

    raw["POLICY_ID"]    = _norm_id(raw["POLICY_ID"])
    raw["POL_CORE_ID"]  = _norm_id(raw["POL_CORE_ID"])
    raw = raw[~raw.POLICY_ID.isin(_BLANK)].copy()
    raw["POL_COUNTRY"]  = raw["POL_COUNTRY"].map(_clean_field)
    raw["POL_STATUS"]   = raw["POL_STATUS"].astype(str).str.strip().str.upper()
    raw["VERSION_NUM"]  = pd.to_numeric(raw["VERSION_NUM"], errors="coerce")
    raw["PUBL_DATE"]    = pd.to_datetime(raw["PUBL_DATE"], errors="coerce")
    raw["POL_FALLBACK"] = raw["POL_FALLBACK"].map(_as_bool)
    ids_any_status = set(raw.POLICY_ID)

    if POLICY_COUNTRY_FILTER:
        before = len(raw)
        raw = raw[raw.POL_COUNTRY.str.upper().isin(
            {c.upper() for c in POLICY_COUNTRY_FILTER})].copy()
        print(f"[A] policy extract: POLICY_COUNTRY_FILTER kept {len(raw):,} of {before:,} rows")

    eligible = raw[raw.POL_STATUS.eq(PUBLISHED_CODE) | raw.POL_FALLBACK].copy()
    dup_rows = int(eligible.POLICY_ID.duplicated().sum())
    eligible["_len"] = eligible["POL_TEXT"].map(lambda v: len(_as_text(v)))
    pol = (eligible.sort_values(["VERSION_NUM", "PUBL_DATE", "_len"],
                               ascending=False, na_position="last")
                   .drop_duplicates("POLICY_ID").drop(columns="_len").copy())

    for c in POLICY_TEXT_COLS:
        pol[c] = pol[c].map(_clean_field)

    pol["body_chars"]     = pol["POL_TEXT"].str.len()
    pol["text_truncated"] = pol["body_chars"] > POLICY_TEXT_MAX_CHARS

    pieces = []
    for col, label in POLICY_TEXT_FIELDS:
        vals = pol[col].map(_truncate) if col == "POL_TEXT" else pol[col]
        pieces.append(f"{label}:- " + vals)
    pol["policy_text"] = pieces[0]
    for piece in pieces[1:]:
        pol["policy_text"] = pol["policy_text"] + "\n\n" + piece
    pol["policy_text"] = pol["policy_text"].map(clean)

    print(f"[A] policy extract: rows={len(raw):,}  eligible ({PUBLISHED_CODE}) rows="
          f"{len(eligible):,}  duplicates collapsed={dup_rows:,}  -> policies={len(pol):,}  "
          f"(ids any status={len(ids_any_status):,})")

    keep = ["POLICY_ID", "POL_CORE_ID", "POL_COUNTRY", "POL_TITLE", "POL_RISK_TYPE",
            "POL_TAX_L2", "POL_REGION", "POL_DOC_TYPE", "VERSION_NUM", "PUBL_DATE",
            "POL_FALLBACK", "body_chars", "text_truncated", "policy_text"]
    return pol[keep].reset_index(drop=True), ids_any_status


def load_golden() -> pd.DataFrame:
    """Golden record -> REGULATION, hand-curated. SCOPE ONLY: tells you which
    alerts have a known regulatory link worth running (SCOPE_MODE="golden").
    No routed-lane chain, no record->POLICY derivation, no recall scoring --
    there is nothing downstream that reads REG_ID for any other purpose."""
    g = _read_any(GOLDEN_FILE).rename(columns={
        "Record ID":     "RECORD_ID",
        "Regulation ID": "REG_ID",
    })
    for c in ["RECORD_ID", "REG_ID"]:
        if c not in g.columns:
            raise KeyError(f"golden missing {c}. Columns: {list(g.columns)}")
        g[c] = _norm_id(g[c])
    return g[~g.RECORD_ID.isin(_BLANK) & ~g.REG_ID.isin(_BLANK)].reset_index(drop=True)


def load_alerts(record_ids) -> pd.DataFrame:
    """Build one cleaned alert text per record, restricted to the records we run."""
    df = _read_parquet(RAPID2_FILE)

    for col in ["TITLE", "SUMM_CONTENT", "SUMM_UPDATE",
                "RECORD_JURISDICTION_CODE", "RECORD_JURISDICTION_NAME", "REGULATOR_CODE"]:
        if col in df.columns:
            df[col] = df[col].fillna("").map(clean)
        else:
            df[col] = ""

    content_equals_update = df["SUMM_CONTENT"] == df["SUMM_UPDATE"]
    df["alert_text"] = np.where(
        content_equals_update,
        (df.TITLE + "\n\n" + df.SUMM_CONTENT).str.strip(),
        ("Title:- "                   + df.TITLE
         + "\n\nContent:- "           + df.SUMM_CONTENT
         + "\n\nUpdate:- "            + df.SUMM_UPDATE
         + "\n\nJurisdiction Code:- " + df.RECORD_JURISDICTION_CODE
         + "\n\nJurisdiction Name:- " + df.RECORD_JURISDICTION_NAME
         + "\n\nRegulator Code:- "    + df.REGULATOR_CODE).str.strip())

    df["RECORD_ID"] = _norm_id(df["RECORD_ID"])
    df = df[df.RECORD_ID.isin(record_ids) & (df.alert_text.str.len() > 0)]
    return df[["RECORD_ID", "alert_text"]].drop_duplicates("RECORD_ID").reset_index(drop=True)


