    "AMBIGUOUS": ["INSUFFICIENT_INFORMATION"],
}
ALL_SUB_REASONS = [s for subs in SUB_REASONS.values() for s in subs]

AUDIT_SYSTEM_PROMPT = f"""ROLE:
You are an independent model-risk reviewer. A linkage model judged whether a
regulatory alert bears on an internal POLICY, from the alert and policy text
alone. You have NO access to any external ground truth. Independently
re-read both texts and decide whether you AGREE or DISAGREE with the
model's decision, and why.

Return exactly one bucket and one sub-reason.

BUCKETS: {", ".join(AUDIT_BUCKETS)}
SUB_REASONS: {json.dumps(SUB_REASONS)}

GUIDANCE:
- Judge only on the supplied texts. If the link needs knowledge that is in
  neither text, that is IMPLICIT_DOMAIN_KNOWLEDGE or SME_JUDGEMENT-flavoured
  (use TEXT_INSUFFICIENT).
- Policy text may be truncated; if the decisive clause is plainly missing,
  say TRUNCATED_POLICY_BODY.
- "Disagree" means your independent reading differs from the model's -- it
  does not mean the model is provably wrong, since neither of you has
  external ground truth here.
Return JSON only."""

AUDIT_SCHEMA = {
    "type": "json_schema",
    "json_schema": {
        "name": "audit_verdict", "strict": True,
        "schema": {
            "type": "object", "additionalProperties": False,
            "required": ["audit_category", "sub_reason", "explanation"],
            "properties": {
                "audit_category": {"type": "string", "enum": AUDIT_BUCKETS},
                "sub_reason":     {"type": "string", "enum": ALL_SUB_REASONS},
                "explanation":    {"type": ["string", "null"]},
            }}}
}

AUDIT_SLICE      = "ambiguous_middle"   # "ambiguous_middle" | "all_linked" | "sample"
AUDIT_SCORE_BAND = (40, 70)             # confirm against your prompt's actual score scale
AUDIT_SAMPLE     = None                 # an int to cap any slice, or None for all


def _audit_call_kwargs():
    kw = {"model": MODEL, "user": USE_CASE, "response_format": AUDIT_SCHEMA}
    if "gemini" in MODEL.lower():
        kw.update(temperature=0.0, seed=42, reasoning_effort="low", max_tokens=4000)
    else:
        kw.update(reasoning_effort="low", max_completion_tokens=4000)
    return kw


async def _audit_one(alert_text, policy_text, model_decision, model_reasoning,
                     model_score, rid=None, pid=None):
    payload = {"alert_text": alert_text, "policy_text": policy_text,
               "model_decision": model_decision, "model_reasoning": model_reasoning,
               "model_relevance_score": model_score}
    messages = [{"role": "system", "content": AUDIT_SYSTEM_PROMPT},
                {"role": "user",   "content": json.dumps(payload, ensure_ascii=False)}]
    last = None
    for attempt in range(1, 3 + 1):
        try:
            parsed, _ = await chat_with_cost(
                "audit", messages, _audit_call_kwargs(),
                parse=lambda r: json.loads(r.choices[0].message.content),
                record_id=rid, unit=f"audit:{rid}|{pid}", attempt=attempt, n_items=1)
            return parsed
        except Exception as e:
            last = e
            if "401" in str(e) or "unauth" in str(e).lower():
                try:
                    await tok.invalidate()
                except Exception:
                    pass
            await asyncio.sleep(1.5 ** attempt)
    return {"audit_category": "AMBIGUOUS", "sub_reason": "INSUFFICIENT_INFORMATION",
            "explanation": f"audit failed: {last}"}


def select_audit_slice(verdicts_df, which=AUDIT_SLICE, sample=AUDIT_SAMPLE,
                       score_band=AUDIT_SCORE_BAND, seed=42):
    v = _best_verdicts(verdicts_df)
    if which == "ambiguous_middle":
        lo, hi = score_band
        sl = v[(v.DEC == "INSUFFICIENT_EVIDENCE") |
               (v.DEC.isin(["LINKED", "NOT_LINKED"]) & v._s.between(lo, hi))].copy()
    elif which == "all_linked":
        sl = v[v.DEC == "LINKED"].copy()
    elif which == "sample":
        sl = v.copy()
    else:
        raise ValueError("AUDIT_SLICE must be 'ambiguous_middle', 'all_linked', or 'sample'")

    if sample and len(sl) > sample:
        sl = sl.sample(sample, random_state=seed)
    print(f"[F] audit slice '{which}': {len(sl):,} pairs")
    return sl.reset_index(drop=True)


async def run_audit(slice_df, alert_text_by_id, policy_text_by_id, concurrency=20):
    sem = asyncio.Semaphore(concurrency)

    async def _one(row):
        async with sem:
            out = await _audit_one(alert_text_by_id.get(row.REC, ""),
                                   policy_text_by_id.get(row.POL, ""),
                                   row.DEC, getattr(row, "reasoning", None), row._s,
                                   rid=row.REC, pid=row.POL)
            return {"REC": row.REC, "POL": row.POL, "model_decision": row.DEC,
                    "model_relevance_score": row._s, **out}

    tasks = [asyncio.create_task(_one(r)) for r in slice_df.itertuples()]
    out = []
    for fut in tqdm(asyncio.as_completed(tasks), total=len(tasks), desc="audit"):
        out.append(await fut)
    write_team_cost_file()
    return pd.DataFrame(out)


def audit_report(audited_df):
    if not len(audited_df):
        print("[F] nothing audited."); return None
    bar = "=" * 70
    print(bar); print("[F] INDEPENDENT AUDIT -- SECOND OPINION"); print(bar)
    cat = audited_df.audit_category.value_counts()
    for k, c in cat.items():
        print(f"  {k:26s}: {c:,}  ({c/len(audited_df):.1%})")
    agree_rate = (audited_df.audit_category == "AGREE_WITH_MODEL").mean()
    print(f"\n  agreement rate with primary judge: {agree_rate:.1%}")
    print("-" * 60)
    print(audited_df.sub_reason.value_counts().to_string())
    return cat


