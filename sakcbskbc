def _norm_id(series):
    return pd.Series(series).astype(str).str.strip().str.upper()

# CAVEAT: the original pipeline cleans text with a `clean_text` function
# defined somewhere upstream (only its alias `clean = clean_text` was ever
# seen in this conversation, never its implementation). SUMM_CONTENT/
# SUMM_UPDATE are known to carry raw HTML, so a basic tag-stripper stands in
# here -- good enough to read, not guaranteed byte-identical to what the
# model actually saw.
def _clean_fallback(s):
    s = str(s) if s is not None else ""
    s = re.sub(r"<[^>]+>", " ", s)
    s = re.sub(r"\s+", " ", s).strip()
    return s

def _find(directory, stem):
    hits = [p for p in directory.iterdir()
            if p.suffix.lower() in (".parquet", ".xlsx", ".xls", ".csv")
            and stem.lower() in p.name.lower()]
    if not hits:
        raise FileNotFoundError(f"no file matching '{stem}' in {directory}")
    return sorted(hits)[0]

def _read_any(path, usecols=None):
    suffix = path.suffix.lower()
    if suffix == ".parquet":
        df = pd.read_parquet(path, columns=usecols)
    elif suffix in (".xlsx", ".xls"):
        df = pd.read_excel(path)
        if usecols:
            df = df[[c for c in usecols if c in df.columns]]
    else:
        df = pd.read_csv(path)
    df.columns = [str(c).strip() for c in df.columns]
    return df


