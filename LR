    unm[[C_ALERT_L1, C_ALERT_L2, C_ALERT_L3, "n_alert_rows", "fails_at", "suggest"]].to_excel(xw, sheet_name="Unmatched_Review", index=False)
    amb[[C_ALERT_L1, C_ALERT_L2, C_ALERT_L3, "tier", "n_cand", "cand_lrs", "n_alert_rows"]].to_excel(xw, sheet_name="Ambiguous", index=False)
    alert_level.to_excel(xw, sheet_name="Alert_Level", index=False)
    checks.to_excel(xw, sheet_name="Source_Checks", index=False)

wb = load_workbook(XLSX)
ARIAL, BOLD = Font(name="Arial"), Font(name="Arial", bold=True)
HDR_FILL = PatternFill("solid", start_color="404040")
for ws in wb.worksheets:
    for row in ws.iter_rows():
        for c in row:
            c.font = ARIAL
    for c in ws[1]:
        c.font = Font(name="Arial", bold=True, color="FFFFFF")
        c.fill = HDR_FILL
        c.alignment = Alignment(wrap_text=True, vertical="top")
    for col in ws.columns:
        w = max((len(str(c.value)) for c in col[:200] if c.value is not None), default=8)
        ws.column_dimensions[col[0].column_letter].width = min(max(w + 2, 10), 60)
    ws.freeze_panes = "A2"

ws = wb.create_sheet("Summary", 0)
BLUE = Font(name="Arial", color="0000FF")
BLK = Font(name="Arial", color="000000")
rows = {}
r = 1
ws.cell(r, 1, "Alert -> Helios Library Risk: taxonomy lookup test").font = Font(name="Arial", bold=True, size=14)
r += 1
ws.cell(r, 1, "Blue = run output, black = formula. Golden is non-exhaustive: a miss is not an error.").font = Font(name="Arial", italic=True, color="595959")
r += 2

def put(label, val, key=None, fmt="#,##0", formula=False):
    global r
    ws.cell(r, 1, label).font = BLK
    c = ws.cell(r, 2, val)
    c.font = BLK if formula else BLUE
    c.number_format = fmt
    if key:
        rows[key] = r
    r += 1

def head(t):
    global r
    r += 1
    ws.cell(r, 1, t).font = BOLD
    r += 1

head("Match funnel (alert rows)")
put("Alert rows", len(al), "rows")
put("Distinct records", int(al["_id"].nunique()))
put("Distinct taxonomy combos", len(combos))
for t in tier_order:
    put(f"  {t}", int(funnel.loc[t, "alert_rows"]), t)
put("Strict matched (EXACT + RELAXED)", f"=B{rows['EXACT']}+B{rows['RELAXED']}", "strict", formula=True)
put("Strict match rate", f"=B{rows['strict']}/B{rows['rows']}", fmt="0.0%", formula=True)
put("All assigned (strict + L2L3_ONLY + PREFIX)",
    f"=B{rows['strict']}+B{rows['L2L3_ONLY']}+B{rows['PREFIX']}", "assigned", formula=True)
put("All-assigned rate", f"=B{rows['assigned']}/B{rows['rows']}", fmt="0.0%", formula=True)
put("Distinct LRs reached", int(al.loc[al["assigned"], "tax_lr"].nunique()))
put("Published LRs in Helios lookup", len(HEL_LRS))

if gold_summary:
    head("Golden hit rate (scoped records)")
    put("Golden pairs in scope", gold_summary["golden_pairs_in_scope"], "gp")
    put("Eval rows with an assigned LR", gold_summary["eval_rows_with_assigned_lr"], "ev")
    put("Hits (taxonomy LR in record's golden set)", gold_summary["hits"], "hits")
    put("Hit rate", f"=B{rows['hits']}/B{rows['ev']}", "hr", fmt="0.0%", formula=True)
    put("Chance baseline (random LR from published pool)", gold_summary["chance_baseline"], "ch", fmt="0.0%")
    put("Lift vs chance", f"=B{rows['hr']}/B{rows['ch']}", fmt="0.0x", formula=True)
    put("Golden pair coverage (hits / golden pairs)", f"=B{rows['hits']}/B{rows['gp']}", fmt="0.0%", formula=True)
if llm_summary:
    head("Overlap with LLM verdicts")
    for k, v_ in llm_summary.items():
        put(k, v_)
ws.column_dimensions["A"].width = 58
ws.column_dimensions["B"].width = 14
