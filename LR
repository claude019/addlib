    alert_level = alert_level.merge(ev[["rk"] + extra].drop_duplicates("rk"), on="rk", how="left")
alert_level = alert_level.drop(columns=["rk"])

with pd.ExcelWriter(XLSX, engine="openpyxl") as xw:
    funnel.reset_index().to_excel(xw, sheet_name="By_Tier_Match", index=False)
    if by_tier is not None:
