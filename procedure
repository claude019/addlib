        })
        continue

    objects = list_source_objects(procedure_id, version_num)
    found_names = {os.path.basename(o) for o in objects}
    found_count = len(objects)

    matched_names = [n for n in expected_names if n in found_names]
    matches_count = len(matched_names)
    not_matched_count = expected_count - matches_count

    audit_rows.append({
        "Country": "GLOBAL",
        "Table": PROC_TABLE,
        "Procedure_id": procedure_id,
        "Version": version_num,
        "Number of attachments found in the BQ table": expected_count,
        "Number of attachments found in the gcs bucket": found_count,
        "Number of attachments matched (BQ vs gcs)": matches_count,
        "Number of attachments not matched": not_matched_count,
    })

print("\nDone.")

