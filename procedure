    expected_names = active_attachments(parsed)
    expected_count = len(expected_names)

    if expected_count == 0:
        audit_rows.append({
            "Country": "GLOBAL",
            "Table": PROC_TABLE,
            "Procedure_id": procedure_id,
            "Version": version_num,
            "Number of attachments found in the BQ table": 0,
            "Number of attachments found in the gcs bucket": 0,
            "Number of attachments matched (BQ vs gcs)": 0,
