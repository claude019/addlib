    procedure_tables = ["aa_hsbc_gpps_gpps_procedure"]

print(f"\nFound {len(procedure_tables)} procedure table(s): {procedure_tables}")


# ============================================================
# SECTION 2 -- Build one row per procedure
# ============================================================

print("\n\n" + "=" * 80)
print("SECTION 2 -- Scoring every procedure individually")
print("=" * 80)

detail_rows = []

for table in procedure_tables:
    code = table.split("_")[0]
    country = COUNTRY_CODE_NAMES.get(code, code)
    full_table = f"{DATA_PROJECT}.{DATASET}.{table}"

    try:
        df = bq_client.query(f"SELECT * FROM `{full_table}`").to_dataframe()
    except Exception as e:
        print(f"  {country:30s} FAILED to load -- {str(e)[:100]}")
        continue
    if len(df) == 0:
        print(f"  {country:30s} EMPTY")
        continue

    id_col, version_col, json_col = detect_physical_columns(df)
    if not all([id_col, version_col, json_col]):
        print(f"  {country:30s} could not detect physical columns -- skipping")
        continue

    latest = df.sort_values(version_col).groupby(id_col, as_index=False).tail(1).copy()
    latest["parsed"] = latest[json_col].apply(safe_json_loads)

    sample_parsed = next((p for p in latest["parsed"] if isinstance(p, dict)), None)
    if sample_parsed is None:
        print(f"  {country:30s} no parseable JSON -- skipping")
        continue

    fields = detect_json_fields(sample_parsed)
    main_text_key = fields["main_text_key"]
    application_key = fields["application_key"]
    title_key = fields["title_key"]
    segment_text_key = detect_segment_text_key(sample_parsed, application_key)

    for _, row in latest.iterrows():
        parsed = row["parsed"]
        pid = row[id_col]

        if not isinstance(parsed, dict):
            detail_rows.append({
                "Country": country, "Table": table, "procedure_core_id": pid,
                "version_num": row[version_col], "Title": None,
                "Text length": 0, "N segments with text": 0,
                "Has attachment": False, "N active attachments": 0,
                "Attachment names": None, "JSON parse error": True,
            })
            continue

        combined_text, n_segs = get_combined_text(
            parsed, main_text_key, application_key, segment_text_key
        )
        has_attach, n_attach, attach_names = count_active_attachments(parsed, application_key)

        detail_rows.append({
            "Country": country,
            "Table": table,
            "procedure_core_id": pid,
            "version_num": row[version_col],
            "Title": parsed.get(title_key) if title_key else None,
            "Text length": len(combined_text),
            "N segments with text": n_segs,
            "Has attachment": has_attach,
            "N active attachments": n_attach,
            "Attachment names": "; ".join(attach_names) if attach_names else None,
            "JSON parse error": False,
        })

    print(f"  {country:30s} {latest[id_col].nunique()} procedures scored")

detail_df = pd.DataFrame(detail_rows)
detail_df = detail_df.sort_values(["Country", "procedure_core_id"]).reset_index(drop=True)

