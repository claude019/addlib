# ============================================================
# Checking: is "Total procedures: 1200" really the distinct id
# count, and is the "latest version" selection picking the right
# row for every procedure (not just the string-sorted last one)?
# ============================================================

import os
import pandas as pd

try:
    bq_client
except NameError:
    from google.cloud import bigquery
    ANALYTICS_PROJECT = "hsbc-12211200-cmlpwb-prod"
    DATA_PROJECT = "hsbc-11545401-cmpdatcwrs1-prod"
    DATASET = "rc_curated_prod"
    LOCATION = "EU"

    os.environ["GOOGLE_CLOUD_PROJECT"] = ANALYTICS_PROJECT
    os.environ["GOOGLE_APPLICATION_CREDENTIALS"] = (
        "/home/jovyan/.config/gcloud/application_default_credentials.json"
    )
    bq_client = bigquery.Client(project=ANALYTICS_PROJECT, location=LOCATION)

pd.set_option("display.max_columns", None)

TABLE = "aa_hsbc_gpps_gpps_procedure"
ID_COL = "procedure_core_id"
VERSION_COL = "version_num"

print("=" * 70)
print("Checking the total count and version-sort logic")
print("=" * 70)

df = bq_client.query(
    f"SELECT `{ID_COL}`, `{VERSION_COL}` FROM `{DATA_PROJECT}.{DATASET}.{TABLE}`"
).to_dataframe()

print(f"Total ROWS (all versions, no dedup): {len(df):,}")
print(f"Distinct {ID_COL} values:            {df[ID_COL].nunique():,}")
print(f"Average versions per procedure:      {len(df) / df[ID_COL].nunique():.2f}")
print(f"\nversion_num dtype as loaded from BigQuery: {df[VERSION_COL].dtype}")

# (id, version) duplicates would break the "exactly one row per id" guarantee
dupe_check = df.groupby([ID_COL, VERSION_COL]).size()
dupes = dupe_check[dupe_check > 1]
print(f"\n(id, version) combinations appearing more than once: {len(dupes)}")
if len(dupes):
    display(dupes.reset_index(name="row_count").head(10))

# the real question: does string-sort vs numeric-sort pick a DIFFERENT
# "latest" row for any procedure?
if df[VERSION_COL].dtype == object:
    print("\nversion_num loaded as a STRING column -- checking whether that changes "
          "which row counts as 'latest' for any procedure...")

    df["version_numeric"] = pd.to_numeric(df[VERSION_COL], errors="coerce")
    if df["version_numeric"].isna().any():
        print(f"  Note: {df['version_numeric'].isna().sum()} rows couldn't convert "
              f"to numeric -- inspect these separately.")

    latest_string_sort = (
        df.sort_values(VERSION_COL).groupby(ID_COL, as_index=False).tail(1)
    )
    latest_numeric_sort = (
        df.sort_values("version_numeric").groupby(ID_COL, as_index=False).tail(1)
    )

    merged = latest_string_sort[[ID_COL, VERSION_COL]].merge(
        latest_numeric_sort[[ID_COL, VERSION_COL]],
        on=ID_COL, suffixes=("_string_sort", "_numeric_sort"),
    )
    mismatches = merged[
        merged[f"{VERSION_COL}_string_sort"] != merged[f"{VERSION_COL}_numeric_sort"]
    ]

    print(f"\nProcedures where string-sort and numeric-sort pick a DIFFERENT "
          f"'latest' version: {len(mismatches)}")
    if len(mismatches):
        print(">>> Real bug confirmed -- string sorting was evaluating the wrong "
              "version for these procedures (likely ones with 10+ versions, where "
              "'\"9\" > \"10\"' lexicographically). Examples:")
        display(mismatches.head(20))
        print("\nFix: in the main analysis script, sort using the numeric column "
              "(df.sort_values('version_numeric')) instead of the raw string column "
              "before the groupby().tail(1) dedup.")
    else:
        print(">>> No mismatches -- both sort orders picked the same row for every "
              "procedure, so this wasn't the cause here.")
else:
    print(f"\nversion_num is already numeric ({df[VERSION_COL].dtype}) -- string-vs-"
          f"numeric sort ordering isn't a concern for this table.")

print("\n" + "=" * 70)
print("Bottom line")
print("=" * 70)
print(f"""
Distinct {ID_COL} count: {df[ID_COL].nunique():,}

This IS what "Total procedures" in the analysis represents --
groupby(id).tail(1) always collapses to exactly one row per id regardless
of version count, so the total itself can't be inflated by versions.

If a sort-order mismatch was found above, THAT is the real version-related
issue: some procedures were being scored on an older, more sparse version
than their actual latest one. If no mismatch was found, the low completeness
numbers reflect genuine content sparsity in this table (consistent with
what GPPS_Procedure_Field_Verification.py checks separately).
""")
