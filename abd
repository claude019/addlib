if _gone:
    raise NameError(f"not in this kernel: {_gone} -- run the judge+tables script first")

NAVY, WHITE_BOLD = "1F3864", Font(name="Arial", bold=True, color="FFFFFF")
HEADER = PatternFill("solid", fgColor=NAVY)
thin = Side(style="thin", color="BFBFBF")
BORDER = Border(left=thin, right=thin, top=thin, bottom=thin)
NOTE = Font(name="Arial", italic=True, size=9, color="C00000")

wb = openpyxl.Workbook()
ws = wb.active; ws.title = "Alert_LR_performance_filled"
r = 1

def banner(text, span=6):
    global r
    c = ws.cell(row=r, column=1, value=text)
    c.font = WHITE_BOLD; c.fill = HEADER
    ws.merge_cells(start_row=r, start_column=1, end_row=r, end_column=span)
    r += 2

def kv_table(title, rows):
    global r
    banner(title, span=3)
    for label, val in rows:
        ws.cell(row=r, column=1, value=label).border = BORDER
        c = ws.cell(row=r, column=2, value=val); c.border = BORDER
        r += 1
    r += 1

def df_table(title, df, note=None):
    global r
    banner(title, span=max(3, len(df.columns) + 1))
    if note:
        ws.cell(row=r, column=1, value=note).font = NOTE
        ws.merge_cells(start_row=r, start_column=1, end_row=r, end_column=len(df.columns) + 1)
        r += 1
    ws.cell(row=r, column=1, value=df.index.name or "").font = WHITE_BOLD
    ws.cell(row=r, column=1).fill = HEADER
    for j, col in enumerate(df.columns, start=2):
        c = ws.cell(row=r, column=j, value=str(col)); c.font = WHITE_BOLD; c.fill = HEADER
    r += 1
    for idx, row in df.iterrows():
        ws.cell(row=r, column=1, value=str(idx)).border = BORDER
        for j, val in enumerate(row, start=2):
            c = ws.cell(row=r, column=j, value=val); c.border = BORDER
        r += 1
    r += 1

