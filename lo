def _drop_redundant_l2_rows(self, out: pd.DataFrame) -> pd.DataFrame:
    """
    Within the same alert, drop a plain L2-level row when one of its L3
    children (per l2_l3_mapping.csv) is already present as a separate row
    for that alert — regardless of whether the L3 row arrived via
    _expand_l2_to_13's explosion or as an independent top-k prediction.
    """
    required = [self.out_rec_id, self.out_lob_name]
    missing = [c for c in required if c not in out.columns]
    if missing:
        self.logger.warning(
            "redundant L2 row drop skipped; missing column(s) %s", missing
        )
        return out

    mapping = self._load_l2_l3_mapping()   # {l2_name: [l3_name, ...]}
    if not mapping:
        return out

    lob = out[self.out_lob_name].astype(str).str.strip()
    rec = out[self.out_rec_id]
    present_by_rec = lob.groupby(rec).agg(set)

    def _is_redundant(r, name):
        l3_children = mapping.get(name)
        if not l3_children:
            return False
        return bool(present_by_rec.get(r, set()) & set(l3_children))

    drop_mask = pd.Series(
        [_is_redundant(r, n) for r, n in zip(rec, lob)], index=out.index
    )

    if drop_mask.any():
        self.logger.info(
            "redundant L2 row drop: removing %d row(s) with an L3 sibling present",
            int(drop_mask.sum()),
        )
    return out.loc[~drop_mask].reset_index(drop=True)





