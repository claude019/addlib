def find_routed_verdicts(directory=None):
    """Locate the routed lane's verdicts parquet. Prefers the file matching the
    CURRENT model; otherwise the most recently modified one."""
    directory = Path(directory or ROUTED_OUTPUT_DIR)
    if not directory.exists():
        return None
    hits = sorted(directory.glob("risk_verdicts_*.parquet"))
    if not hits:
        return None
    exact = [p for p in hits if p.name == f"risk_verdicts_{MODEL}.parquet"]
    if exact:
        return exact[0]
    newest = max(hits, key=lambda p: p.stat().st_mtime)
    print(f"  [A1] no file for model '{MODEL}'; using most recent: {newest.name}")
    return newest


def recover_scope(routed_verdicts_path=None, save=True):
    """Return (scope_records, routed_verdicts_df_or_None) and write the scope to csv."""
    bar = "=" * 78
    print(bar); print("[A1] SCOPE RECOVERY"); print(bar)

    path = routed_verdicts_path or find_routed_verdicts()
    routed_v = None

    if path is not None:
        routed_v = _read_any(path)
        routed_v["RECORD_ID"] = _norm_id(routed_v["RECORD_ID"])
        routed_v["LIB_RISK"]  = _norm_id(routed_v["LIB_RISK"])
        scope = set(routed_v["RECORD_ID"])
        src = str(path)
        print(f"  source                      : {path.name}")
        print(f"  verdict rows (pairs judged) : {len(routed_v):,}")
        print(f"  distinct records  -> SCOPE  : {len(scope):,}")
        print(f"  distinct library risks      : {routed_v['LIB_RISK'].nunique():,}")
        print(f"  LINKED verdicts             : "
              f"{int((routed_v.decision.astype(str).str.upper()=='LINKED').sum()):,}")
        print("  (reconcile these against the previous run before going further)")
    elif SCOPE_CSV.exists():
        scope = set(_norm_id(pd.read_csv(SCOPE_CSV)["RECORD_ID"]))
        src = str(SCOPE_CSV)
        print(f"  summary verdicts not found; reusing this lane's saved scope: {SCOPE_CSV.name}")
        print(f"  records                     : {len(scope):,}")
    elif "prior_run_results" in globals():
        _prior_run = globals()["prior_run_results"]
        scope = set(_norm_id(
            _prior_run.loc[_prior_run["final_decision"].astype(str).str.upper() == "LINKED", "RECORD_ID"]))
        src = "prior_run_results (LINKED) -- kernel fallback"
        print(f"  summary verdicts not found; falling back to prior_run LINKED records: {len(scope):,}")
        print("  NOTE this may be WIDER than the records actually judged, because")
        print("       build_risk_candidates dropped records with no candidates.")
    else:
        raise FileNotFoundError(
            f"Cannot recover the scope. Looked for risk_verdicts_*.parquet in "
            f"{ROUTED_OUTPUT_DIR}, then {SCOPE_CSV}, then `prior_run_results` in the "
            f"kernel. Point ROUTED_OUTPUT_DIR at the previous run's output folder. "
            f"Do NOT scope from golden -- it breaks the head-to-head.")

    # --- reconciliation against prior_run, when it happens to be in the kernel -----
    if "prior_run_results" in globals() and path is not None:
        _prior_run = globals()["prior_run_results"]
        prior_run_linked = set(_norm_id(
            _prior_run.loc[_prior_run["final_decision"].astype(str).str.upper() == "LINKED", "RECORD_ID"]))
        dropped = prior_run_linked - scope
        print(f"  prior_run LINKED records          : {len(prior_run_linked):,}")
        print(f"  ... never judged by routed lane: {len(dropped):,}"
              + (f"  e.g. {sorted(dropped)[:3]}" if dropped else ""))
        if dropped:
            print("      (no candidate risks or no alert text -- correctly excluded here too)")

    if save:
        pd.DataFrame({"RECORD_ID": sorted(scope)}).to_csv(SCOPE_CSV, index=False)
        print(f"  scope saved                 : {SCOPE_CSV}")
    print(f"  ==> SCOPE = {len(scope):,} records   (source: {src})")
    return scope, routed_v


