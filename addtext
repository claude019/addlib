# %% ==========================================================================
# [G] PERFORMANCE PACK -- confusion matrix + the run documentation workbook
#
# [D] gives the three honest numbers. It does NOT give a confusion matrix, and
# the routed lane never had one -- TP/FN/FP/TN were assembled by hand for the deck.
# This cell derives them from `verdicts` + `golden` and writes one xlsx documenting for this run.
#
# Vocabulary, so nobody misreads the matrix:
#   TP  model LINKED and golden agrees                     -> genuinely correct
#   FN  model did not link but golden did                  -> the miss pile
#   FP  model LINKED, pair absent from golden              -> DISCOVERY, not an
#       error: the golden is hand-picked and non-exhaustive
#   TN  neither linked                                     -> CONTAMINATED, it
#       also holds real links nobody has recorded yet
# Precision / F1 are therefore NOT computed. Recall only.
#
# Optional inputs, picked up automatically if present in the kernel:
#   `audited`    (from [F])   -> adds the audit drill-down + honest-recall rows
#   `comparison` (from [F0])  -> adds the head-to-head tab
# =============================================================================
def label_cells():
    """One row per JUDGED pair, labelled TP / FN / FP / TN, plus the golden pairs
    that were never judged (which sit outside the matrix by definition)."""
    v = verdicts.copy()
    v["REC"], v["RISK"] = _norm_id(v.RECORD_ID), _norm_id(v.LIB_RISK)
    v["DEC"] = v.decision.astype(str).str.strip().str.upper()
    rank = {"LINKED": 4, "INSUFFICIENT_EVIDENCE": 3, "NOT_LINKED": 2, "MISSING": 1, "ERROR": 0}
    v["_r"] = v.DEC.map(rank).fillna(-1)
    v = (v.sort_values("_r", ascending=False)
           .drop_duplicates(["REC", "RISK"])[["REC", "RISK", "DEC"]])
    v = v[v.REC.isin(scope_records)]

    g = golden[~golden.LIB_RISK.isin(_BLANK)]
    g = g[g.RECORD_ID.isin(scope_records)]
    gp = g[["RECORD_ID", "LIB_RISK"]].drop_duplicates()
    gkeys = set(gp.RECORD_ID + "|" + gp.LIB_RISK)

    v["in_golden"] = (v.REC + "|" + v.RISK).isin(gkeys)
    v["linked"]    = v.DEC.eq("LINKED")
    v["cell"] = np.select(
        [v.in_golden & v.linked, v.in_golden & ~v.linked,
         ~v.in_golden & v.linked, ~v.in_golden & ~v.linked],
        ["TP", "FN", "FP", "TN"], default="?")

    judged = set(v.REC + "|" + v.RISK)
    never  = gp[~(gp.RECORD_ID + "|" + gp.LIB_RISK).isin(judged)].copy()
    # A golden pair can go unjudged for two very different reasons: the risk has
    # no the risk register text at all (data gap, carved out of the denominator), or it has
    # text and still was not shown (a real gap -- should be 0 in this lane).
    never["has_register_text"] = never.LIB_RISK.isin(set(register.LIB_RISK))

    bar = "=" * 74
    print(bar); print("[G] CONFUSION MATRIX (judged pairs only)"); print(bar)
    cm = (v.pivot_table(index="linked", columns="in_golden", values="REC",
                        aggfunc="count", fill_value=0)
            .rename(index={True: "model LINKED", False: "model NOT LINKED"},
                    columns={True: "golden linked", False: "golden not linked"}))
    print(cm.to_string())
    c = v.cell.value_counts().to_dict()
    tp, fn = c.get("TP", 0), c.get("FN", 0)
    print("-" * 60)
    print(f"  TP {tp:,}   FN {fn:,}   FP {c.get('FP',0):,} (discoveries)   "
          f"TN {c.get('TN',0):,} (contaminated)")
    print(f"  RECALL on judged pairs = {tp:,}/{tp+fn:,} = {tp/max(tp+fn,1):.1%}")
    print(f"  golden pairs NEVER judged (outside the matrix): {len(never):,}"
          f"   [data gap {int((~never.has_register_text).sum()):,} | "
          f"had text but unjudged {int(never.has_register_text.sum()):,}]")
    print("  Precision / F1 deliberately not computed: the golden is non-exhaustive,")
    print("  so an FP is a candidate new link, not an error.")
    return v, never


def build_funnel_table(cells):
    """The funnel in the same shape as the control lane's Performance_metrics
    sheet: Category / Explanation / Counts / Percentage."""
    k = SCORECARD_COUNTS
    tp = int((cells.cell == "TP").sum()); fn = int((cells.cell == "FN").sum())
    addr = max(k["addressable"], 1)
    rows = [
        ("Total Linkages", "Golden Record -> Library Risk pairs handed to us for the "
         "records in scope.", k["golden_total"], 1.0),
        ("Linkages Missed", "Golden links whose library risk has no published text in "
         "the risk register -- cannot be judged.", k["data_gap"], k["data_gap"] / max(k["golden_total"], 1)),
        ("Final Linkages by solution (addressable golden pairs)",
         "Total less the data gap. Denominator for naive recall.", k["addressable"], 1.0),
        ("Not Judged (never shown)",
         "Golden pairs the model never saw. In the DIRECT lane this should be 0 -- "
         "there is no route and no top-k cap.", k["not_judged"], k["not_judged"] / addr),
        ("Judged Insufficient", "Risk text too sparse to evidence either verdict.",
         k["insufficient"], k["insufficient"] / addr),
        ("Judged Not Linked", "Solution saw the pair and did not predict a linkage.",
         k["judged_not_linked"], k["judged_not_linked"] / addr),
        ("Caught (validated)", "Solution predicted the linkage and the golden confirms it.",
         k["validated"], k["validated"] / addr),
        ("Addressable (Naive) Recall", "Caught / all addressable golden links. Inflated "
         "denominator -- includes whole-regulation sweep-in.",
         k["validated"], k["validated"] / addr),
        ("Recall vs golden as handed (judged pairs)",
         "Caught / golden links the model actually judged. The confusion-matrix recall.",
         tp, tp / max(tp + fn, 1)),
    ]

    # Audit-derived rows, only if [F] has run.
    if "audited" in globals() and globals()["audited"] is not None and len(globals()["audited"]):
        hr = honest_recall(SCORECARD_COUNTS, globals()["audited"])
        rows += [
            ("Text Derivable Recall",
             "Denominator = caught + links the audit says were derivable from the text "
             "+ insufficient-evidence cases.",
             k["validated"], hr["text_derivable"]),
            ("Model-Addressable Recall",
             "As above, further excluding SME-only links (inferable only with external "
             "knowledge).", k["validated"], hr["addressable"]),
        ]
    else:
        rows += [("Text Derivable Recall", "RUN SECTION [F] FIRST -- needs `audited`.", None, None),
                 ("Model-Addressable Recall", "RUN SECTION [F] FIRST -- needs `audited`.", None, None)]

    return pd.DataFrame(rows, columns=["Category", "Explanation", "Counts", "Percentage"])


def build_by_risk(cells):
    """Where the misses concentrate -- the table that tells you what to fix next."""
    t = (cells.pivot_table(index="RISK", columns="cell", values="REC",
                           aggfunc="count", fill_value=0).reset_index())
    for col in ["TP", "FN", "FP", "TN"]:
        if col not in t.columns:
            t[col] = 0
    t = t.rename(columns={"TP": "caught", "FN": "missed", "FP": "discoveries",
                          "TN": "judged_not_linked_nongolden"})
    t["golden_pairs"] = t.caught + t.missed
    t["recall"] = np.where(t.golden_pairs > 0, t.caught / t.golden_pairs.replace(0, np.nan), np.nan)
    t = t.merge(register[["LIB_RISK", "risk_title"]],
                left_on="RISK", right_on="LIB_RISK", how="left").drop(columns="LIB_RISK")
    t["retirement_flag"] = t.risk_title.fillna("").str.contains(
        "TO BE RETIRED", case=False, na=False)
    return (t.sort_values("missed", ascending=False)
             [["RISK", "risk_title", "golden_pairs", "caught", "missed",
               "recall", "discoveries", "retirement_flag"]]
             .reset_index(drop=True))


def performance_pack(path=None):
    """Write the documentation workbook for THIS run. Every number is derived
    from `verdicts` / `golden` / `SCORECARD_COUNTS` -- nothing is typed in."""
    cells, never = label_cells()
    c = cells.cell.value_counts().to_dict()
    tp, fn = c.get("TP", 0), c.get("FN", 0)
    k = SCORECARD_COUNTS

    meta = pd.DataFrame([
        ("Run ID", RUN_ID), ("Comment", RUN_COMMENT), ("Model", MODEL),
        ("Prompt file", RISK_PROMPT_PATH.name),
        ("Prompt SHA (first 12)", hashlib.sha256(RISK_SYSTEM_PROMPT.encode()).hexdigest()[:12]),
        ("Run at", datetime.now(timezone.utc).isoformat(timespec="seconds")),
        ("Records in scope", len(scope_records)),
        ("Published library risks judged", int(cells.RISK.nunique())),
        ("Alert-risk pairs judged", len(cells)),
        ("top_k", str(LANE["top_k"])), ("chunk", LANE["chunk"]),
        ("concurrency", LANE["concurrency"]), ("min_score", LANE["min_score"]),
        ("Golden pairs (in scope)", k["golden_total"]),
        ("Addressable golden pairs", k["addressable"]),
        ("Data gap (no the risk register text)", k["data_gap"]),
        ("Golden pairs never judged", len(never)),
        ("VALIDATED (TP)", tp), ("MISSED (FN)", fn),
        ("DISCOVERIES (FP)", c.get("FP", 0)),
        ("TN (contaminated)", c.get("TN", 0)),
        ("Recall on judged pairs", tp / max(tp + fn, 1)),
        ("Recall on addressable golden", k["validated"] / max(k["addressable"], 1)),
    ], columns=["Field", "Value"])

    funnel  = build_funnel_table(cells)
    by_risk = build_by_risk(cells)

    cm = pd.DataFrame(
        [["Model = LINKED", tp, c.get("FP", 0)],
         ["Model = NOT LINKED", fn, c.get("TN", 0)]],
        columns=["", "Golden = linked", "Golden = not linked"])
    cm_notes = pd.DataFrame([
        ("TP", tp, "Model linked and golden agrees -- genuinely correct."),
        ("FN", fn, "Model did not link but golden did -- the miss pile; audit it in [F]."),
        ("FP", c.get("FP", 0), "Predicted but absent from golden -> DISCOVERY for SME review, not an error."),
        ("TN", c.get("TN", 0), "Neither linked -- contaminated: also holds real links nobody has recorded."),
        ("NOT JUDGED", len(never), "Golden pairs the model never saw. Outside the matrix."),
    ], columns=["Cell", "Count", "What it means"])

    calls = pd.DataFrame(_read_jsonl(CALLS_JSONL))
    call_summary = pd.DataFrame([
        ("Judge calls made", len(calls)),
        ("Calls with an error", int(calls.error.notna().sum()) if len(calls) else 0),
        ("Prompt tokens", int(calls.prompt_tokens.fillna(0).sum()) if len(calls) else 0),
        ("Completion tokens", int(calls.completion_tokens.fillna(0).sum()) if len(calls) else 0),
        ("Truncated (finish_reason != stop)",
         int((calls.finish_reason.fillna("") != "stop").sum()) if len(calls) else 0),
    ], columns=["Field", "Value"])

    path = Path(path or (OUTPUT_DIR / f"performance_pack_direct_{MODEL}.xlsx"))
    with pd.ExcelWriter(path, engine="openpyxl") as xl:
        meta.to_excel(xl, sheet_name="Run_summary", index=False)
        call_summary.to_excel(xl, sheet_name="Run_summary", index=False,
                              startrow=len(meta) + 3)
        funnel.to_excel(xl, sheet_name="Performance_metrics", index=False)
        cm.to_excel(xl, sheet_name="Confusion_matrix", index=False)
        cm_notes.to_excel(xl, sheet_name="Confusion_matrix", index=False, startrow=5)
        by_risk.to_excel(xl, sheet_name="By_risk", index=False)
        never.to_excel(xl, sheet_name="Never_judged", index=False)
        cells[cells.cell == "FP"].to_excel(xl, sheet_name="Discoveries", index=False)
        cells[cells.cell == "FN"].to_excel(xl, sheet_name="Missed_FN", index=False)
        if "audited" in globals() and globals()["audited"] is not None and len(globals()["audited"]):
            (globals()["audited"].audit_category.value_counts()
                .rename_axis("audit_category").reset_index(name="count")
                .to_excel(xl, sheet_name="Audit_drilldown", index=False))
        if "comparison" in globals() and globals()["comparison"] is not None:
            globals()["comparison"].to_excel(xl, sheet_name="Head_to_head", index=False)

        # widths + percent formats, so it is readable without manual fiddling
        for ws in xl.book.worksheets:
            for col, width in zip("ABCDEFGH", [46, 62, 14, 14, 14, 14, 14, 14]):
                ws.column_dimensions[col].width = width
            for row in ws.iter_rows():
                for cellobj in row:
                    if isinstance(cellobj.value, float) and -1.01 <= cellobj.value <= 1.01:
                        cellobj.number_format = "0.0%"

    print(f"\n[G] performance pack -> {path}")
    print("    tabs: Run_summary | Performance_metrics | Confusion_matrix | By_risk |")
    print("          Never_judged | Discoveries | Missed_FN"
          + (" | Audit_drilldown" if "audited" in globals() else "")
          + (" | Head_to_head" if "comparison" in globals() else ""))
    print("    Re-run this cell AFTER [F] to fill the text-derivable recall rows.")
    return {"cells": cells, "never_judged": never, "funnel": funnel,
            "by_risk": by_risk, "path": path}


pack = performance_pack()
