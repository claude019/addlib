def _read_any(path: Path, usecols=None) -> pd.DataFrame:
    """Read a parquet / xlsx / csv into a DataFrame, tolerant of the format."""
    suffix = path.suffix.lower()
    if suffix == ".parquet":
        df = pd.read_parquet(path, columns=usecols)
    elif suffix in (".xlsx", ".xls"):
        df = pd.read_excel(path)
        if usecols:
            df = df[[c for c in usecols if c in df.columns]]
    else:
        df = pd.read_csv(path)
    df.columns = [str(c).strip() for c in df.columns]
    return df


def _find(directory: Path, stem: str) -> Path:
    """Find the first file in `directory` whose name contains `stem`."""
    hits = [p for p in directory.iterdir()
            if p.suffix.lower() in (".parquet", ".xlsx", ".xls", ".csv")
            and stem.lower() in p.name.lower()]
    if not hits:
        raise FileNotFoundError(f"no file matching '{stem}' in {directory}")
    return sorted(hits)[0]


def _norm_id(series) -> pd.Series:
    """Normalise an id column to string / stripped / upper-cased so joins never
    silently miss on stray whitespace or case."""
    return pd.Series(series).astype(str).str.strip().str.upper()


_BLANK = {"", "NONE", "NAN", "-", "NAT"}


def load_map_summary() -> pd.DataFrame:
    """the summary extract ('summary_taxonomy'): one row per Regulation Summary
    (summary), carrying its parent Regulation (regulation) + the summary title/detail text
    and risk taxonomy. Used for the funnel and for summary -> regulation only.
    Output columns: JUR, REG_ID, SUM_ID, SUM_TITLE, SUM_TEXT, SUM_TAX_*"""
    df = _read_any(_find(MAP_DIR, "summary_taxonomy")).rename(columns=SOURCE_RENAME)
    return df


def load_map_risk() -> pd.DataFrame:
    """the summary-to-risk extract ('summary_risk_map'): the summary -> risk
    edge. THIS is our parentage source.

    the summary-to-risk extract is at summary x L1-Library-Control x L2-Library-Control grain, so there
    are multiple rows per summary -- we dedupe to the (summary, LR) pair.
    Output columns: REG_ID, SUM_ID, LIB_RISK"""
    df = _read_any(_find(MAP_DIR, "summary_risk_map")).rename(columns=SOURCE_RENAME)
    for c in ["REG_ID", "SUM_ID", "LIB_RISK"]:
        df[c] = _norm_id(df[c])
    df = df[~df["LIB_RISK"].isin(_BLANK)]
    return df[["REG_ID", "SUM_ID", "LIB_RISK"]].drop_duplicates().reset_index(drop=True)


def load_register_risk() -> pd.DataFrame:
    """the risk register risk_extract is keyed by risk INSTANCE (`name` = R-xxxxxxx); the LIBRARY
    risk is carried as parent fields on every instance row. Collapse to one row
    per library risk and build the judgeable text.

    Do NOT use the instance-level columns (title, description, name,
    risk_description, risk_status, risk_owner, inherent_risk_*, residual_risk_*,
    rca_participants, lifecycle_comments, is_active, is_original) -- they vary
    across instances of the same library risk.

    Output columns: LIB_RISK, risk_title, risk_desc, risk_text"""
    df = _read_any(_find(REGISTER_DIR, "risk_extract"))

    df = df.rename(columns={"risk_id": "LIB_RISK"})
    df["LIB_RISK"] = _norm_id(df["LIB_RISK"])
    df = df[~df["LIB_RISK"].isin(_BLANK)]

    # Published only; newest instance wins the parent fields.
    df = (df[df["risk_status"].eq("Published")]
            .sort_values("last_modified", ascending=False)
            .drop_duplicates("LIB_RISK"))

    tax = (df["taxonomy_l1"].fillna("") + " | "
         + df["taxonomy_l2"].fillna("") + " | "
         + df["taxonomy_l3"].fillna(""))

    # The taxonomy / business / entity lines are part of the risk's MEANING,
    # not metadata -- the one-line description alone is too thin to judge on.
    df["risk_text"] = (
        "Library Risk Title:- "  + df["risk_title"].fillna("")
      + "\n\nDescription:- "     + df["risk_desc"].fillna("")
      + "\n\nRisk Taxonomy:- "   + tax
      + "\n\nBusiness:- "        + df["business"].fillna("")
      + "\n\nLegal Entity:- "    + df["entity"].fillna("")
    ).map(clean)

    return (df[["LIB_RISK", "risk_title",
                "risk_desc", "risk_text"]]
              .reset_index(drop=True))


def load_golden() -> pd.DataFrame:
    """Golden risk mapping: known-true Record -> regulation -> Library Risk links.
    VALIDATION ONLY -- never used to build candidates.
    Note: the golden's own summary column is blank; that is the source of the
    structural over-mapping quantified in [B2] / [E] / [F]."""
    g = _read_any(GOLDEN_FILE).rename(columns={
        "Record ID":                                 "RECORD_ID",
        "Regulation ID":                             "REG_ID",
        "Parent Risk ID": "LIB_RISK",
    })
    for c in ["RECORD_ID", "REG_ID", "LIB_RISK"]:
        g[c] = _norm_id(g[c])
    return g


def load_alerts(record_ids) -> pd.DataFrame:
    """Build one cleaned alert text per record, restricted to the records we run.
    (Verbatim from the summary/regulation lane so alert text is enriched IDENTICALLY here.)"""
    df = pd.read_parquet(ALERTS_FILE, engine="pyarrow")

    for col in ["TITLE", "BODY_TEXT", "UPDATE_TEXT",
                "JURISDICTION_CODE", "JURISDICTION_NAME", "AUTHORITY_CODE"]:
        if col in df.columns:                      # AUTHORITY_CODE may not exist
            df[col] = df[col].fillna("").map(clean)
        else:
            df[col] = ""

    # When the running summary equals the original content, don't repeat it.
    content_equals_update = df["BODY_TEXT"] == df["UPDATE_TEXT"]
    df["alert_text"] = np.where(
        content_equals_update,
        (df.TITLE + "\n\n" + df.BODY_TEXT).str.strip(),
        ("Title:- "                   + df.TITLE
         + "\n\nContent:- "           + df.BODY_TEXT
         + "\n\nUpdate:- "            + df.UPDATE_TEXT
         + "\n\nJurisdiction Code:- " + df.JURISDICTION_CODE
         + "\n\nJurisdiction Name:- " + df.JURISDICTION_NAME
         + "\n\nAuthority Code:- "    + df.AUTHORITY_CODE).str.strip())

    df["RECORD_ID"] = _norm_id(df["RECORD_ID"])
    df = df[df.RECORD_ID.isin(record_ids) & (df.alert_text.str.len() > 0)]
    return df[["RECORD_ID", "alert_text"]].drop_duplicates("RECORD_ID").reset_index(drop=True)


