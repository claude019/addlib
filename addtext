# ---- checkpoint primitives --------------------------------------------------
def _append_jsonl(path, obj):
    """Append one JSON line and force it to disk. A line that never reaches the
    platter is a unit that gets re-run -- safe. A hard kill can leave the file
    without a trailing newline, which would glue the next append onto the torn
    line and lose a SECOND unit, so terminate it first."""
    path = Path(path)
    if path.exists() and path.stat().st_size:
        with open(path, "rb") as fh:
            fh.seek(-1, os.SEEK_END)
            needs_nl = fh.read(1) != b"\n"
        if needs_nl:
            with open(path, "a", encoding="utf-8") as fh:
                fh.write("\n")
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(obj, ensure_ascii=False) + "\n")
        fh.flush(); os.fsync(fh.fileno())


def _read_jsonl(path):
    """Tolerant reader: a torn final line (hard kill mid-write) is dropped."""
    out = []
    if not Path(path).exists():
        return out
    with open(path, "r", encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                out.append(json.loads(line))
            except json.JSONDecodeError:
                print(f"    [ckpt] dropping one torn line in {Path(path).name}")
    return out


def load_completed():
    """(done_unit_keys, rows_already_on_disk)"""
    done, rows = set(), []
    for rec in _read_jsonl(VERDICTS_JSONL):
        key = rec.get("unit")
        if key is None or key in done:          # ignore a duplicated unit
            continue
        done.add(key)
        rows.extend(rec.get("rows", []))
    return done, rows


def _snapshot(rows, n_done, n_total):
    df = pd.DataFrame(rows).drop_duplicates(["RECORD_ID", "LIB_RISK"])
    df.to_parquet(PARTIAL_FILE, index=False)
    STATE_FILE.write_text(json.dumps({
        "run_id": RUN_ID, "units_done": n_done, "units_total": n_total,
        "rows": len(df), "updated": datetime.now(timezone.utc).isoformat()}))
    print(f"    [ckpt] {n_done}/{n_total} units, {len(df):,} rows -> {PARTIAL_FILE.name}")


def _finalise(rows):
    df = pd.DataFrame(rows)
    if len(df):
        # a retried unit can duplicate a pair; keep the strongest decision
        rank = {"LINKED": 4, "INSUFFICIENT_EVIDENCE": 3, "NOT_LINKED": 2,
                "MISSING": 1, "ERROR": 0}
        df["_r"] = df.decision.astype(str).str.upper().map(rank).fillna(-1)
        df = (df.sort_values("_r", ascending=False)
                .drop_duplicates(["RECORD_ID", "LIB_RISK"])
                .drop(columns="_r").reset_index(drop=True))
    df.to_parquet(FINAL_FILE, index=False)
    print(f"[C] verdicts: {len(df):,}  linked: "
          f"{int((df.decision.astype(str).str.upper()=='LINKED').sum()) if len(df) else 0:,}"
          f"  -> {FINAL_FILE}")
    return df


# ---- the work plan ----------------------------------------------------------
def build_plan(records, top_k=None, chunk=None, force=False):
    """Build (or load) the deterministic unit plan.

    Candidates are ALL published library risks with text -- no summary cascade, no
    retrieval cap. Embeddings are used for ORDERING ONLY (most relevant risk
    first inside each chunk); with top_k=None nothing is dropped, so the result
    set is identical with or without them.
    """
    chunk = chunk or LANE["chunk"]

    if PLAN_FILE.exists() and not force:
        plan = json.loads(PLAN_FILE.read_text())
        print(f"[C] plan loaded from checkpoint: {len(plan['units']):,} units, "
              f"{len(plan['records']):,} records, chunk={plan['chunk']}")
        return plan

    risk_text_by_id = {r: t for r, t in zip(register.LIB_RISK, register.risk_text)
                       if isinstance(t, str) and t.strip()}
    alerts_df = load_alerts(set(records))
    alert_text_by_id = dict(zip(alerts_df.RECORD_ID, alerts_df.alert_text))

    dropped = set(records) - set(alert_text_by_id)
    if dropped:
        print(f"[C] WARNING {len(dropped)} scoped records have no alert text and are "
              f"dropped: {sorted(dropped)[:5]}")

    rec_list  = [r for r in sorted(records) if r in alert_text_by_id]
    risk_pool = sorted(risk_text_by_id)

    order_by_record, used_embeddings = {}, False
    try:
        risk_vecs  = embed_cache(risk_pool, [risk_text_by_id[c] for c in risk_pool],
                                 "register_library_risks")        # same tag as the routed lane
        alert_vecs = embed_cache(rec_list, [alert_text_by_id[r] for r in rec_list],
                                 "alerts_risk_lane_direct")     # NEW tag -- do NOT reuse
        for i, rid in enumerate(rec_list):
            sims = np.asarray(risk_vecs) @ np.asarray(alert_vecs)[i]
            idx  = np.argsort(-sims)
            order_by_record[rid] = [risk_pool[j] for j in (idx[:top_k] if top_k else idx)]
        used_embeddings = True
    except Exception as e:
        print(f"[C] embedding ordering skipped ({type(e).__name__}: {e}); using pool order.")
        for rid in rec_list:
            order_by_record[rid] = risk_pool[:top_k] if top_k else list(risk_pool)

    units = []
    for rid in rec_list:
        risks = order_by_record[rid]
        for i in range(0, len(risks), chunk):
            units.append([rid, i // chunk, risks[i:i + chunk]])

    total_pairs = sum(len(u[2]) for u in units)
    if total_pairs > MAX_PAIRS_GUARD:
        raise ValueError(f"plan would judge {total_pairs:,} pairs (> MAX_PAIRS_GUARD="
                         f"{MAX_PAIRS_GUARD:,}). Set LANE['top_k'] for a smoke run, or "
                         f"raise the guard deliberately.")

    plan = {"run_id": RUN_ID, "comment": RUN_COMMENT, "model": MODEL,
            "chunk": chunk, "top_k": top_k,
            "built_at": datetime.now(timezone.utc).isoformat(),
            "prompt_sha": hashlib.sha256(RISK_SYSTEM_PROMPT.encode()).hexdigest()[:12],
            "records": order_by_record, "units": units}
    PLAN_FILE.write_text(json.dumps(plan))
    print(f"[C] plan built: {len(units):,} units over {len(rec_list):,} records, "
          f"{total_pairs:,} pairs, chunk={chunk}, "
          f"ordering={'cosine' if used_embeddings else 'pool order'}")
    return plan


# ---- judge machinery (verbatim from the routed lane) ---------------------------
def _judge_call_kwargs():
    """Per-model-family kwargs (GPT vs Gemini) for the risk judge call."""
    kw = {"model": MODEL, "user": USE_CASE, "response_format": RISK_SCHEMA}
    if JUDGE_LOGPROBS:
        kw["logprobs"] = True; kw["top_logprobs"] = 5
    if "gemini" in MODEL.lower():
        kw.update(temperature=0.0, seed=42,
                  reasoning_effort=LANE["reasoning"], max_tokens=LANE["max_tokens"])
    else:  # gpt-family
        kw.update(reasoning_effort=LANE["reasoning"],
                  max_completion_tokens=LANE["max_tokens"])
    return kw


async def _judge_one_chunk(alert_text, risk_chunk, rid=None):
    """Judge one alert against a small chunk of risks. Returns (items, call_log).
    risk_chunk: list of (risk_id, risk_text). Retries + token refresh on 401."""
    payload = {"alert_text": alert_text,
               "risks": [{"risk_id": r, "risk_text": t} for r, t in risk_chunk]}
    messages = [{"role": "system", "content": RISK_SYSTEM_PROMPT},
                {"role": "user",   "content": json.dumps(payload, ensure_ascii=False)}]
    last_err = None
    for attempt in range(1, LANE["max_retries"] + 1):
        try:
            token = await tok.get()
            r = await oai.chat.completions.create(
                messages=messages,
                extra_headers={"Authorization": f"Bearer {token}"},   # gateway v2 auth
                **_judge_call_kwargs())
            u = r.usage
            RISK_USAGE_LOG.append({"in": u.prompt_tokens, "out": u.completion_tokens,
                                   "ts": time.time()})
            log = {"RECORD_ID": rid, "RUN_ID": RUN_ID, "model": MODEL,
                   "run_comment": RUN_COMMENT, "attempt": attempt,
                   "finish_reason": r.choices[0].finish_reason,
                   "prompt_tokens": u.prompt_tokens, "completion_tokens": u.completion_tokens,
                   "total_tokens": u.total_tokens, "num_candidates": len(risk_chunk),
                   "error": None, "ts": time.time()}
            RAW_RESPONSE_LOG.append(log)
            return json.loads(r.choices[0].message.content)["items"], log
        except Exception as e:
            last_err = e
            # a 401 means the token went stale mid-flight -> force refresh and retry
            if "401" in str(e) or "unauth" in str(e).lower():
                try:
                    await tok.invalidate()
                except Exception:
                    pass
            await asyncio.sleep(1.5 ** attempt)

    log = {"RECORD_ID": rid, "RUN_ID": RUN_ID, "model": MODEL, "run_comment": RUN_COMMENT,
           "attempt": LANE["max_retries"], "finish_reason": None,
           "prompt_tokens": None, "completion_tokens": None, "total_tokens": None,
           "num_candidates": len(risk_chunk),
           "error": f"{type(last_err).__name__}: {last_err}", "ts": time.time()}
    RAW_RESPONSE_LOG.append(log)
    # all retries failed -> emit ERROR rows so the batch never crashes
    return ([{"risk_id": r, "decision": "ERROR", "relevance_score": 0,
              "reasoning": f"n/a: {last_err}"} for r, _ in risk_chunk], log)


async def run_direct_linkage(plan, resume=True):
    """Execute the plan with checkpointing. Safe to call repeatedly."""
    risk_text_by_id  = dict(zip(register.LIB_RISK, register.risk_text))
    alerts_df        = load_alerts(set(plan["records"]))
    alert_text_by_id = dict(zip(alerts_df.RECORD_ID, alerts_df.alert_text))

    done, rows_on_disk = (load_completed() if resume else (set(), []))
    pending = [(rid, idx, risks) for rid, idx, risks in plan["units"]
               if f"{rid}#{idx}" not in done]

    print(f"[C] units total={len(plan['units']):,}  done={len(done):,}  "
          f"pending={len(pending):,}  (rows already on disk: {len(rows_on_disk):,})")
    if not pending:
        print("[C] nothing pending -- assembling from checkpoint.")
        return _finalise(rows_on_disk)

    sem       = asyncio.Semaphore(LANE["concurrency"])
    write_lok = asyncio.Lock()
    counter   = {"n": len(done), "rows": list(rows_on_disk)}

    async def _one(rid, idx, risk_ids):
        key = f"{rid}#{idx}"
        async with sem:                                   # cap concurrency
            pairs = [(c, risk_text_by_id.get(c, "")) for c in risk_ids]
            items, log = await _judge_one_chunk(alert_text_by_id.get(rid, ""), pairs, rid=rid)
            got = {str(it.get("risk_id", "")).strip().upper(): it for it in items}
            rows = []
            # iterate the ORIGINAL chunk so we always emit a row per candidate,
            # even if the model skipped / reordered / hallucinated an id
            for cid, _ in pairs:
                it = got.get(cid)
                rows.append({"RECORD_ID": rid, "LIB_RISK": cid,
                             "decision": (it or {}).get("decision", "MISSING"),
                             "relevance_score": (it or {}).get("relevance_score", 0),
                             "reasoning": (it or {}).get("reasoning")})
        # ---- checkpoint: one fsync'd line per completed unit -----------------
        async with write_lok:
            _append_jsonl(VERDICTS_JSONL, {"unit": key, "ts": time.time(), "rows": rows})
            _append_jsonl(CALLS_JSONL, log)
            counter["n"] += 1
            counter["rows"].extend(rows)
            if counter["n"] % SNAPSHOT_EVERY == 0:
                _snapshot(counter["rows"], counter["n"], len(plan["units"]))
        return len(rows)

    tasks = [asyncio.create_task(_one(rid, idx, risks)) for rid, idx, risks in pending]
    try:
        for fut in tqdm(asyncio.as_completed(tasks), total=len(tasks), desc="judge units"):
            await fut
    except BaseException:
        # kernel interrupt / disconnect: stop the rest cleanly so the notebook is
        # not left with orphaned tasks. Everything already written survives.
        for t in tasks:
            if not t.done():
                t.cancel()
        await asyncio.gather(*tasks, return_exceptions=True)
        _snapshot(counter["rows"], counter["n"], len(plan["units"]))
        print(f"[C] INTERRUPTED at {counter['n']}/{len(plan['units'])} units. "
              f"Checkpoint intact -- re-run cells [0] -> [C] to finish.")
        print("    If you interrupted with Ctrl-C in a LIVE kernel, restart the kernel")
        print("    first: the aborted coroutine can linger on the event loop and re-raise")
        print("    into the next run. A VDI disconnect kills the kernel anyway, so after")
        print("    one of those you can just re-run the cells.")
        raise
    return _finalise(counter["rows"])


