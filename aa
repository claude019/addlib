        policy_level_df.groupby("country")
        .agg(
            policies=("policy_core_id", "nunique"),
            policyText_median=("policyText_len", "median"),
            policyText_empty=("policyText_len", lambda s: int((s == 0).sum())),
            policyText_below_threshold=("policyText_len",
                                        lambda s: int((s < MEANINGFUL_TEXT_LEN).sum())),
            policyPurpose_median=("policyPurpose_len", "median"),
            policyPurpose_empty=("policyPurpose_len", lambda s: int((s == 0).sum())),
        )
