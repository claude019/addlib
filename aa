print("\n\n" + "=" * 80)
print("SECTION 1 -- Table-level overview")
print("=" * 80)

if len(policy_level_df):
    table_overview = (
        policy_level_df.groupby(["country", "table"])
        .agg(
            policies=("policy_core_id", "nunique"),
            max_version=("version_num", "max"),
            avg_version=("version_num", "mean"),
