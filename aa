    )
    table_overview["avg_version"] = table_overview["avg_version"].round(2)
    table_overview["avg_segments_per_policy"] = table_overview["avg_segments_per_policy"].round(1)
    display(table_overview.sort_values("policies", ascending=False))


# ============================================================
# SECTION 2 -- plcyObjTypeCde: NULL vs POPULATED at every grain
# ============================================================

print("\n\n" + "=" * 80)
print("SECTION 2 -- plcyObjTypeCde: null vs populated")
print("=" * 80)

# ---- 2a. Segment grain: does the segment even have an objRel list? ----
print("\n[2a] SEGMENT GRAIN -- objRel container state")
print("     (a segment with no objRel can carry no plcyObjTypeCde at all)")

if len(segment_level_df):
    seg_objrel_state = pd.crosstab(
        segment_level_df["country"], segment_level_df["objRel_state"]
    )
    seg_objrel_state["TOTAL"] = seg_objrel_state.sum(axis=1)
    populated_col = "POPULATED" if "POPULATED" in seg_objrel_state.columns else None
    if populated_col:
        seg_objrel_state["POPULATED_PCT"] = (
            seg_objrel_state[populated_col] / seg_objrel_state["TOTAL"] * 100
        ).round(2)
    display(seg_objrel_state)

# ---- 2b. objRel entry grain: is plcyObjTypeCde itself null? ----
print("\n[2b] OBJREL ENTRY GRAIN -- is plcyObjTypeCde populated within each entry?")

if len(objrel_level_df):
    objtype_state = pd.crosstab(
        objrel_level_df["country"], objrel_level_df["plcyObjTypeCde_state"]
    )
    objtype_state["TOTAL_ENTRIES"] = objtype_state.sum(axis=1)
    if "POPULATED" in objtype_state.columns:
        objtype_state["POPULATED_PCT"] = (
            objtype_state["POPULATED"] / objtype_state["TOTAL_ENTRIES"] * 100
        ).round(2)
    display(objtype_state)

    print("\nOverall across all tables:")
    display(
        objrel_level_df["plcyObjTypeCde_state"]
        .value_counts(dropna=False)
        .rename_axis("plcyObjTypeCde_state")
        .reset_index(name="objrel_entries")
    )
else:
    print("     No objRel entries found in any table.")

# ---- 2c. Value distribution where populated ----
print("\n[2c] plcyObjTypeCde VALUE distribution (where populated)")

if len(objrel_level_df):
    value_dist = pd.crosstab(
        objrel_level_df["country"],
        objrel_level_df["plcyObjTypeCde"].fillna("<NULL>")
    )
    value_dist["TOTAL"] = value_dist.sum(axis=1)
    display(value_dist)

    print("\nOverall value counts:")
    display(
        objrel_level_df["plcyObjTypeCde"]
        .fillna("<NULL>")
        .value_counts()
        .rename_axis("plcyObjTypeCde")
        .reset_index(name="entries")
    )

# ---- 2d. Policy grain: does the policy have ANY populated type? ----
print("\n[2d] POLICY GRAIN -- how many policies carry at least one populated plcyObjTypeCde?")

if len(policy_level_df):
    if len(objrel_level_df):
        policies_with_type = (
            objrel_level_df[objrel_level_df["plcyObjTypeCde_state"] == "POPULATED"]
            .groupby("country")["policy_core_id"].nunique()
            .rename("policies_with_populated_type")
        )
    else:
        policies_with_type = pd.Series(dtype=int, name="policies_with_populated_type")

    total_policies = policy_level_df.groupby("country")["policy_core_id"].nunique().rename("total_policies")

    policy_coverage = pd.concat([total_policies, policies_with_type], axis=1).fillna(0)
    policy_coverage["policies_without_any_type"] = (
        policy_coverage["total_policies"] - policy_coverage["policies_with_populated_type"]
    )
    policy_coverage["coverage_pct"] = (
        policy_coverage["policies_with_populated_type"] / policy_coverage["total_policies"] * 100
    ).round(2)
    display(policy_coverage.astype({"policies_with_populated_type": int,
                                     "policies_without_any_type": int}))


# ============================================================
# SECTION 3 -- Distribution: country x policy_id x plcyObjTypeCde
# ============================================================

print("\n\n" + "=" * 80)
print("SECTION 3 -- Distribution: country x policy_core_id x plcyObjTypeCde")
print("=" * 80)

# ---- 3a. One row per (country, policy, objtype) ----
print("\n[3a] Long format -- one row per country / policy / object type")

if len(objrel_level_df):
    country_policy_objtype = (
        objrel_level_df
        .assign(plcyObjTypeCde_filled=objrel_level_df["plcyObjTypeCde"].fillna("<NULL>"))
        .groupby(["country", "policy_core_id", "plcyObjTypeCde_filled"])
        .agg(
            objrel_entries=("objrel_index", "size"),
            distinct_segments=("segment_index", "nunique"),
            distinct_plcyObjId=("plcyObjId", lambda s: s.dropna().nunique()),
            distinct_cntlId=("cntlId", lambda s: s.dropna().nunique()),
        )
        .reset_index()
        .rename(columns={"plcyObjTypeCde_filled": "plcyObjTypeCde"})
    )
    display(country_policy_objtype.head(60))
    print(f"\n(showing first 60 of {len(country_policy_objtype):,} rows -- "
          f"full frame in `country_policy_objtype`)")
else:
    country_policy_objtype = pd.DataFrame()
    print("     No objRel entries to distribute.")

# ---- 3b. Wide format: one row per policy, one column per type ----
print("\n[3b] Wide format -- one row per policy, counts per object type, "
      "including policies with none")

if len(policy_level_df):
    policy_base = policy_level_df[
        ["country", "table", "policy_core_id", "version_num", "policyTitle", "n_segments"]
    ].copy()

    if len(country_policy_objtype):
        wide = country_policy_objtype.pivot_table(
            index=["country", "policy_core_id"],
            columns="plcyObjTypeCde",
            values="objrel_entries",
            aggfunc="sum",
            fill_value=0,
        ).reset_index()
    else:
        wide = pd.DataFrame(columns=["country", "policy_core_id"])

    policy_objtype_wide = policy_base.merge(
        wide, on=["country", "policy_core_id"], how="left"
    )

    type_cols = [c for c in policy_objtype_wide.columns if c not in
                 ["country", "table", "policy_core_id", "version_num", "policyTitle", "n_segments"]]
    for c in type_cols:
        policy_objtype_wide[c] = policy_objtype_wide[c].fillna(0).astype(int)

    policy_objtype_wide["total_objrel_entries"] = policy_objtype_wide[type_cols].sum(axis=1)
    policy_objtype_wide["has_any_objrel"] = policy_objtype_wide["total_objrel_entries"] > 0

    display(policy_objtype_wide.head(60))
    print(f"\n(showing first 60 of {len(policy_objtype_wide):,} policies -- "
          f"full frame in `policy_objtype_wide`)")

    print("\nPolicies with NO objRel entries at all, by country:")
    no_link = (
        policy_objtype_wide.groupby("country")
        .agg(total_policies=("policy_core_id", "nunique"),
             policies_with_objrel=("has_any_objrel", "sum"))
        .reset_index()
    )
    no_link["policies_without_objrel"] = no_link["total_policies"] - no_link["policies_with_objrel"]
    no_link["pct_without"] = (no_link["policies_without_objrel"] / no_link["total_policies"] * 100).round(2)
    display(no_link.sort_values("pct_without", ascending=False))

# ---- 3c. Country x type pivot, entries and policy coverage ----
print("\n[3c] Country x object type pivots")

if len(country_policy_objtype):
    print("\nTotal objRel entries:")
    display(country_policy_objtype.pivot_table(
        index="country", columns="plcyObjTypeCde",
        values="objrel_entries", aggfunc="sum", fill_value=0
    ))

    print("\nDistinct policies covered:")
    display(country_policy_objtype.pivot_table(
        index="country", columns="plcyObjTypeCde",
        values="policy_core_id", aggfunc="nunique", fill_value=0
    ))

# ---- 3d. How many distinct types does a single policy carry? ----
print("\n[3d] Number of distinct object types per policy")

if len(country_policy_objtype):
    types_per_policy = (
        country_policy_objtype[country_policy_objtype["plcyObjTypeCde"] != "<NULL>"]
        .groupby(["country", "policy_core_id"])["plcyObjTypeCde"]
        .nunique().rename("distinct_types").reset_index()
    )
    display(pd.crosstab(types_per_policy["country"], types_per_policy["distinct_types"]))
    print("(columns = how many distinct plcyObjTypeCde values that policy carries)")


# ============================================================
# SECTION 4 -- sgmntTypeCde: null vs populated + formats
# ============================================================

print("\n\n" + "=" * 80)
print("SECTION 4 -- sgmntTypeCde: null vs populated")
print("=" * 80)

print("\n[4a] SEGMENT GRAIN -- state breakdown")
print("     KEY_ABSENT = field not present on the segment dict at all")

if len(segment_level_df):
    sgmnt_state_tab = pd.crosstab(
        segment_level_df["country"], segment_level_df["sgmntTypeCde_state"]
    )
    sgmnt_state_tab["TOTAL"] = sgmnt_state_tab.sum(axis=1)
    if "POPULATED" in sgmnt_state_tab.columns:
        sgmnt_state_tab["POPULATED_PCT"] = (
            sgmnt_state_tab["POPULATED"] / sgmnt_state_tab["TOTAL"] * 100
        ).round(2)
    else:
        sgmnt_state_tab["POPULATED_PCT"] = 0.0
    display(sgmnt_state_tab)

    print("\n[4b] FORMAT breakdown where populated "
          "(regex-classified -- does NOT split on '-')")
    fmt_tab = pd.crosstab(
        segment_level_df["country"], segment_level_df["sgmntTypeCde_format"]
    )
    display(fmt_tab)

    print("\n[4c] Sample distinct sgmntTypeCde values per country:")
    for country in segment_level_df["country"].unique():
        vals = (segment_level_df.loc[
            (segment_level_df["country"] == country) &
            (segment_level_df["sgmntTypeCde_state"] == "POPULATED"),
            "sgmntTypeCde"
        ].dropna().astype(str).unique())
        sample = sorted(vals)[:6]
        print(f"  {country:30s} {sample if len(sample) else '-- none populated --'}")

    print("\n[4d] POLICY GRAIN -- policies carrying at least one populated sgmntTypeCde")
    pol_with_sgmnt = (
        segment_level_df[segment_level_df["sgmntTypeCde_state"] == "POPULATED"]
        .groupby("country")["policy_core_id"].nunique()
        .rename("policies_with_sgmntTypeCde")
    )
    tot_pol = policy_level_df.groupby("country")["policy_core_id"].nunique().rename("total_policies")
    sgmnt_cov = pd.concat([tot_pol, pol_with_sgmnt], axis=1).fillna(0)
    sgmnt_cov["coverage_pct"] = (
        sgmnt_cov["policies_with_sgmntTypeCde"] / sgmnt_cov["total_policies"] * 100
    ).round(2)
    display(sgmnt_cov.astype({"policies_with_sgmntTypeCde": int}))


# ============================================================
# SECTION 5 -- Relationship between the two code fields
# ============================================================

print("\n\n" + "=" * 80)
print("SECTION 5 -- sgmntTypeCde vs plcyObjTypeCde")
print("=" * 80)

if len(segment_level_df):
    print("\n[5a] Do the two mechanisms co-occur, or are they alternatives?")
    coexist = pd.crosstab(
        segment_level_df["sgmntTypeCde_state"],
        segment_level_df["objRel_state"],
    )
