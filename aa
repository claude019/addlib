# ============================================================
# Helpers
# ============================================================

def safe_json_loads(x):
    if x is None:
        return None
    if isinstance(x, dict):
        return x
    if isinstance(x, str):
        try:
            return json.loads(x)
        except Exception:
            return None
    return None


def get_nested(d, *keys):
    cur = d
    for k in keys:
        if not isinstance(cur, dict):
            return None
        cur = cur.get(k)
    return cur


def strip_html(text):
    if not isinstance(text, str) or not text.strip():
        return ""
    try:
        return BeautifulSoup(text, "html.parser").get_text(separator=" ", strip=True)
    except Exception:
        return re.sub(r"<[^>]+>", " ", text)


def classify_code_format(value):
    """Classify an identifier's shape. Deliberately does NOT split on
    '-', so non-dashed codes are not mistaken for nulls."""
    if value is None:
        return "NULL"
    s = str(value).strip()
    if not s:
        return "EMPTY_STRING"
    if re.fullmatch(r"L1C-\d+", s):
        return "L1C-<digits>"
    if re.fullmatch(r"RSM-\d+", s):
        return "RSM-<digits>"
    if re.fullmatch(r"[A-Za-z]+-\d+", s):
        return "OTHERPREFIX-<digits>"
    if re.fullmatch(r"[A-Za-z]+\d+", s):
        return "ALPHA<digits> (no dash)"
    if re.fullmatch(r"\d+", s):
        return "<digits only>"
    return "OTHER"


def value_state(value):
    """Three-way state used for null-vs-populated counting."""
    if value is None:
        return "NULL"
    if isinstance(value, str) and not value.strip():
        return "EMPTY_STRING"
    return "POPULATED"


# ============================================================
# SECTION 0 -- Load once, build three base frames
# ============================================================

print("=" * 80)
print("SECTION 0 -- Loading tables and building base frames")
print("=" * 80)

policy_records = []
segment_records = []
objrel_records = []
load_status = []

for country, table in COUNTRY_TABLES.items():
    full_table = f"{DATA_PROJECT}.{DATASET}.{table}"
    query = f"SELECT policy_core_id, version_num, snapshot_time, transfer_date, json_data FROM `{full_table}`"

    try:
        df_raw = bq_client.query(query).to_dataframe()
    except Exception as e:
        load_status.append({"country": country, "table": table,
                            "status": "QUERY_FAILED", "rows": None, "error": str(e)[:150]})
        print(f"  {country:30s} FAILED -- {str(e)[:70]}")
        continue

    if len(df_raw) == 0:
        load_status.append({"country": country, "table": table,
                            "status": "EMPTY", "rows": 0, "error": None})
        print(f"  {country:30s} EMPTY")
        continue

    rows_all_versions = len(df_raw)

    if CURRENT_VERSION_ONLY:
        df_use = (df_raw.sort_values("version_num")
                  .groupby("policy_core_id", as_index=False)
                  .tail(1)
                  .copy())
    else:
        df_use = df_raw.copy()

    df_use["parsed"] = df_use["json_data"].apply(safe_json_loads)

    load_status.append({
        "country": country, "table": table, "status": "OK",
        "rows": rows_all_versions, "error": None,
    })

    for _, row in df_use.iterrows():
        parsed = row["parsed"]
        pid = row["policy_core_id"]
        ver = row["version_num"]

        parse_ok = isinstance(parsed, dict)

        policy_text_clean = strip_html(get_nested(parsed, "policyText", "sgmntText")) if parse_ok else ""
        policy_purpose_clean = strip_html(get_nested(parsed, "policyPurpose", "sgmntText")) if parse_ok else ""

        segments = get_nested(parsed, "policyApplication", "segment") if parse_ok else None
        segments = segments if isinstance(segments, list) else []

        policy_records.append({
            "country": country,
            "table": table,
            "policy_core_id": pid,
            "version_num": ver,
            "snapshot_time": row.get("snapshot_time"),
            "transfer_date": row.get("transfer_date"),
            "json_parse_ok": parse_ok,
            "policyTitle": parsed.get("policyTitle") if parse_ok else None,
            "policyDocType": parsed.get("policyDocType") if parse_ok else None,
            "region": parsed.get("region") if parse_ok else None,
            "policyRiskTypePrimary": parsed.get("policyRiskTypePrimary") if parse_ok else None,
            "riskTxnmyL2Text": get_nested(parsed, "policyApplication", "riskTxnmyL2Text") if parse_ok else None,
            "versStatCde": get_nested(parsed, "versn", "versStatCde") if parse_ok else None,
            "versActlPublDt": get_nested(parsed, "versn", "versActlPublDt") if parse_ok else None,
            "policyText_len": len(policy_text_clean),
            "policyPurpose_len": len(policy_purpose_clean),
            "n_segments": len(segments),
        })

        for seg_idx, seg in enumerate(segments):
            if not isinstance(seg, dict):
                continue

            seg_text_clean = strip_html(seg.get("sgmntText"))

            # --- sgmntTypeCde state, without splitting on '-' ---
            if "sgmntTypeCde" not in seg:
                sgmnt_state = "KEY_ABSENT"
                sgmnt_value = None
            else:
                sgmnt_value = seg.get("sgmntTypeCde")
                sgmnt_state = value_state(sgmnt_value)

            # --- objRel state ---
            obj_rel = seg.get("objRel")
            if "objRel" not in seg:
                objrel_state = "KEY_ABSENT"
                objrel_entries = []
            elif obj_rel is None:
                objrel_state = "NULL"
                objrel_entries = []
            elif isinstance(obj_rel, list) and len(obj_rel) == 0:
                objrel_state = "EMPTY_LIST"
                objrel_entries = []
            elif isinstance(obj_rel, list):
                objrel_state = "POPULATED"
                objrel_entries = [o for o in obj_rel if isinstance(o, dict)]
            else:
                objrel_state = "UNEXPECTED_TYPE"
                objrel_entries = []

            segment_records.append({
                "country": country,
                "table": table,
                "policy_core_id": pid,
                "version_num": ver,
                "segment_index": seg_idx,
                "sgmntTitlText": seg.get("sgmntTitlText"),
                "sgmntTypeCde": sgmnt_value,
                "sgmntTypeCde_state": sgmnt_state,
                "sgmntTypeCde_format": classify_code_format(sgmnt_value) if sgmnt_state == "POPULATED" else sgmnt_state,
                "objRel_state": objrel_state,
                "n_objRel_entries": len(objrel_entries),
                "segment_text_len": len(seg_text_clean),
                "segment_text_meaningful": len(seg_text_clean) >= MEANINGFUL_TEXT_LEN,
            })

            for obj_idx, obj in enumerate(objrel_entries):
                obj_type = obj.get("plcyObjTypeCde")
                objrel_records.append({
                    "country": country,
                    "table": table,
                    "policy_core_id": pid,
                    "version_num": ver,
                    "segment_index": seg_idx,
                    "objrel_index": obj_idx,
                    "sgmntTypeCde": sgmnt_value,
                    "sgmntTypeCde_state": sgmnt_state,
                    "plcyObjTypeCde": obj_type,
                    "plcyObjTypeCde_state": value_state(obj_type),
                    "plcyObjId": obj.get("plcyObjId"),
                    "plcyObjId_state": value_state(obj.get("plcyObjId")),
                    "plcyObjId_format": classify_code_format(obj.get("plcyObjId")),
                    "cntlId": obj.get("cntlId"),
                    "cntlId_state": value_state(obj.get("cntlId")),
                    "cntlId_format": classify_code_format(obj.get("cntlId")),
                    "cntlTitl": obj.get("cntlTitl"),
                })

    print(f"  {country:30s} OK -- {rows_all_versions} rows, "
          f"{df_use['policy_core_id'].nunique()} policies profiled")

policy_level_df = pd.DataFrame(policy_records)
segment_level_df = pd.DataFrame(segment_records)
objrel_level_df = pd.DataFrame(objrel_records)
load_status_df = pd.DataFrame(load_status)

print(f"\nBase frames built:")
print(f"  policy_level_df  : {len(policy_level_df):,} rows")
print(f"  segment_level_df : {len(segment_level_df):,} rows")
print(f"  objrel_level_df  : {len(objrel_level_df):,} rows")
print(f"\nLoad status:")
display(load_status_df)


