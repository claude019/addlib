              "short(100-500)", "fair(500-2000)", "long(>2000)"]
    segment_level_df["text_bucket"] = pd.cut(
        segment_level_df["segment_text_len"], bins=bins, labels=labels
    )
    display(pd.crosstab(segment_level_df["country"], segment_level_df["text_bucket"]))


