    print(f"\n[7b] segment sgmntText, by country "
          f"(meaningful = >= {MEANINGFUL_TEXT_LEN} chars after HTML stripping):")
    seg_text_profile = (
        segment_level_df.groupby("country")
        .agg(
            segments=("segment_index", "size"),
            median_len=("segment_text_len", "median"),
            mean_len=("segment_text_len", "mean"),
            empty_segments=("segment_text_len", lambda s: int((s == 0).sum())),
            below_threshold=("segment_text_meaningful", lambda s: int((~s).sum())),
            meaningful=("segment_text_meaningful", "sum"),
        )
        .reset_index()
    )
    seg_text_profile["mean_len"] = seg_text_profile["mean_len"].round(1)
    seg_text_profile["meaningful_pct"] = (
        seg_text_profile["meaningful"] / seg_text_profile["segments"] * 100
    ).round(2)
    display(seg_text_profile.sort_values("meaningful_pct"))
    print(
        "\nNOTE: 'below_threshold' exposes the whitespace-placeholder problem that a\n"
