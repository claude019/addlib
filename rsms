# Export
# ============================================================

output_path = "GPPS_RSM_Linkage_By_Country.xlsx"
with pd.ExcelWriter(output_path, engine="openpyxl") as writer:
    full[cols].to_excel(writer, sheet_name="RSM by Country", index=False)
    detail.to_excel(writer, sheet_name="Policies with RSM", index=False)
