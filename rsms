    os.environ["GOOGLE_CLOUD_PROJECT"] = ANALYTICS_PROJECT
    os.environ["GOOGLE_APPLICATION_CREDENTIALS"] = (
        "/home/jovyan/.config/gcloud/application_default_credentials.json"
    )
