        path_summary.to_excel(writer, sheet_name="RSM Field Paths", index=False)
    access_df.to_excel(writer, sheet_name="Table Access", index=False)

print(f"\nWritten to: {output_path}")
print("Frames in memory: policy_df (one row per policy), full (country summary)")
