# ============================================================
# GPPS Policy Text Data Preparation -- ALL policy tables
#
# Pulls the keep-list fields from every policy_core_id table (54 country
# tables + Global, discovered live via INFORMATION_SCHEMA -- same
# discovery pattern the attachment pipeline scripts use), filters each
# table to versStatCde == "PUBL", keeps the latest PUBL version per
# policy_core_id WITHIN each table (policy_core_id is only unique inside
# its own table, not globally -- two different countries can both have a
# policy 598 that are unrelated policies, so grouping has to happen
# per-table, not across the whole master dataset), cleans the free-text
# fields, and stacks every table's result into one master DataFrame with
# a Country column -- filter the master data down to specific countries
# however you need afterward.
#
# Column names are the original field names, unchanged -- cleaned in
# place, no "_clean" suffixes. Country (2-letter table code) and Table
# (full table name) are added columns, not part of the original
# keep-list, for traceability/filtering.
# ============================================================

import os
import re
import sys
import json
import subprocess
import pandas as pd

# ---- Bootstrap: BigQuery ----
try:
    bq_client
except NameError:
    from google.cloud import bigquery
    ANALYTICS_PROJECT = "hsbc-12211200-cmlpwb-prod"
    LOCATION = "EU"  # adjust if this errors in your environment
    os.environ["GOOGLE_CLOUD_PROJECT"] = ANALYTICS_PROJECT
    os.environ["GOOGLE_APPLICATION_CREDENTIALS"] = (
        "/home/jovyan/.config/gcloud/application_default_credentials.json"
    )
    bq_client = bigquery.Client(project=ANALYTICS_PROJECT, location=LOCATION)

DATA_PROJECT = "hsbc-11545401-cmpdatcwrs1-prod"
DATASET = "rc_curated_prod"

OUTPUT_PATH = "GPPS_Policy_Text_Data_Prep_Master.xlsx"

pd.set_option("display.max_columns", None)
pd.set_option("display.max_colwidth", 120)

# ---- Bootstrap: HTML cleaning ----
try:
    from bs4 import BeautifulSoup
except ImportError:
    subprocess.check_call(
        [sys.executable, "-m", "pip", "install", "--break-system-packages", "-q", "beautifulsoup4"]
    )
    from bs4 import BeautifulSoup


def clean_text(raw):
    """Strip HTML tags/entities and collapse whitespace. "" for empty input."""
    if not raw:
        return ""
    text = BeautifulSoup(str(raw), "html.parser").get_text(separator=" ")
    return re.sub(r"\s+", " ", text).strip()


def safe_json_loads(x):
    if x is None:
        return None
    if isinstance(x, dict):
        return x
    if isinstance(x, str):
        try:
            return json.loads(x)
        except Exception:
            return None
    return None


def discover_policy_tables():
    """All *_hsbc_gpps_gpps_policy tables -- 54 country tables plus
    aa_hsbc_gpps_gpps_policy (Global). Discovered live, not hard-coded."""
    query = f"""
        SELECT table_name
        FROM `{DATA_PROJECT}.{DATASET}.INFORMATION_SCHEMA.TABLES`
        WHERE table_name LIKE '%_hsbc_gpps_gpps_policy'
    """
    rows = bq_client.query(query).to_dataframe()
    return sorted(rows["table_name"].tolist())


def country_code_from_table(table_name):
    # "{cc}_hsbc_gpps_gpps_policy" -> cc (uppercased); "aa" = Global
    m = re.match(r"^([a-z]{2})_hsbc_gpps_gpps_policy$", table_name)
    return m.group(1).upper() if m else table_name


def extract_row(row, country, table):
    parsed = row["parsed"] or {}
    versn = parsed.get("versn") or {}
    app = parsed.get("policyApplication") or {}

    policy_text_obj = parsed.get("policyText") or {}
    policy_purpose_obj = parsed.get("policyPurpose") or {}
    segments = app.get("segment")

    # policyApplication.segment[] is an array of segment objects, each
    # carrying its body text under sgmntText (same field-name pattern as
    # policyText / policyPurpose) -- concatenated into one string per
    # policy, since this is one row per policy, not one per segment.
    segment_text = ""
    if isinstance(segments, list):
        segment_text = " ".join(
            clean_text(seg.get("sgmntText"))
            for seg in segments
            if isinstance(seg, dict) and seg.get("sgmntText")
        )

    return pd.Series({
        "Country": country,
        "Table": table,
        "policy_core_id": row["policy_core_id"],
        "version_num": row["version_num"],
        "versStatCde": versn.get("versStatCde"),
        "versActlPublDt": versn.get("versActlPublDt"),
        "snapshot_time": row.get("snapshot_time"),
        "policyRiskTypePrimary": parsed.get("policyRiskTypePrimary"),
        "riskTxnmyL2Text": app.get("riskTxnmyL2Text"),
        "region": parsed.get("region"),
        "policyTitle": clean_text(parsed.get("policyTitle")),
        "policyPurpose": clean_text(policy_purpose_obj.get("sgmntText")),
        "policyText": clean_text(policy_text_obj.get("sgmntText")),
        "segment": segment_text,
    })


# ============================================================
# Main -- loop every table, filter to PUBL, keep latest PUBL per policy
# (within that table), extract + clean, stack into one master frame
# ============================================================

tables = discover_policy_tables()
print(f"Discovered {len(tables)} policy tables.")

all_prepared = []

for table in tables:
    country = country_code_from_table(table)
    full_table = f"{DATA_PROJECT}.{DATASET}.{table}"
    print(f"\n{'=' * 70}\n{table}  (Country: {country})\n{'=' * 70}")

    try:
        df = bq_client.query(f"SELECT * FROM `{full_table}`").to_dataframe()
    except Exception as e:
        print(f"  !! load failed: {e}")
        continue

    if df.empty:
        continue

    df["parsed"] = df["json_data"].apply(safe_json_loads)
    df["versStatCde"] = df["parsed"].apply(lambda p: ((p or {}).get("versn") or {}).get("versStatCde"))

    publ_df = df[df["versStatCde"] == "PUBL"].copy()
    if publ_df.empty:
        print("  0 PUBL rows -- skipping.")
        continue

    latest_publ = (
        publ_df.sort_values("version_num")
        .groupby("policy_core_id", as_index=False)
        .tail(1)
    )
    print(f"  {len(latest_publ)} policies (latest PUBL version each)")

    prepared = latest_publ.apply(extract_row, axis=1, country=country, table=table)
    all_prepared.append(prepared)

master_df = (
    pd.concat(all_prepared, ignore_index=True)
    .sort_values(["Country", "policy_core_id"])
    .reset_index(drop=True)
)

print(f"\nDone. {len(master_df):,} policies across {master_df['Country'].nunique()} countries.")
display(master_df.head())

master_df.to_excel(OUTPUT_PATH, index=False)
print(f"\nWritten to: {OUTPUT_PATH}")
