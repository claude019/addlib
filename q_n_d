def safe_json_loads(x):
    if x is None:
        return None
    if isinstance(x, dict):
        return x
    if isinstance(x, str):
        try:
            return json.loads(x)
        except Exception:
            return None
    return None


def get_nested(d, *keys):
    cur = d
    for k in keys:
        if not isinstance(cur, dict):
            return None
        cur = cur.get(k)
    return cur


def load_table_df(table_short_name, extra_cols=""):
    full_table = f"{DATA_PROJECT}.{DATASET}.{table_short_name}"
    query = f"SELECT policy_core_id, version_num, snapshot_time, json_data{extra_cols} FROM `{full_table}`"
    df = bq_client.query(query).to_dataframe()
    df["parsed"] = df["json_data"].apply(safe_json_loads)
    return df


def iterate_segments(df):
    """Yields (row, segment_dict) for every segment across every row."""
    for _, row in df.iterrows():
        segments = get_nested(row["parsed"], "policyApplication", "segment")
        if not isinstance(segments, list):
            continue
        for seg in segments:
            if isinstance(seg, dict):
                yield row, seg


