# ============================================================
# Helpers
# ============================================================

def safe_json_loads(x):
    if x is None:
        return None
    if isinstance(x, dict):
        return x
    if isinstance(x, str):
        try:
            return json.loads(x)
        except Exception:
            return None
    return None


def get_nested(d, *keys):
    cur = d
    for k in keys:
        if not isinstance(cur, dict):
            return None
        cur = cur.get(k)
    return cur


def strip_html(text):
    if not isinstance(text, str) or not text.strip():
        return ""
    try:
        return BeautifulSoup(text, "html.parser").get_text(separator=" ", strip=True)
    except Exception:
        return re.sub(r"<[^>]+>", " ", text)


def build_segment_text(parsed_json):
    """Concatenate every segment's cleaned sgmntText, prefixed by its
    sgmntTitlText where present, into one block of text per policy."""
    segments = get_nested(parsed_json, "policyApplication", "segment")
    if not isinstance(segments, list):
        return ""
    parts = []
    for seg in segments:
        if not isinstance(seg, dict):
            continue
        text = strip_html(seg.get("sgmntText"))
        if not text:
            continue
        title = seg.get("sgmntTitlText")
        if isinstance(title, str) and title.strip():
            parts.append(f"{title.strip()}: {text}")
        else:
            parts.append(text)
    return "\n\n".join(parts)


def build_termdef_text(parsed_json):
    """Concatenate the policy's glossary (termDefin[]) into one block,
    kept separate from the main text fields as agreed."""
    term_defs = get_nested(parsed_json, "policyApplication", "termDefin")
    if not isinstance(term_defs, list):
        return ""
    parts = []
    for td in term_defs:
        if not isinstance(td, dict):
            continue
        definition = strip_html(td.get("termDefinText"))
        if not definition:
            continue
        term = td.get("termText")
        if isinstance(term, str) and term.strip():
            parts.append(f"{term.strip()}: {definition}")
        else:
            parts.append(definition)
    return "\n\n".join(parts)


# ============================================================
# Per-table builder
# ============================================================

def build_linkage_dataframe(country, table_short_name):
    full_table_name = f"{DATA_PROJECT}.{DATASET}.{table_short_name}"
    query = f"SELECT * FROM `{full_table_name}`"

    try:
        df_raw = bq_client.query(query).to_dataframe()
    except Exception as error:
        print(f"  -> FAILED: {error}")
        return None

    if len(df_raw) == 0:
        print("  -> EMPTY table")
        return pd.DataFrame(columns=LINKAGE_COLUMNS)

    required = {"policy_core_id", "version_num", "json_data"}
    if not required.issubset(df_raw.columns):
        print(f"  -> Unexpected schema, missing {required - set(df_raw.columns)}")
        return pd.DataFrame(columns=LINKAGE_COLUMNS)

    df_raw["json_parsed"] = df_raw["json_data"].apply(safe_json_loads)
    df_raw["versStatCde"] = df_raw["json_parsed"].apply(
        lambda p: get_nested(p, "versn", "versStatCde")
    )

    status_counts = df_raw["versStatCde"].value_counts(dropna=False).to_dict()
    print(f"  versStatCde distribution: {status_counts}")

    published = df_raw[df_raw["versStatCde"] == "PUBL"]
    published_policy_ids = set(published["policy_core_id"].unique())
    all_policy_ids = set(df_raw["policy_core_id"].unique())
    unpublished_policy_ids = all_policy_ids - published_policy_ids

    latest_published = (
        published.sort_values("version_num")
        .groupby("policy_core_id", as_index=False)
        .tail(1)
        .assign(used_fallback_non_publ=False)
    )

    if unpublished_policy_ids:
        fallback_rows = df_raw[df_raw["policy_core_id"].isin(unpublished_policy_ids)]
        fallback_latest = (
            fallback_rows.sort_values("version_num")
            .groupby("policy_core_id", as_index=False)
            .tail(1)
            .assign(used_fallback_non_publ=True)
        )
        print(f"  {len(unpublished_policy_ids)} polic(y/ies) had no PUBL version -- "
              f"falling back to latest version_num regardless of status")
        latest_rows = pd.concat([latest_published, fallback_latest], ignore_index=True)
    else:
        latest_rows = latest_published

    if len(latest_rows) == 0:
        print("  -> No rows survived the version selection")
        return pd.DataFrame(columns=LINKAGE_COLUMNS)

    records = []
    for _, row in latest_rows.iterrows():
        parsed = row["json_parsed"]
        if not isinstance(parsed, dict):
            continue

        policy_text_raw = get_nested(parsed, "policyText", "sgmntText")
        policy_purpose_raw = get_nested(parsed, "policyPurpose", "sgmntText")

        records.append({
            "policy_core_id": row["policy_core_id"],
            "version_num": row["version_num"],
            "versn.versStatCde": get_nested(parsed, "versn", "versStatCde"),
            "versn.versActlPublDt": get_nested(parsed, "versn", "versActlPublDt"),
            "snapshot_time": row.get("snapshot_time"),
            "policyRiskTypePrimary": parsed.get("policyRiskTypePrimary"),
            "policyApplication.riskTxnmyL2Text": get_nested(parsed, "policyApplication", "riskTxnmyL2Text"),
            "region": parsed.get("region"),
            "policyDocType": parsed.get("policyDocType"),
            "policyTitle": parsed.get("policyTitle"),
            "policyPurpose_clean": strip_html(policy_purpose_raw),
            "policyText_clean": strip_html(policy_text_raw),
            "segment_text": build_segment_text(parsed),
            "termdef_text": build_termdef_text(parsed),
            "used_fallback_non_publ": row["used_fallback_non_publ"],
        })

    df_linkage = pd.DataFrame(records, columns=LINKAGE_COLUMNS)
    print(f"  -> Built linkage dataframe: {len(df_linkage)} policies "
          f"({df_linkage['used_fallback_non_publ'].sum()} via fallback)")
    return df_linkage


