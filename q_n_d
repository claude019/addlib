master_frames = []
for country, table in COUNTRY_TABLES.items():
    df = policy_linkage_frames.get(table)
    if df is None or len(df) == 0:
        continue
    df = df.copy()
    df.insert(0, "source_table", table)
    df.insert(0, "source_country", country)
    master_frames.append(df)

master_policy_linkage_df = (
    pd.concat(master_frames, ignore_index=True) if master_frames else pd.DataFrame()
)

if len(master_policy_linkage_df):
    master_policy_linkage_df.insert(
        2, "global_policy_key",
        master_policy_linkage_df["source_table"] + "_"
        + master_policy_linkage_df["policy_core_id"].astype(str)
    )

print("\n\n" + "=" * 70)
print("MASTER DATAFRAME")
print("=" * 70)
print(f"Total rows: {len(master_policy_linkage_df)}")
if len(master_policy_linkage_df):
    print(f"Source tables represented: {master_policy_linkage_df['source_table'].nunique()}")
    print(f"Rows via fallback (no PUBL version): {master_policy_linkage_df['used_fallback_non_publ'].sum()}")
    print("\nRows per source table:")
    print(master_policy_linkage_df["source_table"].value_counts())

display(master_policy_linkage_df.head(20))

