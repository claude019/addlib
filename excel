g_scope = g_pairs_all[g_pairs_all.RECORD_ID.isin(scope_records)]
print(f"... restricted to {len(scope_records)} scoped alerts     : {len(g_scope):,}  <-- this is the 1,229 you see downstream")
print(f"distinct regulations in scope      : {_norm_id(g_valid[g_valid.RECORD_ID.isin(scope_records)].REG_ID).nunique():,}")
print(f"distinct library risks in scope    : {g_scope.LIB_RISK.nunique():,}")

# ---- 2. top-k attainable recall sweep ---------------------------------------
def attainable_recall_sweep(order_by_alert, golden_pairs, ks):
    ranks = []
    for rid, lr in golden_pairs:
        pool = order_by_alert.get(rid, [])
        ranks.append(pool.index(lr) + 1 if lr in pool else np.nan)
    ranks = pd.Series(ranks)
    total = len(ranks)
    ceiling = int(ranks.notna().sum())
    rows = [{"k": k, "caught": int(((ranks.notna()) & (ranks <= k)).sum()), "total": total,
             "attainable_recall": ((ranks.notna()) & (ranks <= k)).sum() / total}
            for k in ks]
    rows.append({"k": "ceiling (no cap)", "caught": ceiling, "total": total,
                 "attainable_recall": ceiling / total})
    return pd.DataFrame(rows), ranks

golden_pairs = list(zip(g_scope.RECORD_ID, g_scope.LIB_RISK))
sweep, ranks = attainable_recall_sweep(order_by_alert, golden_pairs, ks=list(range(10, 101, 10)))
print("\n--- TOP-K ATTAINABLE RECALL (retrieval only, before the LLM is asked) ---")
print(sweep.to_string(index=False, formatters={"attainable_recall": "{:.1%}".format}))
_ceil_recall = sweep.loc[sweep.k == "ceiling (no cap)", "attainable_recall"].iloc[0]
_opt = sweep.loc[(sweep.k != "ceiling (no cap)") & (sweep.attainable_recall >= _ceil_recall - 1e-9), "k"]
print(f"optimal k (first k reaching the ceiling): {_opt.min() if len(_opt) else 'none in the swept range'}")
print(f"golden pairs structurally unreachable   : {int(ranks.isna().sum()):,}  "
      f"({'RSM cascade never surfaced this risk for this alert' if LANE=='routed' else 'should be 0 in the direct lane'})")

