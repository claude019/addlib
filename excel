import numpy as np, pandas as pd

LANE = "direct"     # "direct" or "routed" -- controls the alias block only

if LANE == "direct":
    reg_frame   = golden          # has REG_ID column
    risk_frame  = register        # helios in the routed notebook
    risk_id_col = "LIB_RISK"
    risk_pool   = sorted(set(risk_frame.LIB_RISK))
    # reuse the ordering build_plan already computed -- ZERO extra cost
    order_by_alert = globals().get("order_by_record")
    if order_by_alert is None:
        risk_text_by_id = dict(zip(risk_frame.LIB_RISK, risk_frame.risk_text))
        _al = load_alerts(set(scope_records))
        alert_text_by_id = dict(zip(_al.RECORD_ID, _al.alert_text))
        risk_vecs  = embed_cache(risk_pool, [risk_text_by_id[c] for c in risk_pool],
                                 "helios_library_risks")
        alert_vecs = embed_cache(sorted(scope_records),
                                 [alert_text_by_id[r] for r in sorted(scope_records)],
                                 "alerts_risk_lane_direct")
        order_by_alert = {}
        for i, rid in enumerate(sorted(scope_records)):
            sims = np.asarray(risk_vecs) @ np.asarray(alert_vecs)[i]
            order_by_alert[rid] = [risk_pool[j] for j in np.argsort(-sims)]

else:  # routed
    reg_frame   = golden
    risk_frame  = helios
    risk_pool   = sorted(set(helios.LIB_RISK))
    # rebuild the per-alert RSM-cascade candidate pool, ordered by cosine sim,
    # using the SAME cache tags as the run -- this hits cache, no new spend
    _lk = rwt[rwt["final_decision"].astype(str).str.upper() == "LINKED"]
    _pairs = []
    for rid, ids in zip(_norm_id(_lk.RECORD_ID), _lk.linked_rsm_ids.fillna("").astype(str)):
        for x in __import__("re").split(r"[|,]", ids):
            if x.strip():
                _pairs.append((rid, x.strip().upper()))
    rec_rsm  = pd.DataFrame(_pairs, columns=["RECORD_ID", "SUM_ID"]).drop_duplicates()
    rsm_risk = regmap_risk[["SUM_ID", "LIB_RISK"]].drop_duplicates()
    cand_pool = (rec_rsm.merge(rsm_risk, on="SUM_ID")
                        .groupby("RECORD_ID")["LIB_RISK"].apply(lambda s: sorted(set(s))))

    risk_text_by_id = dict(zip(helios.LIB_RISK, helios.risk_text))
    _al = load_alerts(set(cand_pool.index))
    alert_text_by_id = dict(zip(_al.RECORD_ID, _al.alert_text))
    risk_vecs = embed_cache(risk_pool, [risk_text_by_id[c] for c in risk_pool],
                            "helios_library_risks")
    rpos = {r: i for i, r in enumerate(risk_pool)}
    order_by_alert = {}
    for rid, pool in cand_pool.items():
        if rid not in alert_text_by_id or not pool:
            order_by_alert[rid] = []
            continue
        alert_vec = embed_cache([rid], [alert_text_by_id[rid]], "alerts_risk_lane")[0]
        idx = [rpos[p] for p in pool]
        sims = np.asarray(risk_vecs)[idx] @ np.asarray(alert_vec)
        order = np.argsort(-sims)
        order_by_alert[rid] = [pool[j] for j in order]

print(f"[answer-pack] LANE={LANE}  order_by_alert built for {len(order_by_alert):,} alerts")

# ---- 1. golden dataset stats + the 1229 reconciliation ----------------------
