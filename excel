_rank = {"LINKED": 4, "INSUFFICIENT_EVIDENCE": 3, "NOT_LINKED": 2, "MISSING": 1, "ERROR": 0}
v = (v.assign(_r=v.decision.map(_rank).fillna(-1)).sort_values("_r", ascending=False)
