# Re-run the "combo maps to >1 library risk ID" check on BOTH extract2 and
# extract3, with the '-' placeholder filtered out first. The earlier result
# (2 combos each mapping to 2 IDs) may have been inflated by counting '-' as
# a second ID -- this confirms which finding is real.

lr_col_e2 = 'Regulation Summary Library Risk ID Number'
tax_cols_e2 = [
    'Regulation Summary Risk Taxonomy L1',
    'Regulation Summary Risk Taxonomy L2',
    'Regulation Summary Risk Taxonomy L3',
]
lr_col_e3 = lr_col_e2
tax_cols_e3 = tax_cols_e2

for name, df, lr_col, tax_cols in [
    ('extract2', extract2, lr_col_e2, tax_cols_e2),
    ('extract3', extract3, lr_col_e3, tax_cols_e3),
]:
    clean = df[df[lr_col] != '-']
    fwd = clean.groupby(tax_cols, dropna=False)[lr_col].nunique()
    rev = clean.groupby(lr_col, dropna=False)[tax_cols].nunique()

    print(f"\n{name} (placeholder filtered) -- combos mapping to >1 library risk ID:")
    print(fwd[fwd > 1])

    print(f"\n{name} (placeholder filtered) -- library risk IDs mapping to >1 taxonomy combo:")
    print(rev[(rev > 1).any(axis=1)])
