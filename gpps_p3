# ============================================================
# GPPS Destination Bucket Diagnostics (read-only)
#
# PART A -- inventories what's actually sitting in
#   gs://cmlp_exp_003_1_prod/gpps_attachment/policy/
#   (file count, size, upload time, per-policy breakdown)
#
# PART B -- cross-checks that inventory against the expected active
#   attachments (appendix[] + guidance[], actvFlg == "Y", matched on
#   docName) pulled fresh from BigQuery, to catch anything that's
#   missing from the copy or unexpectedly extra.
#
# Only touches the DESTINATION bucket (cmlp_exp_003_1_prod) and
# BigQuery -- never calls the source bucket (gpps-11910707-conformed-prod)
# at all. Read-only throughout: list_blobs() and SELECT queries only,
# no writes anywhere.
# ============================================================

import os
import re
import json
from collections import defaultdict
import pandas as pd

OUTPUT_PATH = "GPPS_Destination_Bucket_Diagnostics.xlsx"

pd.set_option("display.max_columns", None)
pd.set_option("display.max_colwidth", 120)

# ---- Bootstrap: destination GCS ----
from google.cloud import storage
storage_client = storage.Client(project="hsbc-12211200-cmlpwb-prod")
DEST_BUCKET_NAME = "cmlp_exp_003_1_prod"
DEST_PREFIX = "gpps_attachment/policy/"


# ============================================================
# PART A -- inventory of what's actually in the destination bucket
# ============================================================

blobs = list(storage_client.list_blobs(DEST_BUCKET_NAME, prefix=DEST_PREFIX))
print(f"{len(blobs)} objects found under gs://{DEST_BUCKET_NAME}/{DEST_PREFIX}")

rows = []
policy_files = defaultdict(list)  # policy_id (str) -> [filenames]

for blob in blobs:
    # expected shape: gpps_attachment/policy/{policy_id}/{filename}
    parts = blob.name.split("/")
    if len(parts) < 4 or not parts[-1]:
        print(f"  !! unexpected path shape, skipping: {blob.name}")
        continue
    policy_id = parts[2]
    filename = parts[-1]
    policy_files[policy_id].append(filename)
    rows.append({
        "Policy_id": policy_id,
        "Filename": filename,
        "Size (KB)": round(blob.size / 1024, 1) if blob.size else None,
        "Uploaded (UTC)": blob.time_created.strftime("%Y-%m-%d %H:%M") if blob.time_created else None,
        "Content type": blob.content_type,
    })

inventory_df = (
    pd.DataFrame(rows)
    .sort_values(["Policy_id", "Filename"])
    .reset_index(drop=True)
)

summary_df = (
    inventory_df.groupby("Policy_id")
    .agg(
        Files_in_destination=("Filename", "count"),
        Total_size_KB=("Size (KB)", "sum"),
    )
    .reset_index()
)
summary_df["Policy_id_sort"] = summary_df["Policy_id"].astype(int)
summary_df = (
    summary_df.sort_values("Policy_id_sort")
    .drop(columns="Policy_id_sort")
    .reset_index(drop=True)
)

print(f"{len(policy_files)} distinct policies have at least one file in the destination.")
total_mb = inventory_df["Size (KB)"].sum() / 1024 if not inventory_df.empty else 0
print(f"Total size: {total_mb:.1f} MB")

if not inventory_df.empty:
    ext_counts = inventory_df["Filename"].str.extract(r"(\.\w+)$")[0].value_counts()
    print("\nFile types:")
    print(ext_counts)


# ============================================================
# PART B -- cross-check: expected active attachments (from BQ) vs
# what's actually in the destination bucket
# ============================================================

try:
    bq_client
except NameError:
    from google.cloud import bigquery
    ANALYTICS_PROJECT = "hsbc-12211200-cmlpwb-prod"
    LOCATION = "EU"  # adjust if this errors in your environment
    os.environ["GOOGLE_CLOUD_PROJECT"] = ANALYTICS_PROJECT
    os.environ["GOOGLE_APPLICATION_CREDENTIALS"] = (
        "/home/jovyan/.config/gcloud/application_default_credentials.json"
    )
    bq_client = bigquery.Client(project=ANALYTICS_PROJECT, location=LOCATION)

DATA_PROJECT = "hsbc-11545401-cmpdatcwrs1-prod"
DATASET = "rc_curated_prod"


def safe_json_loads(x):
    if x is None:
        return None
    if isinstance(x, dict):
        return x
    if isinstance(x, str):
        try:
            return json.loads(x)
        except Exception:
            return None
    return None


def discover_policy_tables():
    query = f"""
        SELECT table_name
        FROM `{DATA_PROJECT}.{DATASET}.INFORMATION_SCHEMA.TABLES`
        WHERE table_name LIKE '%_hsbc_gpps_gpps_policy'
    """
    rows_ = bq_client.query(query).to_dataframe()
    return sorted(rows_["table_name"].tolist())


def country_code_from_table(table_name):
    m = re.match(r"^([a-z]{2})_hsbc_gpps_gpps_policy$", table_name)
    return m.group(1).upper() if m else table_name


def pick_latest_version(df):
    """Per policy_core_id: the PUBL version with the highest version_num.
    Falls back to the highest version_num overall if no PUBL version exists."""
    df = df.copy()
    df["parsed"] = df["json_data"].apply(safe_json_loads)
    df["vers_stat"] = df["parsed"].apply(
        lambda p: ((p or {}).get("versn") or {}).get("versStatCde")
    )
    publ = df[df["vers_stat"] == "PUBL"]
    publ_latest = (
        publ.sort_values("version_num")
        .groupby("policy_core_id", as_index=False)
        .tail(1)
    )
    missing_ids = set(df["policy_core_id"]) - set(publ_latest["policy_core_id"])
    fallback = df[df["policy_core_id"].isin(missing_ids)]
    fallback_latest = (
        fallback.sort_values("version_num")
        .groupby("policy_core_id", as_index=False)
        .tail(1)
    )
    return pd.concat([publ_latest, fallback_latest], ignore_index=True)


def active_attachments(parsed):
    """Combined appendix[] + guidance[] items with actvFlg == 'Y'.
    docName first (confirmed against the bucket), gppsDocName fallback."""
    app = (parsed or {}).get("policyApplication") or {}
    names = []
    for src in ("appendix", "guidance"):
        items = app.get(src)
        if isinstance(items, list):
            for it in items:
                if isinstance(it, dict) and it.get("actvFlg") == "Y":
                    name = it.get("docName") or it.get("gppsDocName")
                    if name:
                        names.append(name)
    return names


tables = discover_policy_tables()
print(f"\nDiscovered {len(tables)} policy tables for the cross-check.")

crosscheck_rows = []

for table in tables:
    country = country_code_from_table(table)
    full_table = f"{DATA_PROJECT}.{DATASET}.{table}"
    try:
        df = bq_client.query(f"SELECT * FROM `{full_table}`").to_dataframe()
    except Exception as e:
        print(f"  !! load failed for {table}: {e}")
        continue
    if df.empty:
        continue

    latest = pick_latest_version(df)

    for _, row in latest.iterrows():
        policy_id = str(row["policy_core_id"])
        parsed = row["parsed"]
        if not isinstance(parsed, dict):
            continue

        expected_names = set(active_attachments(parsed))
        dest_names = set(policy_files.get(policy_id, []))

        if not expected_names and not dest_names:
            continue

        missing_in_dest = expected_names - dest_names
        extra_in_dest = dest_names - expected_names

        crosscheck_rows.append({
            "Country": country,
            "Policy_id": policy_id,
            "Expected active attachments": len(expected_names),
            "Files in destination bucket": len(dest_names),
            "Missing from destination": len(missing_in_dest),
            "Missing filenames": "; ".join(sorted(missing_in_dest)) if missing_in_dest else "",
            "Extra in destination": len(extra_in_dest),
            "Extra filenames": "; ".join(sorted(extra_in_dest)) if extra_in_dest else "",
        })

crosscheck_df = (
    pd.DataFrame(crosscheck_rows)
    .sort_values(["Country", "Policy_id"])
    .reset_index(drop=True)
)

n_missing = (crosscheck_df["Missing from destination"] > 0).sum() if not crosscheck_df.empty else 0
n_extra = (crosscheck_df["Extra in destination"] > 0).sum() if not crosscheck_df.empty else 0
print(f"\n{n_missing} polic(ies) have files missing from the destination bucket.")
print(f"{n_extra} polic(ies) have extra/unexpected files in the destination bucket.")


# ============================================================
# Export -- three sheets in one workbook
# ============================================================

with pd.ExcelWriter(OUTPUT_PATH, engine="openpyxl") as writer:
    summary_df.to_excel(writer, sheet_name="Destination_Summary", index=False)
    inventory_df.to_excel(writer, sheet_name="Destination_Inventory", index=False)
    crosscheck_df.to_excel(writer, sheet_name="Expected_vs_Destination", index=False)

print(f"\nDiagnostics written to: {OUTPUT_PATH}")
display(summary_df)
display(crosscheck_df)
