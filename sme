# ============================ independent judge ==============================
# Sees: alert text, risk text, model decision, model reasoning. NOT the golden label.
RISK_AUDIT_PROMPT = """ROLE:
You are an independent reviewer. A linkage model decided that an ALERT bears on a
LIBRARY RISK (decision = LINKED) and gave its reasoning. Do not just restate the
model's reasoning -- independently re-derive the answer from the alert text and
the risk text only.

VERDICT:
- AGREE: the two texts support the link.
- DISAGREE: the two texts do not support the link (different subject matter,
  wrong scope, or only a loose thematic overlap).
- UNCERTAIN: the link is plausible but cannot be established from these two texts
  alone -- it would need a subject-matter expert.

Quote exactly, verbatim, from the supplied texts in alert_quote and risk_quote --
these are checked programmatically against the source text, so a quote that does
not appear verbatim will be treated as unsupported.

Return JSON only:
{"verdict": "AGREE" | "DISAGREE" | "UNCERTAIN",
 "error_type": "FALSE_LINK_UNSUPPORTED" | "FALSE_LINK_WRONG_SCOPE" | "FALSE_LINK_THEMATIC" | "NONE",
 "correct_decision": "LINKED" | "NOT_LINKED" | "UNCERTAIN",
 "model_evidence_supports_decision": true | false,
 "confidence": 1-5,
 "alert_quote": "verbatim substring of the alert text",
 "risk_quote": "verbatim substring of the risk text",
 "rationale": "one or two plain sentences"}"""

RISK_AUDIT_SCHEMA = {
    "type": "json_schema",
    "json_schema": {"name": "risk_audit", "strict": True, "schema": {
        "type": "object", "additionalProperties": False,
        "required": ["verdict", "error_type", "correct_decision",
                     "model_evidence_supports_decision", "confidence",
                     "alert_quote", "risk_quote", "rationale"],
        "properties": {
            "verdict": {"type": "string", "enum": ["AGREE", "DISAGREE", "UNCERTAIN"]},
            "error_type": {"type": "string", "enum": ["FALSE_LINK_UNSUPPORTED",
                           "FALSE_LINK_WRONG_SCOPE", "FALSE_LINK_THEMATIC", "NONE"]},
            "correct_decision": {"type": "string", "enum": ["LINKED", "NOT_LINKED", "UNCERTAIN"]},
            "model_evidence_supports_decision": {"type": "boolean"},
            "confidence": {"type": "integer"},
            "alert_quote": {"type": "string"},
            "risk_quote": {"type": "string"},
            "rationale": {"type": "string"}}}}
}

def _failed_out(msg):
    return {"_failed": True, "_error": msg}

async def _risk_audit_one(alert_text, risk_text, model_reasoning):
    payload = {"alert_text": alert_text, "risk_text": risk_text,
               "model_decision": "LINKED", "model_reasoning": model_reasoning}
    messages = [{"role": "system", "content": RISK_AUDIT_PROMPT},
                {"role": "user", "content": json.dumps(payload, ensure_ascii=False)}]
    kw = {"model": MODEL, "user": USE_CASE, "response_format": RISK_AUDIT_SCHEMA}
    if "gemini" in MODEL.lower():
        kw.update(temperature=0.0, seed=42, reasoning_effort="low", max_tokens=1200)
    else:
        kw.update(reasoning_effort="low", max_completion_tokens=1200)
    last_err = None
    for attempt in range(1, 4):
        try:
            token = await tok.get()
            r = await oai.chat.completions.create(
                messages=messages, extra_headers={"Authorization": f"Bearer {token}"}, **kw)
            out = json.loads(r.choices[0].message.content)
            out["_failed"] = False
            return out
        except Exception as e:
            last_err = f"{type(e).__name__}: {e}"
            if "401" in str(e):
                await tok.invalidate()
            await asyncio.sleep(1.5 ** attempt)
    return _failed_out(last_err)

def _norm_text(s):
    return re.sub(r"\s+", " ", str(s)).strip().lower()

def quote_check(quote, source_text):
    return bool(quote) and _norm_text(quote) in _norm_text(source_text)

def verdict_after_quote_check(out, alert_text, risk_text):
    """AGREE without verifiable quotes is downgraded to UNCERTAIN (Method pt 3)."""
    verified = (quote_check(out.get("alert_quote", ""), alert_text)
                and quote_check(out.get("risk_quote", ""), risk_text))
    verdict = out["verdict"]
    if not verified and verdict == "AGREE":
        verdict = "UNCERTAIN"
    return verdict, verified

async def run_judge(df, concurrency=CONCURRENCY):
    sem  = asyncio.Semaphore(concurrency)
    rows = df.reset_index(drop=True)

    async def _one(i, r):
        async with sem:
            a, t = alert_txt.get(r.REC, ""), risk_txt.get(r.RISK, "")
            reasoning = r.reasoning if isinstance(r.reasoning, str) else ""
            out = (_failed_out("missing alert/risk text for this id") if (not a or not t)
                   else await _risk_audit_one(a, t, reasoning))
            if out["_failed"]:
                return i, {"audit_label": "JUDGE_ERROR", "verdict_raw": "", "downgraded": False,
                           "evidence_verified": False, "error_type": "", "confidence": np.nan,
                           "judge_failed": True, "judge_error": out["_error"], "judge_json": ""}
            vfinal, verified = verdict_after_quote_check(out, a, t)
            label = VERDICT_LABEL[vfinal]
            if r.bucket == "CAUGHT" and label == "NEEDS_SME":
                label = "DISPUTED"              # CAUGHT has two buckets only
            return i, {"audit_label": label, "verdict_raw": out["verdict"],
                       "downgraded": (out["verdict"] == "AGREE" and vfinal == "UNCERTAIN"),
                       "evidence_verified": verified, "error_type": out["error_type"],
                       "confidence": out["confidence"], "judge_failed": False, "judge_error": "",
                       "judge_json": json.dumps({k: v for k, v in out.items() if not k.startswith("_")},
                                                ensure_ascii=False)}

    tasks = [asyncio.create_task(_one(i, r)) for i, r in enumerate(rows.itertuples())]
    res = {}
    for fut in tqdm(asyncio.as_completed(tasks), total=len(tasks), desc="judge"):
        i, d = await fut
        res[i] = d
    return pd.concat([rows, pd.DataFrame([res[i] for i in range(len(rows))])], axis=1)

# ============================ buckets (pair level) ===========================
def build_buckets(verdicts_df, golden_df):
    if "relevance_score" not in verdicts_df.columns:
        raise KeyError(f"verdicts has no relevance_score; columns = {list(verdicts_df.columns)}")
    v = verdicts_df.copy()
    v["REC"], v["RISK"] = _norm_id(v.RECORD_ID), _norm_id(v.LIB_RISK)
    v["DEC"] = v.decision.astype(str).str.strip().str.upper()
    rank = {"LINKED": 4, "INSUFFICIENT_EVIDENCE": 3, "NOT_LINKED": 2, "MISSING": 1, "ERROR": 0}
    v = (v.assign(_r=v.DEC.map(rank).fillna(-1)).sort_values("_r", ascending=False)
           .drop_duplicates(["REC", "RISK"]).drop(columns="_r"))
    g  = golden_df[~golden_df.LIB_RISK.isin(_BLANK)]
    g  = g[g.RECORD_ID.isin(set(v.REC))]
    gp = g[["RECORD_ID", "LIB_RISK"]].drop_duplicates()
    gkeys = set(gp.RECORD_ID + "|" + gp.LIB_RISK)
    v["key"]          = v.REC + "|" + v.RISK
    v["golden"]       = v.key.isin(gkeys)
    v["model_linked"] = v.DEC.eq("LINKED")
    v["score"]        = pd.to_numeric(v["relevance_score"], errors="coerce")
    v["bucket"] = np.select(
        [v.golden & v.model_linked, ~v.golden & v.model_linked, v.golden & ~v.model_linked],
        ["CAUGHT", "DISCOVERY", "MISSED"], default="TRUE_NEGATIVE")
    n_never = len(gkeys - set(v.key))
    return v, gp, n_never

