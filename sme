async def run_quote_audit(cells_to_audit, alert_txt, risk_txt, concurrency=20):
    """cells_to_audit: DataFrame with REC, RISK, decision, model_score, reasoning
    (CAUGHT + DISCOVERY rows only -- i.e. model said LINKED)."""
    sem = asyncio.Semaphore(concurrency)
    results = [None] * len(cells_to_audit)

    async def _one(i, row):
        async with sem:
            try:
                r = await _quote_audit_call(
                    alert_txt.get(row.REC, ""), risk_txt.get(row.RISK, ""),
                    row.decision, row.get("model_score", ""), row.get("reasoning", ""))
            except Exception as e:
                r = {"verdict": "UNCERTAIN", "verdict_after_quote_check": "UNCERTAIN",
                     "error_type": "NONE", "correct_decision": row.decision,
                     "model_evidence_supports_decision": None, "confidence": 0,
                     "alert_quote": "", "risk_quote": "",
                     "rationale": f"quote-audit call failed: {type(e).__name__}: {e}"}
            results[i] = r

    tasks = [_one(i, row) for i, row in enumerate(cells_to_audit.itertuples())]
    for f in tqdm(asyncio.as_completed(tasks), total=len(tasks), desc="quote-audit"):
        await f

    out = cells_to_audit.copy()
    for col in ["verdict", "verdict_after_quote_check", "error_type", "correct_decision",
                "model_evidence_supports_decision", "confidence", "alert_quote",
                "risk_quote", "rationale"]:
        out[col] = [r.get(col) for r in results]
    out["judge_response_json"] = [json.dumps(r) for r in results]
    return out


