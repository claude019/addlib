def _reason(r):
    if r.audit_label in ("CONFIRMED", "JUDGE_ERROR"): return ""
    if r.verdict_raw == "DISAGREE":                   return "judge disagreed"
    if r.downgraded:                                  return "agreed, but quotes not verifiable"
    return "judge unsure"
audited["reason_detail"] = audited.apply(_reason, axis=1)

