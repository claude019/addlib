                   "max_score": row.get("max_score", ""), "linked_rsm": row.get("linked_rsm", ""),
                   "model_evidence_verified": row.get("model_evidence_verified", ""),
                   "audit_label": row.audit_label, "audit_verdict_final": row.audit_verdict_final,
                   "audit_error_type": row.audit_error_type,
                   "audit_confidence": row.audit_confidence,
                   "selection_reason": row.selection_reason,
                   "judge_response_json": row.judge_response_json}.get(fname, "")
            c = mr.cell(r_idx, col_idx, val)
            c.alignment = WRAP
    mr.column_dimensions["A"].width = 18
    for col_idx in range(2, 2 + len(sample5)):
        mr.column_dimensions[get_column_letter(col_idx)].width = 40

    path = path or (OUTPUT_DIR / f"manual_review_pack_lr_{MODEL}.xlsx")
    wb.save(path)
    print(f"[I4] pack -> {path}")
    print(f"     tabs: Instructions | Review ({len(review_rows)} rows) | "
          f"Answer key | Manual Review - P0 ({len(sample5)} cases)")
    print(f"     Manual Review - P0 cases to walk through the UI yourself:")
    for rid in sample5.review_id.tolist():
        print(f"       {rid}")
    return path


