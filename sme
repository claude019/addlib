def classify_buckets():
    v = verdicts.copy()
    v["REC"], v["RISK"] = _norm_id(v.RECORD_ID), _norm_id(v.LIB_RISK)
    v["decision"] = v.decision.astype(str).str.strip().str.upper()
    rank = {"LINKED": 4, "INSUFFICIENT_EVIDENCE": 3, "NOT_LINKED": 2, "MISSING": 1, "ERROR": 0}
    v = (v.assign(_r=v.decision.map(rank).fillna(-1))
          .sort_values("_r", ascending=False)
          .drop_duplicates(["REC", "RISK"]))

    g = golden[~_norm_id(golden.LIB_RISK).isin(_BLANK)]
    gp = g[["RECORD_ID", "LIB_RISK"]].assign(
        RECORD_ID=lambda d: _norm_id(d.RECORD_ID), LIB_RISK=lambda d: _norm_id(d.LIB_RISK)
    ).drop_duplicates()
    gkeys = set(gp.RECORD_ID + "|" + gp.LIB_RISK)

    v["golden"] = (v.REC + "|" + v.RISK).isin(gkeys)
    v["model_linked"] = v.decision.eq("LINKED")
    v["bucket"] = np.select(
        [v.golden & v.model_linked, v.golden & ~v.model_linked,
         ~v.golden & v.model_linked, ~v.golden & ~v.model_linked],
        ["CAUGHT", "MISSED", "DISCOVERY", "JUDGED_NOT_LINKED_NONGOLDEN"], default="?")

    judged = set(v.REC + "|" + v.RISK)
    never = gp[~(gp.RECORD_ID + "|" + gp.LIB_RISK).isin(judged)].copy()
    never["bucket"] = "NOT_JUDGED"
    never = never.rename(columns={"RECORD_ID": "REC", "LIB_RISK": "RISK"})
    never["golden"] = True; never["model_linked"] = False; never["decision"] = "NOT_JUDGED"

    return v, never


