def _resolve_text_dicts():
    """[H] in this notebook builds these as alert_text_by_id/risk_text_by_id,
    not alert_txt/risk_txt -- calling run_quote_audit with the bare wrong
    names raises a NameError immediately and kills the whole cell before the
    workbook is ever written. Resolve defensively against every naming
    convention seen across this project's notebooks, and fail with a clear
    message (not a bare NameError) if truly nothing matches."""
    g = globals()
    alert_candidates = ["alert_text_by_id", "alert_txt"]
    risk_candidates = ["risk_text_by_id", "risk_txt"]
    a = next((g[n] for n in alert_candidates if n in g), None)
    r = next((g[n] for n in risk_candidates if n in g), None)
    if a is None or r is None:
        missing = [n for n, v in [("alert text dict", a), ("risk text dict", r)] if v is None]
        raise NameError(
            f"[I3] Cannot find {', '.join(missing)} under any known name "
            f"({alert_candidates + risk_candidates}). Run [H] first in this "
            f"session (it builds alert_text_by_id/risk_text_by_id), or define "
            f"one of these names yourself before calling build_answer_key().")
    return a, r


async def build_answer_key():
    v, never = classify_buckets()
    alert_text_by_id, risk_text_by_id = _resolve_text_dicts()

    to_quote_audit = v[v.bucket.isin(["CAUGHT", "DISCOVERY"])].copy()
    print(f"[I3] quote-auditing {len(to_quote_audit):,} LINKED pairs "
          f"({(to_quote_audit.bucket=='CAUGHT').sum():,} caught, "
          f"{(to_quote_audit.bucket=='DISCOVERY').sum():,} discoveries)")
    qa = await run_quote_audit(to_quote_audit, alert_text_by_id, risk_text_by_id)

    # Three-way label, not two -- confirmed from the photos (R023: AGREE but
    # verdict_after_quote_check=UNCERTAIN -> NEEDS_SME, not CONFIRMED/DISPUTED).
    qa["audit_label"] = np.select(
        [qa.verdict_after_quote_check.eq("UNCERTAIN"),
         qa.verdict.eq("AGREE")],
        ["NEEDS_SME", "CONFIRMED"], default="DISPUTED")
    qa["audit_verdict_final"] = qa.verdict_after_quote_check
    qa["audit_error_type"] = qa.error_type

    # selection_reason: a generated sentence, confirmed verbatim from the
    # photos -- three exact strings read off-screen:
    #   "Golden & linked - judge disputes (is the judge too strict?)"
    #   "Discovery - judge disputes: wrong scope"
    #   "Discovery - judge disputes: generic theme only"
    # Pattern: {bucket phrase} - judge {agrees/disputes}{: error reason},
    # with the "(is the judge too strict?)" aside only for a disputed
    # GOLDEN-confirmed link -- disputing a non-golden Discovery doesn't carry
    # that framing. The CONFIRMED-discovery string was read earlier, in the
    # original RGL screenshot: "Discovery - judge confirms, evidence verified
    # (candidate genuine new link)". NEEDS_SME has no confirmed string in
    # either batch of photos -- its text below is a reasoned extrapolation
    # of the same template, not something read off-screen.
    _ERR_PHRASE = {"FALSE_LINK_UNSUPPORTED": "no supporting evidence",
                   "FALSE_LINK_WRONG_SCOPE": "wrong scope",
                   "FALSE_LINK_THEMATIC": "generic theme only",
                   "NONE": ""}

    def _selection_reason(row):
        is_golden = row.bucket == "CAUGHT"
        prefix = "Golden & linked" if is_golden else "Discovery"
        if row.audit_label == "CONFIRMED":
            return (f"{prefix} - judge confirms, evidence verified"
                    + ("" if is_golden else " (candidate genuine new link)"))
        if row.audit_label == "DISPUTED":
            err = _ERR_PHRASE.get(row.audit_error_type, row.audit_error_type)
            aside = " (is the judge too strict?)" if is_golden else f": {err}"
            return f"{prefix} - judge disputes{aside}"
        if row.audit_label == "NEEDS_SME":
            return f"{prefix} - judge uncertain, needs SME review"
        return f"{prefix} - {row.audit_label}"
    qa["selection_reason"] = qa.apply(_selection_reason, axis=1)

    # max_score: whatever score field verdicts actually carries.
    for cand in ("relevance_score", "model_score", "score"):
        if cand in qa.columns:
            qa["max_score"] = qa[cand]
            break
    else:
        qa["max_score"] = None

    # linked_rsm: the ACTUAL RSM id connecting this (alert, risk) pair -- real
    # 8-digit ids like RSM-00030515, confirmed from the cell-reference bar in
    # the photo. Derived from rwt's linked-RSM list for this record, filtered
    # to the RSMs that Extract3 actually maps to this risk. Earlier version of
    # this code wrote a placeholder string here instead of looking it up.
    def _linked_rsm_for(rec, risk):
        row_match = rwt[_norm_id(rwt.RECORD_ID) == rec]
        if row_match.empty:
            return ""
        ids = str(row_match.iloc[0].get("linked_rsm_ids", "") or "")
        rsms = [x.strip().upper() for x in re.split(r"[|,]", ids) if x.strip()]
        if not rsms:
            return ""
        hit = regmap_risk[regmap_risk.SUM_ID.isin(rsms)
                           & (_norm_id(regmap_risk.LIB_RISK) == risk)]
        return "|".join(sorted(set(hit.SUM_ID))) if len(hit) else ""
    qa["linked_rsm"] = qa.apply(lambda r: _linked_rsm_for(r.REC, r.RISK), axis=1)

    # model_evidence_verified: the photos show this TRUE even on DISPUTED rows
    # where model_evidence_supports_decision=false in the same row's JSON --
    # so this is NOT "does the quote-audit agree the evidence is valid". It
    # reads as a completeness check: did the ORIGINAL model's response include
    # a non-empty evidence snippet at all, regardless of whether it holds up.
    # Still depends on verdicts carrying an evidence field -- your schema
    # comment says the trimmed response is decision + relevance_score +
    # one-line reasoning ONLY, so this likely can't be computed as-is. Check
    # rather than assume; say so plainly if the field isn't there.
    ev_alert_col = next((c for c in ("model_evidence_alert", "evidence_alert")
                          if c in qa.columns), None)
    ev_risk_col = next((c for c in ("model_evidence_risk", "model_evidence_regulation",
                                     "evidence_risk") if c in qa.columns), None)
    if ev_alert_col and ev_risk_col:
        qa["model_evidence_verified"] = (
            qa[ev_alert_col].astype(str).str.strip().ne("")
            & qa[ev_risk_col].astype(str).str.strip().ne(""))
    else:
        qa["model_evidence_verified"] = "N/A - verdicts has no evidence-quote field"
        print("[I3] NOTE: verdicts carries no evidence_alert/evidence_risk column "
              "(trimmed schema) -- model_evidence_verified cannot be computed and "
              "is set to a placeholder. Extend RISK_SCHEMA with an evidence field "
              "if this column needs real values.")

    # fold in [F]'s existing miss-audit for MISSED rows, if it has run
    missed = v[v.bucket == "MISSED"].copy()
    if "audited" in globals() and globals().get("audited") is not None and len(globals()["audited"]):
        am = globals()["audited"][["REC", "RISK", "audit_category"]].copy()
        missed = missed.merge(am, on=["REC", "RISK"], how="left")
        label_map = {"STRUCTURAL_OVERMAPPING": "GOLDEN_NOT_SUPPORTED_BY_TEXT",
                     "CORRECT_REJECTION": "GOLDEN_NOT_SUPPORTED_BY_TEXT",
                     "SME_JUDGEMENT_REQUIRED": "SME_JUDGEMENT_REQUIRED",
                     "TRUE_LINK_MISSED": "CANDIDATE_GAP"}
        verdict_map = {"STRUCTURAL_OVERMAPPING": "AGREE", "CORRECT_REJECTION": "AGREE",
                       "SME_JUDGEMENT_REQUIRED": "UNCERTAIN", "TRUE_LINK_MISSED": "DISAGREE"}
        missed["audit_label"] = missed.audit_category.map(label_map).fillna("NOT_AUDITED")
        missed["audit_verdict_final"] = missed.audit_category.map(verdict_map).fillna("UNCERTAIN")
        missed["audit_error_type"] = "NONE"
        missed["judge_response_json"] = missed.audit_category.apply(
            lambda c: json.dumps({"source": "[F] miss-audit", "audit_category": c}))
        missed["audit_confidence"] = 4
    else:
        missed["audit_label"] = "NOT_AUDITED"
        missed["audit_verdict_final"] = "UNCERTAIN"
        missed["audit_error_type"] = "NOT_AUDITED"
        missed["judge_response_json"] = "(run [F] first for a real miss-audit label)"
        missed["audit_confidence"] = 0
        print("[I3] NOTE: [F] has not run -- MISSED rows will show NOT_AUDITED. "
              "Run [F] before building the final pack for a real label.")
    _missed_label_phrase = {"GOLDEN_NOT_SUPPORTED_BY_TEXT": "golden link not text-supported, model right to decline",
                             "CANDIDATE_GAP": "judge disagrees - this looks like a genuine missed link",
                             "SME_JUDGEMENT_REQUIRED": "judge uncertain, needs SME review",
                             "NOT_AUDITED": "not yet audited"}
    missed["selection_reason"] = missed.audit_label.map(_missed_label_phrase).apply(
        lambda t: f"Golden & missed - {t}" if t else "Golden & missed")
    missed["max_score"] = None
    missed["model_evidence_verified"] = ""
    missed["linked_rsm"] = missed.apply(lambda r: _linked_rsm_for(r.REC, r.RISK), axis=1)

    # NOT_JUDGED rows: confirmed from the photo -- selection still reads
    # "Golden &..." (golden-sourced), judge_response_json is the literal
    # placeholder string, not a JSON blob.
    never["audit_label"] = "NOT_AUDITED"
    never["audit_verdict_final"] = "UNCERTAIN"
    never["audit_error_type"] = "NOT_AUDITED"
    never["judge_response_json"] = "(not audited - no model output for this pair)"
    never["audit_confidence"] = 0
    never["selection_reason"] = "Golden & not judged - no model output for this pair"
    never["max_score"] = None
    never["model_evidence_verified"] = ""
    never["linked_rsm"] = ""  # by definition: this is why it was never judged

    keep = ["REC", "RISK", "bucket", "golden", "model_linked", "decision",
            "max_score", "linked_rsm", "model_evidence_verified", "audit_label",
            "audit_verdict_final", "audit_error_type", "audit_confidence",
            "selection_reason", "judge_response_json"]
    for df in (qa, missed, never):
        for c in keep:
            if c not in df.columns:
                df[c] = None
    allrows = pd.concat([qa[keep], missed[keep], never[keep]], ignore_index=True)

    def priority(row):
        """Priority rule for DISCOVERY rows is now CONFIRMED from the photos,
        not guessed:
          CONFIRMED + Discovery              -> P0  (R007, R015)
          DISPUTED  + Discovery              -> P1  (R002, R003, R004, R018, R020)
          NEEDS_SME + Discovery, lower conf  -> P3  (R023)
        CAUGHT/MISSED priorities were never visible in either photo -- every
        such row's JSON overflowed column P and pushed Priority off-frame.
        Kept as a reasoned default below (a disputed GOLDEN-confirmed link is
        the most concerning case, so P0), but this half is still inferred,
        not read. Say so if it needs correcting against the real workbook."""
        conf = row.audit_confidence or 0
        if row.bucket == "DISCOVERY":
            if row.audit_label == "CONFIRMED":
                return "P0"
            if row.audit_label == "DISPUTED":
                return "P1"
            if row.audit_label == "NEEDS_SME":
                return "P3" if conf < 5 else "P2"
            return "P2"
        # ---- below this line: inferred, not confirmed from the photos ----
        if row.audit_label in ("DISPUTED", "CANDIDATE_GAP"):
            return "P0" if conf >= 4 else "P1"
        if row.audit_label in ("CONFIRMED", "GOLDEN_NOT_SUPPORTED_BY_TEXT"):
            return "P2"
        return "P3"
    allrows["Priority"] = allrows.apply(priority, axis=1)
    allrows["review_id"] = ["R" + str(i + 1).zfill(3) for i in range(len(allrows))]
    allrows["Key"] = allrows.REC + "&" + allrows.RISK
    # linked_rsm is already populated per-bucket above (real lookup, not a
    # placeholder) -- no further computation needed here.

    return allrows


