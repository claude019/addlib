caught_all = audited[audited.bucket == "CAUGHT"].copy()

def _score_rows(df, template_rows, name):
    n_nan = int(df.score.isna().sum())
    obs   = sorted(set(df.score.dropna().astype(int)))
    extra = [s for s in obs if s not in template_rows]
    if n_nan: print(f"WARNING {name}: {n_nan} rows have no score -- not in the pivot below")
    if extra: print(f"NOTE {name}: scores {extra} fall outside the template's rows "
                    f"{template_rows[0]}-{template_rows[-1]}; the table below adds rows for them")
    return sorted(set(template_rows) | set(obs))

