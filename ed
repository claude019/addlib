            seg_text_clean = strip_html(seg.get("sgmntText"))

            if "sgmntTypeCde" not in seg:
                sgmnt_state, sgmnt_value = "KEY_ABSENT", None
            else:
                sgmnt_value = seg.get("sgmntTypeCde")
                sgmnt_state = value_state(sgmnt_value)

            obj_rel = seg.get("objRel")
            if "objRel" not in seg:
                objrel_state, objrel_entries = "KEY_ABSENT", []
            elif obj_rel is None:
                objrel_state, objrel_entries = "NULL", []
            elif isinstance(obj_rel, list) and len(obj_rel) == 0:
                objrel_state, objrel_entries = "EMPTY_LIST", []
            elif isinstance(obj_rel, list):
                objrel_state, objrel_entries = "POPULATED", [o for o in obj_rel if isinstance(o, dict)]
            else:
                objrel_state, objrel_entries = "UNEXPECTED_TYPE", []

            segment_records.append({
                "country": country, "table": table, "policy_core_id": pid, "version_num": ver,
                "segment_index": seg_idx, "sgmntTitlText": seg.get("sgmntTitlText"),
                "sgmntTypeCde": sgmnt_value, "sgmntTypeCde_state": sgmnt_state,
                "sgmntTypeCde_format": classify_code_format(sgmnt_value) if sgmnt_state == "POPULATED" else sgmnt_state,
                "objRel_state": objrel_state, "n_objRel_entries": len(objrel_entries),
                "segment_text_len": len(seg_text_clean),
                "segment_text_meaningful": len(seg_text_clean) >= MEANINGFUL_LEN,
            })

            for obj_idx, obj in enumerate(objrel_entries):
                obj_type = obj.get("plcyObjTypeCde")
                if obj_type:
                    objrel_types_seen.add(obj_type)
                v1, v2, v3 = (clean_val(obj.get("riskTxnmyL1Text")),
                              clean_val(obj.get("riskTxnmyL2Text")),
                              clean_val(obj.get("riskTxnmyL3Text")))
                if v1:
                    objrel_l1.add(v1)
                if v2:
