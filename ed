# ============================================================
# GPPS -- JSON structure diagram
#
# Draws the CONTAINER structure of a policy JSON -- which objects
# and arrays nest inside which -- as a left-to-right tree diagram
# using plain matplotlib (no graphviz / system binary required).
#
# Design choice: only dict/list (container) values become their
# own connected boxes. Scalar leaf fields are NOT drawn as separate
# nodes (that would mean 80+ boxes and be unreadable) -- instead
# each container's own leaf field names are listed as compact text
# inside its box. This matches "how does one object fold into its
# sub-objects" rather than a full field-by-field diagram.
#
# Since different policies populate different optional fields
# (objRel sometimes null, sometimes a list, etc.), several sample
# policies are MERGED into one structural union before drawing, so
# the diagram reflects the fullest schema observed, not just
# whichever single record happened to be sampled.
# ============================================================

import json
import functools
import textwrap
import matplotlib.pyplot as plt
from matplotlib.lines import Line2D

