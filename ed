def safe_json_loads(x):
    if x is None:
        return None
    if isinstance(x, dict):
        return x
    if isinstance(x, str):
        try:
            return json.loads(x)
        except Exception:
            return None
    return None


def get_nested(d, *keys):
    cur = d
    for k in keys:
        if not isinstance(cur, dict):
            return None
        cur = cur.get(k)
    return cur


def strip_html(text):
    if not isinstance(text, str) or not text.strip():
        return ""
    try:
        return BeautifulSoup(text, "html.parser").get_text(separator=" ", strip=True)
    except Exception:
        return re.sub(r"<[^>]+>", " ", text)


def clean_val(v):
    if v is None:
        return None
    if isinstance(v, str):
        s = v.strip()
        return s if s else None
    return v


def classify_code_format(value):
    if value is None:
        return "NULL"
    s = str(value).strip()
    if not s:
        return "EMPTY_STRING"
    if re.fullmatch(r"L1C-\d+", s):
        return "L1C-<digits>"
    if re.fullmatch(r"RSM-\d+", s):
        return "RSM-<digits>"
    if re.fullmatch(r"[A-Za-z]+-\d+", s):
        return "OTHERPREFIX-<digits>"
    if re.fullmatch(r"[A-Za-z]+\d+", s):
        return "ALPHA<digits> (no dash)"
    if re.fullmatch(r"\d+", s):
        return "<digits only>"
    return "OTHER"


def value_state(value):
    if value is None:
        return "NULL"
    if isinstance(value, str) and not value.strip():
        return "EMPTY_STRING"
    return "POPULATED"


def content_hash(text):
    if not text:
        text = ""
    t = re.sub(r"[^\w\s]", " ", text.lower())
    t = re.sub(r"\s+", " ", t).strip()
    return hashlib.sha256(t.encode("utf-8")).hexdigest()[:16]


