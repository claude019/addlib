                    "plcyObjId": obj.get("plcyObjId"), "plcyObjId_format": classify_code_format(obj.get("plcyObjId")),
                    "cntlId": obj.get("cntlId"), "cntlId_format": classify_code_format(obj.get("cntlId")),
                    "cntlTitl": obj.get("cntlTitl"),
                })

        # stash the objRel-rolled-up risk values back onto the policy record
        policy_records[-1]["objrel_L1_values"] = "; ".join(sorted(objrel_l1)) if objrel_l1 else None
        policy_records[-1]["objrel_L2_values"] = "; ".join(sorted(objrel_l2)) if objrel_l2 else None
        policy_records[-1]["objrel_L3_values"] = "; ".join(sorted(objrel_l3)) if objrel_l3 else None
        policy_records[-1]["objrel_types"] = "; ".join(sorted(objrel_types_seen)) if objrel_types_seen else None

