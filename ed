def walk(node, path, country):
    if isinstance(node, dict):
        for k, v in node.items():
            walk(v, f"{path}.{k}" if path else k, country)
    elif isinstance(node, list):
        for item in node:
            walk(item, f"{path}[]", country)
    else:
        st = field_stats[path]
        st["occurrences"] += 1
        st["countries"].add(country)
        st["types"].add(type(node).__name__)
        if node is None:
            return
        if isinstance(node, str):
            if not node.strip():
                return
            clean = strip_html(node) if ("<" in node and ">" in node) else node.strip()
            if not clean:
                return
            st["populated"] += 1
            st["lengths"].append(len(clean))
            if len(st["samples"]) < 2:
                st["samples"].append(clean[:150])
        else:
            st["populated"] += 1
            st["lengths"].append(len(str(node)))
            if len(st["samples"]) < 2:
                st["samples"].append(str(node)[:150])


