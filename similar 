# ============================================================
# GPPS Duplicate Attachment Names (read-only)
#
# Finds docName values that appear as an ACTIVE attachment (appendix[] or
# guidance[], actvFlg == "Y") on more than one policy -- i.e. the same
# physical filename is referenced by multiple policies, whether that's a
# genuinely shared/common document (e.g. a group-wide policy attached to
# several country policies) or a naming collision between unrelated files
# that just happen to share a name (e.g. "Appendix_A.docx").
#
# This only reads BigQuery -- it never touches either GCS bucket, since
# the question is about what the JSON records reference, not what's
# physically present in a bucket.
#
# Scope: the latest version per policy_core_id (same PUBL-first,
# fallback-to-highest logic used everywhere else in this project), across
# all 54 country tables + Global, discovered live.
# ============================================================

import os
import re
import json
import pandas as pd

# ---- Bootstrap: BigQuery ----
try:
    bq_client
except NameError:
    from google.cloud import bigquery
    ANALYTICS_PROJECT = "hsbc-12211200-cmlpwb-prod"
    LOCATION = "EU"  # adjust if this errors in your environment
    os.environ["GOOGLE_CLOUD_PROJECT"] = ANALYTICS_PROJECT
    os.environ["GOOGLE_APPLICATION_CREDENTIALS"] = (
        "/home/jovyan/.config/gcloud/application_default_credentials.json"
    )
    bq_client = bigquery.Client(project=ANALYTICS_PROJECT, location=LOCATION)

DATA_PROJECT = "hsbc-11545401-cmpdatcwrs1-prod"
DATASET = "rc_curated_prod"

OUTPUT_PATH = "GPPS_Duplicate_Attachment_Names.xlsx"

pd.set_option("display.max_columns", None)
pd.set_option("display.max_colwidth", 120)


# ============================================================
# Helpers (same logic as the policy pipeline)
# ============================================================

def safe_json_loads(x):
    if x is None:
        return None
    if isinstance(x, dict):
        return x
    if isinstance(x, str):
        try:
            return json.loads(x)
        except Exception:
            return None
    return None


def discover_policy_tables():
    query = f"""
        SELECT table_name
        FROM `{DATA_PROJECT}.{DATASET}.INFORMATION_SCHEMA.TABLES`
        WHERE table_name LIKE '%_hsbc_gpps_gpps_policy'
    """
    rows = bq_client.query(query).to_dataframe()
    return sorted(rows["table_name"].tolist())


def country_code_from_table(table_name):
    m = re.match(r"^([a-z]{2})_hsbc_gpps_gpps_policy$", table_name)
    return m.group(1).upper() if m else table_name


def pick_latest_version(df):
    df = df.copy()
    df["parsed"] = df["json_data"].apply(safe_json_loads)
    df["vers_stat"] = df["parsed"].apply(
        lambda p: ((p or {}).get("versn") or {}).get("versStatCde")
    )
    publ = df[df["vers_stat"] == "PUBL"]
    publ_latest = (
        publ.sort_values("version_num")
        .groupby("policy_core_id", as_index=False)
        .tail(1)
    )
    missing_ids = set(df["policy_core_id"]) - set(publ_latest["policy_core_id"])
    fallback = df[df["policy_core_id"].isin(missing_ids)]
    fallback_latest = (
        fallback.sort_values("version_num")
        .groupby("policy_core_id", as_index=False)
        .tail(1)
    )
    return pd.concat([publ_latest, fallback_latest], ignore_index=True)


def active_attachments(parsed):
    """Combined appendix[] + guidance[] items with actvFlg == 'Y'.
    docName first (confirmed against the bucket), gppsDocName fallback."""
    app = (parsed or {}).get("policyApplication") or {}
    names = []
    for src in ("appendix", "guidance"):
        items = app.get(src)
        if isinstance(items, list):
            for it in items:
                if isinstance(it, dict) and it.get("actvFlg") == "Y":
                    name = it.get("docName") or it.get("gppsDocName")
                    if name:
                        names.append(name)
    return names


# ============================================================
# Build one row per (policy, active attachment) across every table
# ============================================================

tables = discover_policy_tables()
print(f"Discovered {len(tables)} policy tables.")

attachment_rows = []

for table in tables:
    country = country_code_from_table(table)
    full_table = f"{DATA_PROJECT}.{DATASET}.{table}"
    try:
        df = bq_client.query(f"SELECT * FROM `{full_table}`").to_dataframe()
    except Exception as e:
        print(f"  !! load failed for {table}: {e}")
        continue
    if df.empty:
        continue

    latest = pick_latest_version(df)

    for _, row in latest.iterrows():
        policy_id = row["policy_core_id"]
        version_num = row["version_num"]
        parsed = row["parsed"]
        if not isinstance(parsed, dict):
            continue

        for doc_name in active_attachments(parsed):
            attachment_rows.append({
                "Country": country,
                "Policy_id": policy_id,
                "Version": version_num,
                "docName": doc_name,
            })

attachments_df = pd.DataFrame(attachment_rows)
print(f"{len(attachments_df)} active-attachment references found across {attachments_df['Policy_id'].nunique()} policies.")

# ============================================================
# Cross-policy duplicates -- same docName referenced by >1 DISTINCT policy
# ============================================================

per_name_policies = (
    attachments_df.groupby("docName")["Policy_id"]
    .nunique()
    .reset_index(name="Number of policies")
)
dup_names = set(per_name_policies[per_name_policies["Number of policies"] > 1]["docName"])

dup_rows = []
for doc_name, grp in attachments_df[attachments_df["docName"].isin(dup_names)].groupby("docName"):
    policies = (
        grp[["Country", "Policy_id"]]
        .drop_duplicates()
        .sort_values(["Country", "Policy_id"])
    )
    policy_list = "; ".join(f"{r.Country}-{r.Policy_id}" for r in policies.itertuples())
    dup_rows.append({
        "docName": doc_name,
        "Number of policies": policies["Policy_id"].nunique(),
        "Countries": "; ".join(sorted(policies["Country"].unique())),
        "Country-Policy_id list": policy_list,
    })

cross_policy_df = (
    pd.DataFrame(dup_rows)
    .sort_values("Number of policies", ascending=False)
    .reset_index(drop=True)
)

print(f"\n{len(cross_policy_df)} distinct filename(s) are referenced by more than one policy.")

# ============================================================
# Within-policy duplicates -- same docName listed more than once on the
# SAME policy's own active attachment list (a data-quality flag, separate
# question from cross-policy reuse)
# ============================================================

within_rows = []
for (country, policy_id), grp in attachments_df.groupby(["Country", "Policy_id"]):
    counts = grp["docName"].value_counts()
    repeated = counts[counts > 1]
    for doc_name, n in repeated.items():
        within_rows.append({
            "Country": country,
            "Policy_id": policy_id,
            "docName": doc_name,
            "Times listed on this policy": n,
        })

within_policy_df = (
    pd.DataFrame(within_rows)
    .sort_values(["Country", "Policy_id"])
    .reset_index(drop=True)
)

print(f"{len(within_policy_df)} docName/policy pair(s) are listed more than once on the same policy.")

# ============================================================
# Export
# ============================================================

with pd.ExcelWriter(OUTPUT_PATH, engine="openpyxl") as writer:
    cross_policy_df.to_excel(writer, sheet_name="Shared across policies", index=False)
    within_policy_df.to_excel(writer, sheet_name="Repeated within one policy", index=False)

print(f"\nWritten to: {OUTPUT_PATH}")
display(cross_policy_df)