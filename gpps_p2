print("\n" + "=" * 80)
print("STAGE 3 -- Looking for the metadata table with GCS paths")
print("=" * 80)

meta_cols = []
for ds in [DATASET] + list(EXTRA_DATASETS):
    q = f"""
        SELECT table_name, column_name, data_type
        FROM `{DATA_PROJECT}.{ds}.INFORMATION_SCHEMA.COLUMNS`
        WHERE REGEXP_CONTAINS(LOWER(column_name), r'(gcs|uri|path|storage|bucket|blob|pdf|attach)')
          AND NOT REGEXP_CONTAINS(table_name, r'^[a-z]{{2}}_hsbc_gpps_gpps_policy$')
        ORDER BY table_name, ordinal_position
    """
    try:
        d = bq_client.query(q).to_dataframe()
        d["dataset"] = ds
        meta_cols.append(d)
    except Exception as e:
        print(f"  Could not read column metadata for dataset '{ds}': {str(e)[:80]}")

meta_df = pd.concat(meta_cols, ignore_index=True) if meta_cols else pd.DataFrame()
gcs_candidates = []

if len(meta_df):
    print(f"\nCandidate columns found in {meta_df.groupby(['dataset', 'table_name']).ngroups} table(s). "
          f"Sampling values to see which actually hold gs:// paths...")
    for (ds, tbl), grp in list(meta_df.groupby(["dataset", "table_name"]))[:25]:
        cols = [c for c, t in zip(grp["column_name"], grp["data_type"]) if t == "STRING"][:6]
        if not cols:
            continue
        try:
            sel = ", ".join(f"`{c}`" for c in cols)
            sample = bq_client.query(
                f"SELECT {sel} FROM `{DATA_PROJECT}.{ds}.{tbl}` LIMIT 20"
            ).to_dataframe()
        except Exception as e:
            print(f"    {ds}.{tbl}: could not sample ({str(e)[:60]})")
            continue
        for c in cols:
            vals = sample[c].dropna().astype(str)
            n_gs = int(vals.str.startswith("gs://").sum())
            gcs_candidates.append({
                "dataset": ds, "table": tbl, "column": c,
                "gs_values_in_sample": n_gs,
                "example": vals.iloc[0][:100] if len(vals) else None,
            })
    cand_df = pd.DataFrame(gcs_candidates)
    likely = cand_df[cand_df["gs_values_in_sample"] > 0] if len(cand_df) else cand_df
    if len(likely):
        print("\n>>> Columns whose sampled values are gs:// paths (likely the metadata table):")
        display(likely)
        print("Set METADATA_TABLE / METADATA_URI_COLUMN / METADATA_KEY_COLUMN above, "
              "pick the matching METADATA_KEY_FIELD, and re-run to join it on.")
    else:
        print("\nNo sampled column held a gs:// value. The metadata table may be in a "
              "different dataset (add it to EXTRA_DATASETS), or the path may be stored "
              "under a name this search didn't match -- worth asking the RCDP team for "
              "the exact table and column.")
        if len(cand_df):
            display(cand_df.head(40))
else:
    print("\nNo candidate columns found in the searched dataset(s).")

# 3b -- join, if configured
if METADATA_TABLE and METADATA_URI_COLUMN and METADATA_KEY_COLUMN:
    keys = sorted({str(v) for v in attach_active[METADATA_KEY_FIELD].dropna()})
    print(f"\n[3b] Joining {len(keys):,} distinct {METADATA_KEY_FIELD} values against {METADATA_TABLE}")
    sql = f"""
        SELECT CAST(`{METADATA_KEY_COLUMN}` AS STRING) AS join_key,
               `{METADATA_URI_COLUMN}` AS gcs_uri_meta
        FROM `{METADATA_TABLE}`
        WHERE CAST(`{METADATA_KEY_COLUMN}` AS STRING) IN UNNEST(@keys)
    """
    cfg = bigquery.QueryJobConfig(
        query_parameters=[bigquery.ArrayQueryParameter("keys", "STRING", keys)])
    try:
        meta_join = bq_client.query(sql, job_config=cfg).to_dataframe()
        meta_join = meta_join.drop_duplicates("join_key")
        attach_active["_key"] = attach_active[METADATA_KEY_FIELD].astype(str)
        attach_active = attach_active.merge(meta_join, left_on="_key", right_on="join_key", how="left")
        attach_active["gcs_uri"] = attach_active["gcs_uri"].fillna(attach_active["gcs_uri_meta"])
        found = int(attach_active["gcs_uri_meta"].notna().sum())
        print(f"     Matched a GCS path for {found:,} of {len(attach_active):,} active attachments "
              f"({found / len(attach_active) * 100:.1f}%)")
    except Exception as e:
        print(f"     Join failed: {str(e)[:150]}")
else:
    print("\n[3b] METADATA_* not configured -- skipping the join.")


