# ============================================================
# Main loop
# ============================================================

full_table = f"{DATA_PROJECT}.{DATASET}.{PROC_TABLE}"
print(f"Loading {PROC_TABLE} ...")
df = bq_client.query(f"SELECT * FROM `{full_table}`").to_dataframe()
print(f"{len(df):,} rows loaded.")

latest = pick_latest_version(df)
print(f"{len(latest):,} procedures (latest version each)")

audit_rows = []

for _, row in latest.iterrows():
    procedure_id = row["procedure_core_id"]
    version_num = row["version_num"]
    parsed = row["parsed"]
    if not isinstance(parsed, dict):
        continue

    expected_names = active_attachments(parsed)
    expected_count = len(expected_names)

    if expected_count == 0:
        audit_rows.append({
            "Country": "GLOBAL",
            "Table": PROC_TABLE,
            "Procedure_id": procedure_id,
            "Version": version_num,
            "Number of attachments found in the BQ table": 0,
            "Number of attachments found in the gcs bucket": 0,
            "Number of attachments matched (BQ vs gcs)": 0,
            "Number of attachments not matched": 0,
        })
        continue

    objects = list_source_objects(procedure_id, version_num)
    found_names = {os.path.basename(o) for o in objects}
    found_count = len(objects)

    matched_names = [n for n in expected_names if n in found_names]
    matches_count = len(matched_names)
    not_matched_count = expected_count - matches_count

    audit_rows.append({
        "Country": "GLOBAL",
        "Table": PROC_TABLE,
        "Procedure_id": procedure_id,
        "Version": version_num,
        "Number of attachments found in the BQ table": expected_count,
        "Number of attachments found in the gcs bucket": found_count,
        "Number of attachments matched (BQ vs gcs)": matches_count,
        "Number of attachments not matched": not_matched_count,
    })

print("\nDone.")

# ============================================================
# Audit table export
# ============================================================

audit_df = (
    pd.DataFrame(audit_rows)
    .sort_values(["Procedure_id"])
    .reset_index(drop=True)
)
audit_df.to_excel(OUTPUT_PATH, index=False)
